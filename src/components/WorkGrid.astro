---
// Multi-page Home (/v3/): one big cover card per project, linking to its own
// detail page (/v3/work/[slug]/). Cover = the project's first image.
import { projects } from '../data/projects';
import { assetUrl } from '../lib/media';
import Picture from './Picture.astro';

const cover = (p: (typeof projects)[number]) => p.media.find((m) => m.kind === 'image') as { name: string; alt: string } | undefined;
const kinds = (p: (typeof projects)[number]) => {
  const k = new Set(p.media.map((m) => m.kind));
  return [k.has('video') && 'Motion', k.has('model') && '3D', k.has('map') && 'Interactive'].filter(Boolean) as string[];
};
---

<section class="work container" id="work" aria-labelledby="work-title">
  <div class="head">
    <h2 id="work-title" class="section-title display" data-reveal>Selected projects</h2>
    <p class="count" data-reveal style="--reveal-d: 80ms"><span>{String(projects.length).padStart(2, '0')}</span> projects</p>
  </div>

  <ol class="grid" role="list">
    {
      projects.map((p, i) => {
        const c = cover(p);
        return (
          <li class:list={['card', { 'is-feature': i === 0 }]} style={`--accent:${p.spine.bg}`}>
            <a href={assetUrl(`v3/work/${p.slug}/`)} aria-label={`${p.no} ${p.title}, open project`}>
              <div class="thumb">
                {c && <Picture name={c.name} alt="" sizes={i === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'} eager={i === 0} />}
                <span class="open" aria-hidden="true">View project →</span>
              </div>
              <div class="meta">
                <span class="no">{p.no}</span>
                <h3 class="title">{p.title}</h3>
                <p class="tags">
                  {p.role[0]}
                  {kinds(p).map((k) => <span class="chip">{k}</span>)}
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .work {
    padding-block: var(--section-y);
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .section-title {
    font-size: var(--fs-5);
    line-height: 0.9;
    margin: 0;
  }
  .count {
    color: var(--c-muted);
    margin: 0;
  }
  .count span {
    font-family: var(--f-display);
    color: var(--c-fg);
    font-size: var(--fs-3);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 32px 24px;
  }
  .card {
    grid-column: span 4;
  }
  .card.is-feature {
    grid-column: span 8;
    grid-row: span 2;
  }
  .card a {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .thumb {
    position: relative;
    flex: 1;
    min-height: 260px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--c-ph-a);
  }
  .is-feature .thumb {
    aspect-ratio: auto;
  }
  .thumb :global(picture),
  .thumb :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 -4px 0 var(--accent);
    pointer-events: none;
  }
  .open {
    position: absolute;
    right: 14px;
    bottom: 16px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: #111;
    font-weight: 700;
    font-size: var(--fs-0);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .card a:hover .thumb :global(img),
  .card a:focus-visible .thumb :global(img) {
    transform: scale(1.04);
  }
  .card a:hover .open,
  .card a:focus-visible .open {
    opacity: 1;
    transform: none;
  }
  .card a:focus-visible {
    outline: none;
  }
  .card a:focus-visible .thumb {
    box-shadow: var(--focus);
  }
  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: baseline;
  }
  .no {
    font-family: var(--f-display);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    font-size: var(--fs-2);
  }
  .title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--fs-3);
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .is-feature .title {
    font-size: var(--fs-4);
  }
  .tags {
    grid-column: 2;
    margin: 6px 0 0;
    color: var(--c-muted);
    font-size: var(--fs-0);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
  }
  .chip {
    border: 1px solid var(--c-line);
    border-radius: 999px;
    padding: 1px 8px;
  }
  @media (max-width: 900px) {
    .card,
    .card.is-feature {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .is-feature .thumb {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .open {
      transition: none;
    }
  }
</style>
