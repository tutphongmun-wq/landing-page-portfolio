---
import type { Swatch } from '../data/projects';

interface Props {
  swatches: Swatch[];
  /** 'strip': row of chips (mobile). 'fill': fills its slide box like the PDF. 'bencho': interactive Bencho-style pill palette. */
  variant?: 'strip' | 'fill' | 'bencho';
  /** fill only: tall narrow box, so swatch names run vertically */
  vertical?: boolean;
}
const { swatches, variant = 'strip', vertical = false } = Astro.props;

// Pick legible label color per swatch (WCAG relative luminance).
const lum = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ink = (hex: string) => (lum(hex) > 0.18 ? '#000' : '#fff');
// 6 swatches: two hero colors on top, four below (as on the K2O page)
const featured = swatches.length === 6;
const initialJson = JSON.stringify(swatches);
---

{
  variant === 'bencho' ? (
    <div class="bencho-palette" data-bencho-palette data-initial={initialJson} aria-label="Interactive color palette">
      <div class="bp-stage">
        <div class="bp-row">
          <div class="bp-capsule" role="group" aria-label="Color swatches">
            {swatches.map((s, idx) => (
              <button
                type="button"
                class="bp-swatch"
                data-bp-swatch={idx}
                data-hex={s.hex}
                data-name={s.name}
                style={`background:${s.hex};color:${ink(s.hex)}`}
                title={`${s.name} (${s.hex}) — Click to copy`}
                aria-label={`Copy ${s.name} ${s.hex}`}
              >
                <span class="bp-check" aria-hidden="true">✓</span>
              </button>
            ))}
          </div>
          <button
            type="button"
            class="bp-shuffle"
            data-bp-shuffle
            title="Cycle harmonious palette"
            aria-label="Generate next color palette"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 2l4 4-4 4" />
              <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
              <path d="M7 22l-4-4 4-4" />
              <path d="M21 13v1a4 4 0 0 1-4 4H3" />
            </svg>
          </button>
        </div>
        <div class="bp-meta" data-bp-meta aria-live="polite">
          <span class="bp-hex-list">
            {swatches.map((s) => (
              <span class="bp-chip">
                <i class="bp-dot" style={`background:${s.hex}`}></i>
                <span>{s.hex}</span>
              </span>
            ))}
          </span>
        </div>
      </div>
    </div>
  ) : (
    <ul class:list={['palette', variant, { vertical, featured }]} role="list" aria-label="Color palette">
      {
        swatches.map((s) => (
          <li style={`background:${s.hex};color:${ink(s.hex)}`}>
            <span class="hex">{s.hex}</span>
            <span class="name">{s.name}</span>
          </li>
        ))
      }
    </ul>
  )
}

<script>
  const PRESET_SETS = [
    null, // slot 0 = original brand swatches from data-initial
    [
      { hex: '#00E5FF', name: 'Stage Cyan' },
      { hex: '#082032', name: 'Midnight Club' },
      { hex: '#FFE600', name: 'Spotlight Gold' },
      { hex: '#FF5C35', name: 'Mic Pop' },
    ],
    [
      { hex: '#18B8E8', name: 'Neon Blue' },
      { hex: '#0B1D2E', name: 'Backstage' },
      { hex: '#FFB800', name: 'Amber Glow' },
      { hex: '#F5F3EE', name: 'Warm Cream' },
    ],
    [
      { hex: '#14B8A6', name: 'Teal Punch' },
      { hex: '#042F2E', name: 'Deep Pine' },
      { hex: '#FACC15', name: 'Lemon Fizz' },
      { hex: '#FEF9C3', name: 'Soft Butter' },
    ],
    [
      { hex: '#38BDF8', name: 'Sky Beat' },
      { hex: '#1E1B4B', name: 'Indigo Night' },
      { hex: '#FDE047', name: 'Comedy Gold' },
      { hex: '#FB7185', name: 'Coral Laugh' },
    ],
  ];

  const inkFor = (hex: string) => {
    const [r, g, b] = [1, 3, 5].map((i) => {
      const c = parseInt(hex.slice(i, i + 2), 16) / 255;
      return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.18 ? '#000' : '#fff';
  };

  document.querySelectorAll<HTMLElement>('[data-bencho-palette]').forEach((root) => {
    let original: { hex: string; name: string }[] = [];
    try {
      original = JSON.parse(root.dataset.initial || '[]');
    } catch {}
    if (!original.length) return;

    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-bp-swatch]')];
    const shuffleBtn = root.querySelector<HTMLButtonElement>('[data-bp-shuffle]');
    const metaEl = root.querySelector<HTMLElement>('[data-bp-meta]');
    let setIdx = 0;
    let spinDeg = 0;
    let statusTimer = 0;

    const renderChips = (current: { hex: string; name: string }[], message?: string) => {
      if (!metaEl) return;
      if (message) {
        metaEl.innerHTML = `<span class="bp-status">${message}</span>`;
        return;
      }
      metaEl.innerHTML = `<span class="bp-hex-list">${current
        .map(
          (s) =>
            `<span class="bp-chip"><i class="bp-dot" style="background:${s.hex}"></i><span>${s.hex}</span></span>`,
        )
        .join('')}</span>`;
    };

    const getCurrentSet = () => PRESET_SETS[setIdx] ?? original;

    btns.forEach((btn) => {
      btn.addEventListener('pointerenter', () => {
        const hex = btn.dataset.hex || '';
        const name = btn.dataset.name || '';
        renderChips(getCurrentSet(), `${hex} · ${name}`);
      });
      btn.addEventListener('pointerleave', () => {
        renderChips(getCurrentSet());
      });
      btn.addEventListener('click', () => {
        const hex = btn.dataset.hex || '';
        const name = btn.dataset.name || '';
        navigator.clipboard?.writeText(hex).catch(() => {});
        btn.classList.add('is-copied');
        window.setTimeout(() => btn.classList.remove('is-copied'), 750);
        window.clearTimeout(statusTimer);
        renderChips(getCurrentSet(), `Copied ${hex} (${name})`);
        statusTimer = window.setTimeout(() => renderChips(getCurrentSet()), 1100);
      });
    });

    shuffleBtn?.addEventListener('click', () => {
      setIdx = (setIdx + 1) % PRESET_SETS.length;
      spinDeg += 180;
      const svg = shuffleBtn.querySelector('svg');
      if (svg) svg.style.transform = `rotate(${spinDeg}deg)`;

      const nextSet = getCurrentSet();
      btns.forEach((btn, idx) => {
        const item = nextSet[idx];
        if (!item) return;
        btn.dataset.hex = item.hex;
        btn.dataset.name = item.name;
        btn.style.background = item.hex;
        btn.style.color = inkFor(item.hex);
        btn.title = `${item.name} (${item.hex}) — Click to copy`;
        btn.setAttribute('aria-label', `Copy ${item.name} ${item.hex}`);
      });
      renderChips(nextSet);
    });
  });
</script>

<style>
  .palette {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0;
  }
  li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 84px;
    padding: 10px 12px;
    font-size: 0.75rem;
    line-height: 1.2;
  }
  .hex {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .name {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ---- fill: sized by its slide box, type scales with the slide.
     Slides only exist from 1200px; below that it falls back to the strip. ---- */
  @media (min-width: 1200px) {
    .fill {
      width: 100%;
      height: 100%;
      grid-template-columns: repeat(var(--n, 4), 1fr);
      border-radius: 0.8cqw;
    }
    .fill.featured {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: 3fr 2fr;
    }
    .fill.featured li {
      grid-column: span 3;
    }
    .fill.featured li:nth-child(-n + 2) {
      grid-column: span 6;
    }
    .fill li {
      min-height: 0;
      gap: 0;
      padding: 0.8cqw 0.85cqw;
      font-size: 0.62cqw;
    }
    .fill .name {
      align-self: flex-end;
      text-align: right;
    }
    .fill.vertical li {
      align-items: center;
    }
    .fill.vertical .name {
      align-self: center;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      letter-spacing: 0.12em;
    }
  }

  /* ================= Bencho Palette (Startup Standup) ================= */
  .bencho-palette {
    width: 100%;
    height: 100%;
    min-height: 120px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-fg) 4.5%, var(--c-bg-raised));
    border: 1px solid var(--c-line);
    padding: clamp(8px, 4.5cqi, 16px);
    box-sizing: border-box;
    container-type: inline-size;
    overflow: hidden;
  }
  .bp-stage {
    display: grid;
    justify-items: center;
    gap: clamp(6px, 4.5cqi, 12px);
    width: 100%;
  }
  .bp-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 3cqi, 10px);
    max-width: 100%;
  }
  .bp-capsule {
    display: flex;
    align-items: center;
    gap: clamp(3px, 1.8cqi, 6px);
    padding: clamp(4px, 2.2cqi, 7px);
    border-radius: clamp(12px, 7cqi, 20px);
    background: #ffffff;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 8px 20px rgb(0 0 0 / 0.06);
    border: 1px solid rgb(20 19 18 / 0.07);
  }
  :global(:root[data-theme='dark']) .bp-capsule,
  :global(.cs-reader) .bp-capsule {
    background: #1f1d1a;
    border-color: rgb(239 233 222 / 0.12);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 10px 24px rgb(0 0 0 / 0.35);
  }
  .bp-swatch {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(22px, 14cqi, 46px);
    height: clamp(22px, 14cqi, 46px);
    padding: 0;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: clamp(7px, 4.2cqi, 12px);
    cursor: pointer;
    transition:
      background-color 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s ease;
  }
  :global(:root[data-theme='dark']) .bp-swatch,
  :global(.cs-reader) .bp-swatch {
    border-color: rgb(255 255 255 / 0.14);
  }
  .bp-swatch:hover {
    transform: translateY(-2px) scale(1.06);
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.16);
    z-index: 1;
  }
  .bp-swatch:active {
    transform: scale(0.95);
  }
  .bp-check {
    opacity: 0;
    transform: scale(0.6);
    font: 700 clamp(10px, 5cqi, 14px) / 1 var(--f-body);
    transition: opacity 0.16s ease, transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bp-swatch.is-copied .bp-check {
    opacity: 1;
    transform: scale(1);
  }

  .bp-shuffle {
    display: inline-grid;
    place-items: center;
    width: clamp(26px, 16cqi, 50px);
    height: clamp(30px, 18.5cqi, 58px);
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgb(20 19 18 / 0.07);
    background: #ffffff;
    color: #141312;
    cursor: pointer;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 8px 20px rgb(0 0 0 / 0.06);
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.18s ease;
  }
  :global(:root[data-theme='dark']) .bp-shuffle,
  :global(.cs-reader) .bp-shuffle {
    background: #1f1d1a;
    color: #efe9de;
    border-color: rgb(239 233 222 / 0.12);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 10px 24px rgb(0 0 0 / 0.35);
  }
  .bp-shuffle:hover {
    transform: scale(1.04);
  }
  .bp-shuffle:active {
    transform: scale(0.95);
  }
  .bp-shuffle svg {
    width: clamp(12px, 6.5cqi, 18px);
    height: clamp(12px, 6.5cqi, 18px);
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bp-meta {
    min-height: 16px;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 500 clamp(8.5px, 4.4cqi, 11.5px) / 1.25 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--c-muted);
    text-align: center;
  }
  :global(.bp-hex-list) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px 7px;
  }
  :global(.bp-chip) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  :global(.bp-dot) {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    border: 1px solid rgb(128 128 128 / 0.35);
    flex: none;
  }
  :global(.bp-status) {
    font-family: var(--f-body);
    font-weight: 600;
    color: var(--c-fg);
  }

  @media (min-width: 1200px) {
    .bencho-palette {
      min-height: 0;
      border-radius: 0.8cqw;
      padding: 0.65cqw;
    }
  }
</style>
