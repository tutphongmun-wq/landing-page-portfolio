---
import { contact } from '../data/site';
const year = new Date().getFullYear();
import ContactTopo, { contactTopoBackground } from './ContactTopo';
---

<section class="contact" id="contact" aria-labelledby="contact-title" style={`--contact-bg:${contactTopoBackground}`}>
  <ContactTopo client:visible>
  <div class="container inner">
    <h2 id="contact-title" class="display big" data-reveal>Let’s<br />talk</h2>
    <p class="lead" data-reveal style="--reveal-d: 80ms">Open to Visual, Graphic, Digital and UI / Web design roles.</p>

    <a class="email" href={`mailto:${contact.email}`} data-reveal style="--reveal-d: 140ms">{contact.email}</a>

    <ul class="links" role="list" data-reveal style="--reveal-d: 200ms">
      <li><a href={contact.linkedin.href} rel="noopener" target="_blank">LinkedIn <span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li><a href={contact.behance.href} rel="noopener" target="_blank">Behance <span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li><a href={contact.github.href} rel="noopener" target="_blank">GitHub <span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li><a href="#top">Back to top ↑</a></li>
    </ul>

    <p class="foot">
      © {year} Tutphong Mungkalakul · Folder UI, Rail TOC &amp; Hook Sidebar by <a href="https://www.rareui.com" rel="noopener" target="_blank">Rare UI</a>
    </p>
  </div>
  </ContactTopo>
</section>

<style>
  .contact {
    position: relative;
    /* the Topographic Flow background colour (ContactTopo.tsx), shown until it hydrates */
    background: var(--contact-bg, var(--c-hero));
    color: var(--c-ink);
  }
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 24px;
    padding-block: var(--section-y) 32px;
  }
  .big {
    font-size: clamp(4rem, 2rem + 12vw, 14rem);
    color: var(--c-ink-display);
    line-height: 0.82;
  }
  .lead {
    font-size: 1.25rem;
    font-weight: 700;
    max-width: 32ch;
  }
  .email {
    justify-self: start;
    max-width: 100%;
    padding: 0.45em 0.7em;
    border-radius: 14px;
    background: var(--c-ink-display);
    color: #f2f2f2;
    font-family: var(--f-display);
    font-size: clamp(1rem, 0.55rem + 3vw, 3rem);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .email:hover {
    background: #000;
    color: #fff;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 8px 0 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--c-ink-display);
    color: #f2f2f2;
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    background: #000;
  }
  .foot {
    margin-top: clamp(40px, 8vw, 96px);
    font-size: var(--fs-0);
    font-weight: 700;
  }
  .contact :focus-visible {
    box-shadow: 0 0 0 3px var(--contact-bg, var(--c-hero)), 0 0 0 6px #000;
  }
</style>
