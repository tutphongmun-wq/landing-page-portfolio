---
import { contact } from '../data/site';
import FadeContent from './FadeContent.jsx';
const year = new Date().getFullYear();
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <FadeContent client:load effect="focus" blur={2} duration={0.75} threshold={0.08} once={false} exit={true}>
    <div class="contact-inner">
      <p class="contact-kicker">Contact</p>
      <h2 id="contact-title" class="contact-heading">
        Let’s talk.
      </h2>
      <p class="contact-lead">
        <span data-lang-text="en">Open to Visual, Graphic, Digital, and UI / Web design roles.</span>
        <span data-lang-text="th">เปิดรับโอกาสงานสาย Visual, Graphic, Digital และ UI / Web Design</span>
      </p>

      <a class="contact-email" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>

      <ul class="contact-links" role="list">
      <li>
        <a href={contact.linkedin.href} rel="noopener" target="_blank">
          LinkedIn <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a href={contact.behance.href} rel="noopener" target="_blank">
          Behance <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a href={contact.github.href} rel="noopener" target="_blank">
          GitHub <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a href="#top">Back to top ↑</a>
      </li>
    </ul>

    <p class="contact-foot">
      © {year} Tutphong Mungkalakul · Hook Sidebar inspired by
      <a href="https://www.rareui.com" rel="noopener" target="_blank">Rare UI</a>
    </p>
    </div>
  </FadeContent>
</section>

<style>
  .contact {
    position: relative;
    background: var(--c-bg);
    color: var(--c-fg);
    border-top: 1px solid var(--c-line);
    padding-inline: var(--gutter);
    padding-block: clamp(88px, 11vw, 152px) clamp(40px, 5vw, 64px);
  }

  .contact-inner {
    width: 100%;
    max-width: var(--max-w);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .contact-kicker {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.1;
    color: var(--c-accent);
  }

  .contact-heading {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 600;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    color: var(--c-fg);
  }

  .contact-lead {
    margin: 0;
    font-family: var(--f-nav);
    font-weight: 500;
    font-size: clamp(1.0625rem, 1.35vw, 1.3125rem);
    line-height: 1.5;
    color: var(--c-muted);
    max-width: 44ch;
  }
  :global(:root[data-lang='th']) .contact-lead {
    font-family: var(--f-body);
  }

  .contact-email {
    margin-top: 8px;
    font-family: var(--f-clash);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.8vw, 2.75rem);
    line-height: 1.15;
    color: var(--c-fg);
    text-decoration: none;
    border-bottom: 2px solid var(--c-line);
    padding-bottom: 6px;
    overflow-wrap: anywhere;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .contact-email:hover {
    color: var(--c-accent);
    border-bottom-color: var(--c-accent);
  }
  .contact-email:focus-visible {
    outline: none;
    box-shadow: var(--focus);
    border-radius: 6px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
    margin: 12px 0 0;
    padding: 0;
  }
  .contact-links a {
    font-family: var(--f-nav);
    font-weight: 500;
    font-size: 16px;
    color: var(--c-fg-soft);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .contact-links a:hover {
    color: var(--c-accent);
  }
  .contact-links a:focus-visible {
    outline: none;
    box-shadow: var(--focus);
    border-radius: 4px;
  }

  .contact-foot {
    margin-top: clamp(48px, 7vw, 88px);
    font-size: var(--fs-0);
    color: var(--c-muted);
  }
  .contact-foot a {
    color: var(--c-fg-soft);
    text-underline-offset: 3px;
  }
  .contact-foot a:hover {
    color: var(--c-accent);
  }
</style>
