---
// Desktop left sidebar navigation (>= 1200px). Slides in once the visitor
// scrolls past Hero and hides over the red Contact section. Clean, monochrome,
// and borderless with typography-only scrollspy + quick action icons.
import { projects } from '../data/projects';
import { contact, profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<aside class="side-nav" data-side-nav aria-label="Section navigation" inert>
  <div class="side-head">
    <div class="side-top-row">
      <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
      <LangToggle variant="compact" />
    </div>
    <p class="role">{profile.role}</p>
  </div>

  <nav class="side-scroll" aria-label="Sections & Projects">
    <ul class="nav-tree" role="list">
      <li>
        <a class="nav-link" href="#top" data-spy-target="top">
          <span class="nav-bar" aria-hidden="true"></span>
          <span>Intro</span>
        </a>
      </li>

      <li class="nav-group">
        <a class="nav-link" href="#work" data-spy-target="work" data-spy-branch="work">
          <span class="nav-bar" aria-hidden="true"></span>
          <span>Projects</span>
        </a>
        <div class="sub-wrap">
          <svg class="sub-rail" aria-hidden="true">
            <path class="sub-rail-hover" d="" />
            <path class="sub-rail-active" d="" />
          </svg>
          <ul class="sub-list" role="list">
            {
              projects.map((p) => (
                <li>
                  <a class="sub-link" href={`#${p.slug}`} data-spy-target={p.slug}>
                    <span class="sub-label">{p.spine.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>

      <li>
        <a class="nav-link" href="#about" data-spy-target="about">
          <span class="nav-bar" aria-hidden="true"></span>
          <span>About</span>
        </a>
      </li>
      <li>
        <a class="nav-link" href="#experience" data-spy-target="experience">
          <span class="nav-bar" aria-hidden="true"></span>
          <span>Experience</span>
        </a>
      </li>
      <li>
        <a class="nav-link" href="#contact" data-spy-target="contact">
          <span class="nav-bar" aria-hidden="true"></span>
          <span>Contact</span>
        </a>
      </li>
    </ul>
  </nav>

  <script>
    (() => {
      const tree = document.querySelector<HTMLElement>('.nav-tree');
      const wrap = document.querySelector<HTMLElement>('.sub-wrap');
      const svg = wrap?.querySelector<SVGSVGElement>('.sub-rail');
      const hoverPath = svg?.querySelector<SVGPathElement>('.sub-rail-hover');
      const activePath = svg?.querySelector<SVGPathElement>('.sub-rail-active');
      if (!tree || !wrap || !svg || !hoverPath || !activePath) return;

      const subLinks = Array.from(wrap.querySelectorAll<HTMLAnchorElement>('.sub-link'));
      const allLinks = Array.from(tree.querySelectorAll<HTMLAnchorElement>('.nav-link, .sub-link'));
      if (!subLinks.length) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const X0 = 15;
      const X1 = 24;
      const RADIUS = 7.5;

      let hoveredEl: HTMLAnchorElement | null = null;
      let heldEl: HTMLAnchorElement | null = null;
      let holdTimer = 0;

      let curActiveY = 0;
      let targetActiveY = 0;
      let curActiveOp = 0;
      let targetActiveOp = 0;

      let curHoverY = 0;
      let targetHoverY = 0;
      let curHoverStart = 0;
      let curHoverOp = 0;
      let targetHoverOp = 0;

      let rafId = 0;
      let lastTs = 0;

      function getCenterY(el: HTMLElement): number {
        const wr = wrap!.getBoundingClientRect();
        const er = el.getBoundingClientRect();
        return er.top - wr.top + er.height * 0.5;
      }

      function buildElbow(yStart: number, yTarget: number, radius = RADIUS): string {
        const y0 = Math.max(0, yStart);
        const y1 = Math.max(y0, yTarget);
        const span = y1 - y0;
        const r = Math.min(radius, span * 0.55, (X1 - X0) * 0.72);
        const turnY = Math.max(y0, y1 - r);
        return `M ${X0.toFixed(1)} ${y0.toFixed(1)} L ${X0.toFixed(1)} ${turnY.toFixed(1)} Q ${X0.toFixed(1)} ${y1.toFixed(1)} ${(X0 + r).toFixed(1)} ${y1.toFixed(1)} L ${X1.toFixed(1)} ${y1.toFixed(1)}`;
      }

      function syncSvgBox() {
        const w = wrap!.clientWidth;
        const h = wrap!.clientHeight;
        svg!.setAttribute('viewBox', `0 0 ${w} ${h}`);
      }

      function getActiveSubLink(): HTMLAnchorElement | null {
        if (heldEl && subLinks.includes(heldEl)) return heldEl;
        return subLinks.find((a) => a.classList.contains('is-active')) ?? null;
      }

      function applyImmediateHold() {
        allLinks.forEach((a) => {
          a.classList.toggle('is-nav-held', heldEl === a);
        });
        tree!.classList.toggle('has-nav-hold', heldEl !== null);
        // Ensure Projects parent shows branch highlight when holding a project link
        const projectsLink = tree!.querySelector<HTMLAnchorElement>('.nav-link[data-spy-branch="work"]');
        if (projectsLink) {
          const holdingSub = heldEl !== null && subLinks.includes(heldEl);
          projectsLink.classList.toggle('is-branch-held', holdingSub);
        }
      }

      function updateTargets(fromHoverChange = false) {
        const activeSub = getActiveSubLink();
        if (activeSub) {
          const nextY = getCenterY(activeSub);
          if (targetActiveOp < 0.05 && curActiveOp < 0.05) {
            curActiveY = 0;
          }
          targetActiveY = nextY;
          targetActiveOp = 1;
        } else {
          targetActiveOp = 0;
        }

        if (hoveredEl && hoveredEl !== activeSub) {
          const hY = getCenterY(hoveredEl);
          let hStart = 0;
          if (activeSub) {
            const aY = getCenterY(activeSub);
            // Branch gracefully from the active red rail if below it, or tap off trunk above it
            hStart = hY > aY ? Math.max(0, aY - 2) : Math.max(0, hY - 14);
          }
          if (fromHoverChange && curHoverOp < 0.05) {
            curHoverY = hStart;
            curHoverStart = hStart;
          } else {
            curHoverStart = hStart;
          }
          targetHoverY = hY;
          targetHoverOp = 1;
        } else {
          targetHoverOp = 0;
        }

        scheduleTick();
      }

      function renderFrame() {
        if (curActiveOp > 0.01 || targetActiveOp > 0.01) {
          activePath!.setAttribute('d', buildElbow(0, curActiveY));
          activePath!.style.opacity = curActiveOp.toFixed(3);
        } else {
          activePath!.style.opacity = '0';
        }

        if (curHoverOp > 0.01 || targetHoverOp > 0.01) {
          const hStart =
            targetActiveOp > 0.05
              ? targetHoverY > curActiveY
                ? Math.max(0, curActiveY - 2)
                : Math.max(0, curHoverY - 14)
              : 0;
          curHoverStart += (hStart - curHoverStart) * 0.35;
          hoverPath!.setAttribute('d', buildElbow(curHoverStart, Math.max(curHoverStart, curHoverY)));
          hoverPath!.style.opacity = curHoverOp.toFixed(3);
        } else {
          hoverPath!.style.opacity = '0';
        }
      }

      function step(ts: number) {
        const dt = lastTs ? Math.min(48, ts - lastTs) : 16;
        lastTs = ts;

        if (reduceMotion) {
          curActiveY = targetActiveY;
          curActiveOp = targetActiveOp;
          curHoverY = targetHoverY;
          curHoverOp = targetHoverOp;
          renderFrame();
          rafId = 0;
          lastTs = 0;
          return;
        }

        const kPos = 1 - Math.exp(-dt / 52);
        const kOp = 1 - Math.exp(-dt / 42);

        curActiveY += (targetActiveY - curActiveY) * kPos;
        curActiveOp += (targetActiveOp - curActiveOp) * kOp;
        curHoverY += (targetHoverY - curHoverY) * kPos;
        curHoverOp += (targetHoverOp - curHoverOp) * kOp;

        renderFrame();

        const settled =
          Math.abs(targetActiveY - curActiveY) < 0.25 &&
          Math.abs(targetActiveOp - curActiveOp) < 0.01 &&
          Math.abs(targetHoverY - curHoverY) < 0.25 &&
          Math.abs(targetHoverOp - curHoverOp) < 0.01;

        if (settled) {
          curActiveY = targetActiveY;
          curActiveOp = targetActiveOp;
          curHoverY = targetHoverY;
          curHoverOp = targetHoverOp;
          renderFrame();
          rafId = 0;
          lastTs = 0;
        } else {
          rafId = requestAnimationFrame(step);
        }
      }

      function scheduleTick() {
        syncSvgBox();
        if (!rafId) {
          lastTs = 0;
          rafId = requestAnimationFrame(step);
        }
      }

      // Hover interactions on sub-list project items
      subLinks.forEach((link) => {
        link.addEventListener('pointerenter', () => {
          hoveredEl = link;
          updateTargets(true);
        });
        link.addEventListener('focus', () => {
          hoveredEl = link;
          updateTargets(true);
        });
      });

      wrap.addEventListener('pointerleave', () => {
        hoveredEl = null;
        updateTargets(false);
      });
      wrap.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (!next || !wrap.contains(next)) {
          hoveredEl = null;
          updateTargets(false);
        }
      });

      // Instantaneous red click animation + tactile pulse across all sidebar nav items
      allLinks.forEach((link) => {
        link.addEventListener('click', () => {
          link.classList.remove('is-click-pulse');
          void link.offsetWidth;
          link.classList.add('is-click-pulse');
          window.setTimeout(() => link.classList.remove('is-click-pulse'), 280);

          window.clearTimeout(holdTimer);
          heldEl = link;
          applyImmediateHold();
          updateTargets(false);

          holdTimer = window.setTimeout(() => {
            heldEl = null;
            applyImmediateHold();
            updateTargets(false);
          }, 1800);
        });
      });

      // Release click-hold early if user manually wheels/touches or scrollspy reaches target
      const cancelHold = () => {
        if (!heldEl) return;
        window.clearTimeout(holdTimer);
        heldEl = null;
        applyImmediateHold();
        updateTargets(false);
      };
      window.addEventListener('wheel', cancelHold, { passive: true });
      window.addEventListener('touchstart', cancelHold, { passive: true });

      const mo = new MutationObserver(() => {
        if (heldEl && heldEl.classList.contains('is-active')) {
          window.clearTimeout(holdTimer);
          heldEl = null;
          applyImmediateHold();
        }
        updateTargets(false);
      });
      allLinks.forEach((el) => mo.observe(el, { attributes: true, attributeFilter: ['class'] }));

      window.addEventListener('resize', () => {
        syncSvgBox();
        updateTargets(false);
      });

      syncSvgBox();
      requestAnimationFrame(() => updateTargets(false));
    })();
  </script>

  <div class="side-bottom">
    <div class="scroll-tuner" data-scroll-tuner aria-label="Scroll feel presets">
      <div class="st-row-top">
        <span class="st-label">Scroll Weight</span>
        <button type="button" class="st-snap is-on" data-snap-toggle title="Toggle magnetic snap on project heads">
          Magnet: ON
        </button>
      </div>
      <div class="st-group" role="group" aria-label="Inertia level">
        <button type="button" class="st-btn" data-preset="light" title="Light inertia (lerp 0.14)">Light</button>
        <button type="button" class="st-btn is-active" data-preset="studio" title="Studio / Worachet feel (lerp 0.085, weight 0.85)">Studio</button>
        <button type="button" class="st-btn" data-preset="heavy" title="Heavy editorial inertia (lerp 0.055, weight 0.75)">Heavy</button>
        <button type="button" class="st-btn" data-preset="off" title="Native browser scroll">Off</button>
      </div>
    </div>

    <div class="side-foot">
      <a class="ico-btn" href={`mailto:${contact.email}`} aria-label="Send email" title={`Email (${contact.email})`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.linkedin.href} rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
          <path d="M8 11v5M8 8.2v.01M12 16v-5m0 1.8a2.5 2.5 0 0 1 4 2V16"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.behance.href} rel="noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 7.5h4.2a2.1 2.1 0 0 1 0 4.2H3.5zm0 4.2h4.6a2.3 2.3 0 0 1 0 4.6H3.5z"></path>
          <path d="M14.5 9.2h4.2M13.5 14h6.8a3.4 3.4 0 1 0-1.1 2.4"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.github.href} rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.5 1.4-4.5-2.3-6.3-2.8m12.6 5.6v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.6 0C6.1 1.8 5 2.2 5 2.2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.5 9.3c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4v3.5"></path>
        </svg>
      </a>

      <ThemeToggle compact />
    </div>
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-side-nav]');
  if (side) {
    const hero = document.querySelector('.hero');
    const contactEl = document.querySelector('#contact');
    const desktopMq = window.matchMedia('(min-width: 1200px)');

    // Contextual show/hide: hidden over Hero and Contact, active in between on desktop
    let pastHero = !hero;
    let atContact = false;
    const syncVisibility = () => {
      const show = desktopMq.matches && pastHero && !atContact;
      side.classList.toggle('is-visible', show);
      side.inert = !show;
    };

    if (hero) {
      new IntersectionObserver(([e]) => {
        pastHero = !e.isIntersecting;
        syncVisibility();
      }, { threshold: 0.12 }).observe(hero);
    }
    if (contactEl) {
      new IntersectionObserver(([e]) => {
        atContact = e.isIntersecting;
        syncVisibility();
      }, { rootMargin: '0px 0px -35% 0px' }).observe(contactEl);
    }
    desktopMq.addEventListener('change', syncVisibility);
    syncVisibility();

    // Scrollspy for Intro, Work, Projects 01..07, About, Experience, Contact
    const links = [...side.querySelectorAll<HTMLAnchorElement>('[data-spy-target]')];
    const workBranch = side.querySelector<HTMLAnchorElement>('[data-spy-branch="work"]');
    const targets = links
      .map((link) => {
        const id = link.dataset.spyTarget!;
        const el = document.getElementById(id);
        return el ? { id, el, link, isProject: link.classList.contains('sub-link') } : null;
      })
      .filter((x): x is { id: string; el: HTMLElement; link: HTMLAnchorElement; isProject: boolean } => x !== null);

    let activeId = '';
    const applyActive = (nextId: string) => {
      if (nextId === activeId) return;
      activeId = nextId;
      let isWorkBranch = false;
      for (const item of targets) {
        const hit = item.id === nextId;
        item.link.classList.toggle('is-active', hit);
        if (hit) {
          item.link.setAttribute('aria-current', 'location');
          if (item.id === 'work' || item.isProject) isWorkBranch = true;
        } else {
          item.link.removeAttribute('aria-current');
        }
      }
      workBranch?.classList.toggle('is-branch-active', isWorkBranch);
    };

    const computeActive = () => {
      if (!desktopMq.matches || !targets.length) return;
      const doc = document.documentElement;
      if (contactEl && window.scrollY + window.innerHeight >= doc.scrollHeight - 40) {
        applyActive('contact');
        return;
      }
      const cutoff = window.innerHeight * 0.42;
      let current = targets[0].id;
      for (const item of targets) {
        if (item.el.getBoundingClientRect().top <= cutoff) {
          current = item.id;
        }
      }
      applyActive(current);
    };

    let raf = 0;
    const scheduleSpy = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        computeActive();
      });
    };

    window.addEventListener('scroll', scheduleSpy, { passive: true });
    window.addEventListener('resize', scheduleSpy, { passive: true });
    const spyIo = new IntersectionObserver(scheduleSpy, { rootMargin: '-35% 0px -55% 0px' });
    targets.forEach((t) => spyIo.observe(t.el));
    computeActive();
  }
</script>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 45;
      width: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      padding: 24px 16px 16px 20px;
      background: color-mix(in srgb, var(--c-bg) 94%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: translateX(-104%);
      transition:
        transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
        background-color 0.3s ease;
    }
    .side-nav.is-visible {
      transform: translateX(0);
    }

    .side-head {
      padding-left: 2px;
    }
    .side-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .brand {
      display: inline-block;
      font-family: var(--f-display);
      font-size: 1.45rem;
      line-height: 1;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--c-fg);
    }
    .role {
      margin-top: 6px;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--c-muted);
      line-height: 1.3;
    }

    .side-scroll {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block: 6px;
    }
    .nav-tree {
      display: grid;
      gap: 3px;
      margin: auto 0;
    }
    .nav-group {
      display: grid;
      gap: 2px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      height: 33px;
      padding-inline: 10px;
      border-radius: 8px;
      border: 1px solid transparent;
      font: 500 14px / 1.2 var(--f-body);
      color: var(--c-muted);
      text-decoration: none;
      transition:
        color 0.16s ease,
        border-color 0.16s ease,
        background-color 0.16s ease,
        box-shadow 0.16s ease,
        transform 0.14s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nav-bar {
      width: 12px;
      height: 1.5px;
      background: currentColor;
      opacity: 0.45;
      flex: none;
      transition:
        width 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.2s ease,
        background-color 0.2s ease;
    }
    .nav-link:hover {
      color: var(--c-fg);
    }
    .nav-link:hover .nav-bar {
      width: 16px;
      opacity: 0.85;
    }

    .nav-link.is-branch-active,
    .nav-link.is-branch-held {
      color: var(--c-fg);
    }
    .nav-link.is-branch-active .nav-bar,
    .nav-link.is-branch-held .nav-bar {
      width: 14px;
      opacity: 0.92;
      background: var(--c-accent);
    }

    .nav-tree:not(.has-nav-hold) .nav-link.is-active,
    .nav-link.is-nav-held {
      color: var(--c-fg);
      border-color: rgb(20 19 18 / 0.14);
      background: var(--c-bg-raised);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.72);
    }
    :global(:root[data-theme='dark']) .nav-tree:not(.has-nav-hold) .nav-link.is-active,
    :global(:root[data-theme='dark']) .nav-link.is-nav-held {
      border-color: rgb(239 233 222 / 0.16);
      background: #1c1a18;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    }
    .nav-tree:not(.has-nav-hold) .nav-link.is-active .nav-bar,
    .nav-link.is-nav-held .nav-bar {
      width: 20px;
      opacity: 1;
      background: var(--c-accent);
    }
    .nav-tree.has-nav-hold .nav-link.is-active:not(.is-nav-held) {
      border-color: transparent;
      background: transparent;
      box-shadow: none;
    }
    .nav-tree.has-nav-hold .nav-link.is-active:not(.is-nav-held):not(.is-branch-held) {
      color: var(--c-muted);
    }
    .nav-tree.has-nav-hold .nav-link.is-active:not(.is-nav-held):not(.is-branch-held) .nav-bar {
      width: 12px;
      opacity: 0.45;
      background: currentColor;
    }

    .sub-wrap {
      position: relative;
      margin: 2px 0 4px;
      padding-left: 27px;
    }
    .sub-rail {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
    }
    .sub-rail-hover,
    .sub-rail-active {
      fill: none;
      stroke-width: 1.5;
      stroke-dasharray: 2 3.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0;
    }
    .sub-rail-hover {
      stroke: rgb(20 19 18 / 0.3);
    }
    :global(:root[data-theme='dark']) .sub-rail-hover {
      stroke: rgb(239 233 222 / 0.34);
    }
    .sub-rail-active {
      stroke: var(--c-accent);
    }

    .sub-list {
      display: grid;
      gap: 2px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .sub-link {
      display: flex;
      align-items: center;
      height: 29px;
      padding-inline: 9px;
      border-radius: 8px;
      border: 1px solid transparent;
      font: 500 14px / 1.2 var(--f-body);
      letter-spacing: -0.005em;
      color: var(--c-muted);
      text-decoration: none;
      transition:
        color 0.16s ease,
        border-color 0.16s ease,
        background-color 0.16s ease,
