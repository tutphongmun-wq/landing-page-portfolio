---
// Desktop left sidebar navigation (>= 1200px). Slides in once the visitor
// scrolls past Hero and hides over the red Contact section. Clean, monochrome,
// and borderless with typography-only scrollspy + quick action icons.
import { projects } from '../data/projects';
import { contact, profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<aside class="side-nav" data-side-nav aria-label="Section navigation" inert>
  <div class="side-head">
    <div class="side-top-row">
      <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
      <LangToggle variant="compact" />
    </div>
    <p class="role">{profile.role}</p>
  </div>

  <nav class="side-scroll" aria-label="Sections & Projects">
    <ul class="nav-tree" role="list">
      <li>
        <a class="nav-link" href="#top" data-spy-target="top">Intro</a>
      </li>

      <li class="nav-group">
        <a class="nav-link" href="#work" data-spy-target="work" data-spy-branch="work">Work</a>
        <ul class="sub-list" role="list">
          {
            projects.map((p) => (
              <li>
                <a class="sub-link" href={`#${p.slug}`} data-spy-target={p.slug}>
                  <span class="sub-no">{p.no}</span>
                  <span class="sub-label">{p.spine.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </li>

      <li>
        <a class="nav-link" href="#about" data-spy-target="about">About</a>
      </li>
      <li>
        <a class="nav-link" href="#experience" data-spy-target="experience">Experience</a>
      </li>
      <li>
        <a class="nav-link" href="#contact" data-spy-target="contact">Contact</a>
      </li>
    </ul>
  </nav>

  <div class="side-foot">
    <a class="ico-btn" href={`mailto:${contact.email}`} aria-label="Send email" title={`Email (${contact.email})`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
        <path d="m4 7 8 6 8-6"></path>
      </svg>
    </a>

    <a class="ico-btn" href={contact.linkedin.href} rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
        <path d="M8 11v5M8 8.2v.01M12 16v-5m0 1.8a2.5 2.5 0 0 1 4 2V16"></path>
      </svg>
    </a>

    <a class="ico-btn" href={contact.behance.href} rel="noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3.5 7.5h4.2a2.1 2.1 0 0 1 0 4.2H3.5zm0 4.2h4.6a2.3 2.3 0 0 1 0 4.6H3.5z"></path>
        <path d="M14.5 9.2h4.2M13.5 14h6.8a3.4 3.4 0 1 0-1.1 2.4"></path>
      </svg>
    </a>

    <a class="ico-btn" href={contact.github.href} rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-4.5 1.4-4.5-2.3-6.3-2.8m12.6 5.6v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.6 0C6.1 1.8 5 2.2 5 2.2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.5 9.3c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4v3.5"></path>
      </svg>
    </a>

    <ThemeToggle compact />
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-side-nav]');
  if (side) {
    const hero = document.querySelector('.hero');
    const contactEl = document.querySelector('#contact');
    const desktopMq = window.matchMedia('(min-width: 1200px)');

    // Contextual show/hide: hidden over Hero and Contact, active in between on desktop
    let pastHero = !hero;
    let atContact = false;
    const syncVisibility = () => {
      const show = desktopMq.matches && pastHero && !atContact;
      side.classList.toggle('is-visible', show);
      side.inert = !show;
    };

    if (hero) {
      new IntersectionObserver(([e]) => {
        pastHero = !e.isIntersecting;
        syncVisibility();
      }, { threshold: 0.12 }).observe(hero);
    }
    if (contactEl) {
      new IntersectionObserver(([e]) => {
        atContact = e.isIntersecting;
        syncVisibility();
      }, { rootMargin: '0px 0px -35% 0px' }).observe(contactEl);
    }
    desktopMq.addEventListener('change', syncVisibility);
    syncVisibility();

    // Scrollspy for Intro, Work, Projects 01..07, About, Experience, Contact
    const links = [...side.querySelectorAll<HTMLAnchorElement>('[data-spy-target]')];
    const workBranch = side.querySelector<HTMLAnchorElement>('[data-spy-branch="work"]');
    const targets = links
      .map((link) => {
        const id = link.dataset.spyTarget!;
        const el = document.getElementById(id);
        return el ? { id, el, link, isProject: link.classList.contains('sub-link') } : null;
      })
      .filter((x): x is { id: string; el: HTMLElement; link: HTMLAnchorElement; isProject: boolean } => x !== null);

    let activeId = '';
    const applyActive = (nextId: string) => {
      if (nextId === activeId) return;
      activeId = nextId;
      let isWorkBranch = false;
      for (const item of targets) {
        const hit = item.id === nextId;
        item.link.classList.toggle('is-active', hit);
        if (hit) {
          item.link.setAttribute('aria-current', 'location');
          if (item.id === 'work' || item.isProject) isWorkBranch = true;
        } else {
          item.link.removeAttribute('aria-current');
        }
      }
      workBranch?.classList.toggle('is-branch-active', isWorkBranch);
    };

    const computeActive = () => {
      if (!desktopMq.matches || !targets.length) return;
      const doc = document.documentElement;
      if (contactEl && window.scrollY + window.innerHeight >= doc.scrollHeight - 40) {
        applyActive('contact');
        return;
      }
      const cutoff = window.innerHeight * 0.42;
      let current = targets[0].id;
      for (const item of targets) {
        if (item.el.getBoundingClientRect().top <= cutoff) {
          current = item.id;
        }
      }
      applyActive(current);
    };

    let raf = 0;
    const scheduleSpy = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        computeActive();
      });
    };

    window.addEventListener('scroll', scheduleSpy, { passive: true });
    window.addEventListener('resize', scheduleSpy, { passive: true });
    const spyIo = new IntersectionObserver(scheduleSpy, { rootMargin: '-35% 0px -55% 0px' });
    targets.forEach((t) => spyIo.observe(t.el));
    computeActive();
  }
</script>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 45;
      width: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      padding: 28px 16px 20px 22px;
      background: color-mix(in srgb, var(--c-bg) 94%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: translateX(-104%);
      transition:
        transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
        background-color 0.3s ease;
    }
    .side-nav.is-visible {
      transform: translateX(0);
    }

    .side-head {
      padding-left: 2px;
    }
    .side-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .brand {
      display: inline-block;
      font-family: var(--f-display);
      font-size: 1.45rem;
      line-height: 1;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--c-fg);
    }
    .role {
      margin-top: 6px;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--c-muted);
      line-height: 1.3;
    }

    .side-scroll {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block: 4px;
    }
    .nav-tree {
      display: grid;
      gap: 6px;
      margin: 0;
    }
    .nav-group {
      display: grid;
      gap: 4px;
    }

    .nav-link {
      display: block;
      padding: 4px 2px;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--c-muted);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    .nav-link:hover {
      color: var(--c-fg);
    }
    .nav-link.is-active,
    .nav-link.is-branch-active {
      color: var(--c-fg);
      font-weight: 700;
    }

    .sub-list {
      display: grid;
      gap: 3px;
      margin: 2px 0 6px;
      padding: 0 0 0 12px;
      list-style: none;
    }
    .sub-link {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 4px 2px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--c-muted);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    .sub-no {
      flex: none;
      font-size: 0.72rem;
      font-variant-numeric: tabular-nums;
      opacity: 0.55;
    }
    .sub-label {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sub-link:hover {
      color: var(--c-fg);
    }
    .sub-link.is-active {
      color: var(--c-fg);
      font-weight: 700;
    }
    .sub-link.is-active .sub-no {
      opacity: 1;
    }

    .side-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
      padding-top: 8px;
    }
    .ico-btn {
      display: inline-grid;
      place-items: center;
      width: 34px;
      height: 40px;
      border-radius: 8px;
      color: var(--c-muted);
      text-decoration: none;
      transition: color 0.18s ease, background-color 0.18s ease;
    }
    .ico-btn:hover {
      color: var(--c-fg);
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-nav {
      transition: none;
    }
  }
</style>
