---
// Desktop left sidebar navigation (>= 1200px) with RareUI Bounce Sidebar
// (https://www.rareui.com/components/bouncesidebar) spring-animated active dot indicator.
// Slides in once the visitor scrolls past Hero and stays visible down through minimal Contact.
import { projects } from '../data/projects';
import { contact, profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<aside class="side-nav" data-side-nav aria-label="Section navigation" inert>
  <div class="side-head">
    <div class="side-top-row">
      <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
      <LangToggle variant="compact" />
    </div>
    <p class="role">{profile.role}</p>
  </div>

  <nav class="side-scroll" data-bounce-sidebar aria-label="Sections & Projects">
    <ul class="bs-list" role="list">
      <!-- Bouncy spring-animated active marker (RareUI BounceSidebar) -->
      <span class="bs-marker" data-bs-marker aria-hidden="true"></span>

      <li class="bs-item" data-bs-id="top">
        <a class="bs-link" href="#top"><span class="bs-label">Intro</span></a>
      </li>

      <li class="bs-heading" aria-hidden="true">Projects</li>

      {
        projects.map((p) => (
          <li class="bs-item" data-bs-id={p.slug}>
            <a class="bs-link" href={`#${p.slug}`}>
              <span class="bs-label">{p.spine.label}</span>
            </a>
          </li>
        ))
      }

      <li class="bs-heading" aria-hidden="true">Profile</li>

      <li class="bs-item" data-bs-id="about">
        <a class="bs-link" href="#about"><span class="bs-label">About</span></a>
      </li>
      <li class="bs-item" data-bs-id="experience">
        <a class="bs-link" href="#experience"><span class="bs-label">Experience</span></a>
      </li>
      <li class="bs-item" data-bs-id="contact">
        <a class="bs-link" href="#contact"><span class="bs-label">Contact</span></a>
      </li>
    </ul>
  </nav>

  <div class="side-bottom">
    <div class="scroll-tuner" data-scroll-tuner aria-label="Scroll feel presets">
      <div class="st-row-top">
        <span class="st-label">Scroll Weight</span>
        <button type="button" class="st-snap is-on" data-snap-toggle title="Toggle magnetic snap on project heads">
          Magnet: ON
        </button>
      </div>
      <div class="st-group" role="group" aria-label="Inertia level">
        <button type="button" class="st-btn" data-preset="light" title="Light inertia (lerp 0.14)">Light</button>
        <button type="button" class="st-btn is-active" data-preset="studio" title="Studio / Worachet feel (lerp 0.085, weight 0.85)">Studio</button>
        <button type="button" class="st-btn" data-preset="heavy" title="Heavy editorial inertia (lerp 0.055, weight 0.75)">Heavy</button>
        <button type="button" class="st-btn" data-preset="off" title="Native browser scroll">Off</button>
      </div>
    </div>

    <div class="side-foot">
      <a class="ico-btn" href={`mailto:${contact.email}`} aria-label="Send email" title={`Email (${contact.email})`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.linkedin.href} rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
          <path d="M8 11v5M8 8.2v.01M12 16v-5m0 1.8a2.5 2.5 0 0 1 4 2V16"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.behance.href} rel="noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 7.5h4.2a2.1 2.1 0 0 1 0 4.2H3.5zm0 4.2h4.6a2.3 2.3 0 0 1 0 4.6H3.5z"></path>
          <path d="M14.5 9.2h4.2M13.5 14h6.8a3.4 3.4 0 1 0-1.1 2.4"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.github.href} rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.5 1.4-4.5-2.3-6.3-2.8m12.6 5.6v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.6 0C6.1 1.8 5 2.2 5 2.2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.5 9.3c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4v3.5"></path>
        </svg>
      </a>

      <ThemeToggle compact />
    </div>
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-side-nav]');
  if (side) {
    const hero = document.querySelector('.hero');
    const desktopMq = window.matchMedia('(min-width: 1200px)');
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Contextual show/hide: hidden over Hero, visible across Projects, About, Experience & Contact
    let pastHero = !hero;
    const syncVisibility = () => {
      const show = desktopMq.matches && pastHero;
      side.classList.toggle('is-visible', show);
      side.inert = !show;
    };

    if (hero) {
      new IntersectionObserver(
        ([e]) => {
          pastHero = !e.isIntersecting;
          syncVisibility();
        },
        { threshold: 0.12 },
      ).observe(hero);
    }
    desktopMq.addEventListener('change', syncVisibility);
    syncVisibility();

    // RareUI Bounce Sidebar spring physics controller
    const nav = side.querySelector<HTMLElement>('[data-bounce-sidebar]');
    const list = nav?.querySelector<HTMLUListElement>('.bs-list');
    const marker = nav?.querySelector<HTMLElement>('[data-bs-marker]');

    if (nav && list && marker) {
      const items = [...list.querySelectorAll<HTMLLIElement>('.bs-item')]
        .map((li) => {
          const id = li.dataset.bsId ?? '';
          const link = li.querySelector<HTMLAnchorElement>('.bs-link');
          const target = id ? document.getElementById(id) : null;
          return link ? { li, id, link, target } : null;
        })
        .filter((x): x is { li: HTMLLIElement; id: string; link: HTMLAnchorElement; target: HTMLElement | null } => x !== null);

      let activeIdx = 0;
      let pinnedIdx: number | null = null;
      let userScrolled = false;
      let placed = false;

      // Underdamped harmonic spring state for the bouncing red dot
      let y = 0;
      let vy = 0;
      let targetY = 0;
      let rafId = 0;
      let lastT = 0;

      const STIFFNESS = 460;
      const DAMPING = 23;

      const renderMarker = (posY: number, velocity: number) => {
        const stretch = Math.min(0.85, Math.abs(velocity) * 0.0012);
        const sy = 1 + stretch;
        const sx = 1 / Math.sqrt(sy);
        marker.style.transform = `translate3d(0, ${posY.toFixed(2)}px, 0) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;
      };

      const step = (now: number) => {
        const dt = Math.min(0.032, Math.max(0.004, (now - lastT) / 1000));
        lastT = now;

        const force = -STIFFNESS * (y - targetY) - DAMPING * vy;
        vy += force * dt;
        y += vy * dt;

        if (Math.abs(y - targetY) < 0.15 && Math.abs(vy) < 1.2) {
          y = targetY;
          vy = 0;
          renderMarker(y, 0);
          rafId = 0;
          return;
        }

        renderMarker(y, vy);
        rafId = requestAnimationFrame(step);
      };

      const moveMarkerTo = (idx: number, instant = false) => {
        const item = items[idx];
        if (!item) return;
        const listRect = list.getBoundingClientRect();
        const itemRect = item.li.getBoundingClientRect();
        if (itemRect.height <= 0) return;

        const nextY = itemRect.top - listRect.top + itemRect.height / 2;
        targetY = nextY;

        if (!placed || instant || reduceMq.matches) {
          placed = true;
          y = nextY;
          vy = 0;
          marker.classList.add('is-ready');
          renderMarker(y, 0);
          return;
        }

        marker.classList.add('is-ready');
        if (!rafId) {
          lastT = performance.now();
          rafId = requestAnimationFrame(step);
        }
      };

      const setActive = (idx: number, instant = false) => {
        const clamped = Math.max(0, Math.min(items.length - 1, idx));
        const changed = clamped !== activeIdx || !placed;
        activeIdx = clamped;

        items.forEach((it, i) => {
          const isAct = i === activeIdx;
          it.link.classList.toggle('is-active', isAct);
          if (isAct) it.link.setAttribute('aria-current', 'location');
          else it.link.removeAttribute('aria-current');
        });

        if (changed) moveMarkerTo(activeIdx, instant);
      };

      const detectActiveFromScroll = () => {
        if (pinnedIdx !== null && !userScrolled) {
          setActive(pinnedIdx);
          return;
        }
        pinnedIdx = null;

        // Near bottom of document -> activate Contact
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 40) {
          setActive(items.length - 1);
          return;
        }

        const anchorY = window.innerHeight * 0.34;
        let best = 0;
        items.forEach((it, i) => {
          if (!it.target) return;
          const top = it.target.getBoundingClientRect().top;
          if (top <= anchorY) best = i;
        });
        setActive(best);
      };

      items.forEach((it, idx) => {
        it.link.addEventListener('click', () => {
          pinnedIdx = idx;
          userScrolled = false;
          setActive(idx);
        });
      });

      const onIntent = (e: Event) => {
        if (e.type === 'pointerdown' && e.target instanceof Element && e.target.closest('[data-bounce-sidebar]')) {
          return;
        }
        userScrolled = true;
      };

      window.addEventListener('scroll', detectActiveFromScroll, { passive: true });
      window.addEventListener('wheel', onIntent, { passive: true });
      window.addEventListener('touchstart', onIntent, { passive: true });
      window.addEventListener('pointerdown', onIntent);
      window.addEventListener('keydown', onIntent);
      window.addEventListener('resize', () => moveMarkerTo(activeIdx, true));

      const ro = new ResizeObserver(() => moveMarkerTo(activeIdx, true));
      ro.observe(list);
      document.fonts?.ready.then(() => moveMarkerTo(activeIdx, true)).catch(() => {});
      detectActiveFromScroll();
    }
  }
</script>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 45;
      width: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      padding: 36px 24px 24px 28px;
      background: color-mix(in srgb, var(--c-bg) 96%, transparent);
      border-right: 1px solid var(--c-line);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: translateX(-104%);
      transition:
        transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
        background-color 0.3s ease;
    }
    .side-nav.is-visible {
      transform: translateX(0);
    }

    .side-head {
      padding-left: 2px;
    }
    .side-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .brand {
      display: inline-block;
      font-family: var(--f-display);
      font-size: 1.45rem;
      line-height: 1;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--c-fg);
    }
    .role {
      margin-top: 6px;
      font-family: var(--f-nav);
      font-size: 0.75rem;
      font-weight: 400;
      color: var(--c-muted);
      line-height: 1.3;
    }

    .side-scroll {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block: 6px;
    }

    /* ================= RAREUI BOUNCE SIDEBAR ================= */
    .bs-list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: auto 0;
      padding: 0;
      list-style: none;
    }

    .bs-marker {
      position: absolute;
      left: 4px;
      top: 0;
      width: 7px;
      height: 7px;
      margin-top: -3.5px;
      border-radius: 999px;
      background: var(--c-accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-accent) 16%, transparent);
      opacity: 0;
      pointer-events: none;
      will-change: transform;
      transition: opacity 0.2s ease;
    }
    .bs-marker.is-ready {
      opacity: 1;
    }

    .bs-heading {
      margin-top: 14px;
      margin-bottom: 4px;
      padding-left: 20px;
      font-family: var(--f-clash);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--c-muted);
      opacity: 0.72;
      user-select: none;
    }

    .bs-item {
      position: relative;
    }

    .bs-link {
      display: flex;
      align-items: center;
      padding: 5px 8px 5px 20px;
      border-radius: 8px;
      text-decoration: none;
      color: var(--c-muted);
      font-family: var(--f-nav);
      font-size: 13.5px;
      font-weight: 500;
      line-height: 1.3;
      transition: color 0.18s ease, background-color 0.18s ease;
    }

    .bs-label {
      display: inline-block;
      transition: transform 0.36s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .bs-link:hover {
      color: var(--c-fg);
    }
    .bs-link:hover .bs-label {
      transform: translateX(3px);
    }

    .bs-link.is-active {
      color: var(--c-fg);
      font-weight: 600;
    }
    .bs-link.is-active .bs-label {
      transform: translateX(6px);
    }

    .side-bottom {
      display: grid;
      gap: 10px;
      width: 100%;
    }

    .scroll-tuner {
      display: grid;
      gap: 6px;
      width: 100%;
      padding: 8px;
      border-radius: 12px;
      background: color-mix(in srgb, var(--c-fg) 4%, var(--c-bg-raised));
      border: 1px solid var(--c-line);
      user-select: none;
    }
    :global(html.ve-active) .scroll-tuner {
      display: none;
    }
    .st-row-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding-inline: 2px;
    }
    .st-label {
      color: var(--c-muted);
      font: 400 10.5px / 1 var(--f-nav);
      letter-spacing: 0.02em;
    }
    .st-group {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2px;
      padding: 2px;
      border-radius: 8px;
      background: color-mix(in srgb, var(--c-fg) 5%, transparent);
    }
    .st-btn,
    .st-snap {
      border: 0;
      border-radius: 6px;
      padding: 5px 2px;
      background: transparent;
      color: var(--c-muted);
      font: 400 10.5px / 1 var(--f-nav);
      text-align: center;
      cursor: pointer;
      transition: background-color 0.16s ease, color 0.16s ease;
    }
    .st-btn:hover,
    .st-snap:hover {
      color: var(--c-fg);
    }
    .st-btn.is-active {
      background: var(--c-accent);
      color: #ffffff;
    }
    .st-snap {
      padding: 3px 7px;
      border-radius: 999px;
      font-size: 10px;
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
      color: var(--c-muted);
    }
    .st-snap.is-on {
      background: var(--c-fg);
      color: var(--c-bg);
    }

    .side-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2px;
      padding-top: 8px;
      border-top: 1px solid var(--c-line);
    }
    .ico-btn {
      display: inline-grid;
      place-items: center;
      width: 32px;
      height: 36px;
      border-radius: 8px;
      color: var(--c-muted);
      text-decoration: none;
      transition: color 0.18s ease, background-color 0.18s ease;
    }
    .ico-btn:hover {
      color: var(--c-fg);
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-nav,
    .bs-label {
      transition: none;
    }
  }
</style>
