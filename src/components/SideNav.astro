---
// Desktop left sidebar navigation (>= 1200px) with RareUI Hook Sidebar
// (https://www.rareui.com/components/hooksidebar) matching the #project-<slug> reader.
// Indents the 7 project names inward beneath the PROJECTS heading so top-level
// sections and nested project items have clear visual hierarchy.
import { projects } from '../data/projects';
import { contact, profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<aside class="side-nav" data-side-nav aria-label="Section navigation" inert>
  <div class="side-head">
    <div class="side-top-row">
      <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
      <LangToggle variant="compact" />
    </div>
    <p class="role">{profile.role}</p>
  </div>

  <nav class="side-scroll" aria-label="Sections & Projects">
    <div class="sn-hook-list" data-main-hook-sidebar>
      <!-- Hover preview dashed L-hook -->
      <span class="sn-hook-rail is-hover" data-hook-rail="hover" aria-hidden="true">
        <span class="sn-hook-stem" data-hook-stem></span>
        <svg width="28" height="7" viewBox="0 0 28 7" fill="none" class="sn-hook-corner" data-hook-corner>
          <path data-hook-path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
        </svg>
      </span>

      <!-- Active accent red dashed L-hook -->
      <span class="sn-hook-rail is-accent" data-hook-rail="active" aria-hidden="true">
        <span class="sn-hook-stem" data-hook-stem></span>
        <svg width="28" height="7" viewBox="0 0 28 7" fill="none" class="sn-hook-corner" data-hook-corner>
          <path data-hook-path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
        </svg>
      </span>

      <a class="sn-hook-item is-top" href="#top" data-hook-item data-hook-id="top" data-depth="0">
        Intro
      </a>

      <span class="sn-hook-heading" aria-hidden="true">Projects</span>

      {
        projects.map((p) => (
          <a
            class="sn-hook-item is-child"
            href={`#${p.slug}`}
            data-hook-item
            data-hook-id={p.slug}
            data-depth="1"
          >
            {p.spine.label}
          </a>
        ))
      }

      <span class="sn-hook-heading" aria-hidden="true">Profile</span>

      <a class="sn-hook-item is-top" href="#about" data-hook-item data-hook-id="about" data-depth="0">
        About
      </a>
      <a class="sn-hook-item is-top" href="#experience" data-hook-item data-hook-id="experience" data-depth="0">
        Experience
      </a>
      <a class="sn-hook-item is-top" href="#contact" data-hook-item data-hook-id="contact" data-depth="0">
        Contact
      </a>
    </div>
  </nav>

  <div class="side-bottom">
    <div class="scroll-tuner" data-scroll-tuner aria-label="Scroll feel presets">
      <div class="st-row-top">
        <span class="st-label">Scroll Weight</span>
        <button type="button" class="st-snap is-on" data-snap-toggle title="Toggle magnetic snap on project heads">
          Magnet: ON
        </button>
      </div>
      <div class="st-group" role="group" aria-label="Inertia level">
        <button type="button" class="st-btn" data-preset="light" title="Light inertia (lerp 0.14)">Light</button>
        <button type="button" class="st-btn is-active" data-preset="studio" title="Studio / Worachet feel (lerp 0.085, weight 0.85)">Studio</button>
        <button type="button" class="st-btn" data-preset="heavy" title="Heavy editorial inertia (lerp 0.055, weight 0.75)">Heavy</button>
        <button type="button" class="st-btn" data-preset="off" title="Native browser scroll">Off</button>
      </div>
    </div>

    <div class="side-foot">
      <a class="ico-btn" href={`mailto:${contact.email}`} aria-label="Send email" title={`Email (${contact.email})`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.linkedin.href} rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
          <path d="M8 11v5M8 8.2v.01M12 16v-5m0 1.8a2.5 2.5 0 0 1 4 2V16"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.behance.href} rel="noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 7.5h4.2a2.1 2.1 0 0 1 0 4.2H3.5zm0 4.2h4.6a2.3 2.3 0 0 1 0 4.6H3.5z"></path>
          <path d="M14.5 9.2h4.2M13.5 14h6.8a3.4 3.4 0 1 0-1.1 2.4"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.github.href} rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.5 1.4-4.5-2.3-6.3-2.8m12.6 5.6v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.6 0C6.1 1.8 5 2.2 5 2.2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.5 9.3c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4v3.5"></path>
        </svg>
      </a>

      <ThemeToggle compact />
    </div>
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-side-nav]');
  if (side) {
    const hero = document.querySelector('.hero');
    const desktopMq = window.matchMedia('(min-width: 1200px)');
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Contextual show/hide: hidden over Hero, visible across Projects, About, Experience & Contact
    let pastHero = !hero;
    const syncVisibility = () => {
      const show = desktopMq.matches && pastHero;
      side.classList.toggle('is-visible', show);
      side.inert = !show;
    };

    if (hero) {
      new IntersectionObserver(
        ([e]) => {
          pastHero = !e.isIntersecting;
          syncVisibility();
        },
        { threshold: 0.12 },
      ).observe(hero);
    }
    desktopMq.addEventListener('change', syncVisibility);
    syncVisibility();

    // RareUI Hook Sidebar spring controller (matching #project-<slug> reader)
    const hookRoot = side.querySelector<HTMLElement>('[data-main-hook-sidebar]');
    if (hookRoot) {
      const hookItems = [...hookRoot.querySelectorAll<HTMLAnchorElement>('[data-hook-item]')];
      const hoverRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="hover"]');
      const activeRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="active"]');
      const hStem = hoverRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const hCorner = hoverRail?.querySelector<SVGElement>('[data-hook-corner]');
      const hPath = hoverRail?.querySelector<SVGPathElement>('[data-hook-path]');
      const aStem = activeRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const aCorner = activeRail?.querySelector<SVGElement>('[data-hook-corner]');
      const aPath = activeRail?.querySelector<SVGPathElement>('[data-hook-path]');

      if (hookItems.length && hoverRail && activeRail && hStem && hCorner && hPath && aStem && aCorner && aPath) {
        const CORNER = 6;
        const targets = hookItems.map((el) => {
          const id = el.dataset.hookId ?? '';
          return id ? document.getElementById(id) : null;
        });

        let activeIdx = 0;
        let pinnedIdx: number | null = null;
        let userScrolled = false;
        let hoverIdx: number | null = null;
        let pointerInside = false;
        let focusInside = false;
        let placed = false;

        const aTop = { val: 0, vel: 0, target: 0 };
        const aY = { val: 0, vel: 0, target: 0 };
        const aReach = { val: 12, vel: 0, target: 12 };
        const hTop = { val: 0, vel: 0, target: 0 };
        const hY = { val: 0, vel: 0, target: 0 };
        const hReach = { val: 12, vel: 0, target: 12 };
        let rafId = 0;
        let lastTs = 0;

        const stepSpring = (s: { val: number; vel: number; target: number }, dt: number, stiffness: number, damping: number) => {
          const force = -stiffness * (s.val - s.target) - damping * s.vel;
          s.vel += force * dt;
          s.val += s.vel * dt;
          if (Math.abs(s.val - s.target) < 0.08 && Math.abs(s.vel) < 0.25) {
            s.val = s.target;
            s.vel = 0;
            return false;
          }
          return true;
        };

        const renderRail = (
          stem: HTMLElement,
          corner: SVGElement,
          pathEl: SVGPathElement,
          top: number,
          y: number,
          reach: number,
        ) => {
          const stemH = Math.max(0, y - CORNER - top);
          stem.style.transform = `translate3d(0, ${top.toFixed(2)}px, 0)`;
          stem.style.height = `${stemH.toFixed(2)}px`;
          corner.style.transform = `translate3d(0, ${(y - CORNER).toFixed(2)}px, 0)`;
          pathEl.setAttribute('d', `M0.5 0a6 6 0 0 0 6 6H${Math.max(8, reach).toFixed(1)}`);
        };

        const renderAll = () => {
          renderRail(aStem, aCorner, aPath, aTop.val, aY.val, aReach.val);
          renderRail(hStem, hCorner, hPath, hTop.val, hY.val, hReach.val);
        };

        const tick = (now: number) => {
          const dt = Math.min(0.032, Math.max(0.004, (now - lastTs) / 1000));
          lastTs = now;
          let moving = false;
          if (reduceMq.matches) {
            aTop.val = aTop.target;
            aY.val = aY.target;
            aReach.val = aReach.target;
            hTop.val = hTop.target;
            hY.val = hY.target;
            hReach.val = hReach.target;
          } else {
            moving = stepSpring(aTop, dt, 340, 32) || moving;
            moving = stepSpring(aY, dt, 340, 32) || moving;
            moving = stepSpring(aReach, dt, 380, 30) || moving;
            moving = stepSpring(hTop, dt, 420, 36) || moving;
            moving = stepSpring(hY, dt, 420, 36) || moving;
            moving = stepSpring(hReach, dt, 420, 34) || moving;
          }
          renderAll();
          if (moving) rafId = requestAnimationFrame(tick);
          else rafId = 0;
        };

        const schedule = () => {
          if (!rafId) {
            lastTs = performance.now();
            rafId = requestAnimationFrame(tick);
          }
        };

        const reachFor = (idx: number) => (hookItems[idx]?.dataset.depth === '1' ? 24 : 11);

        const syncRails = () => {
          const rootRect = hookRoot.getBoundingClientRect();
          if (rootRect.height <= 0) return;
          const centers = hookItems.map((el) => {
            const r = el.getBoundingClientRect();
            return r.top - rootRect.top + r.height / 2;
          });

          const activeCenter = centers[activeIdx] ?? null;
          const hoverCenter = hoverIdx !== null ? (centers[hoverIdx] ?? null) : null;

          activeRail.classList.toggle('is-visible', activeCenter !== null);
          if (activeCenter !== null) {
            aTop.target = 0;
            aY.target = activeCenter;
            aReach.target = reachFor(activeIdx);
            if (!placed && activeCenter > 0) {
              placed = true;
              aTop.val = 0;
              aY.val = activeCenter;
              aReach.val = aReach.target;
            }
          }

          const showHover =
            (pointerInside || focusInside) &&
            hoverIdx !== null &&
            hoverIdx !== activeIdx &&
            hoverCenter !== null;
          hoverRail.classList.toggle('is-visible', showHover);
          if (hoverCenter !== null && hoverIdx !== null) {
            const from =
              activeCenter !== null && hoverCenter <= activeCenter
                ? Math.max(0, hoverCenter - CORNER)
                : (activeCenter ?? 0);
            if (!hoverRail.classList.contains('is-ready')) {
              hoverRail.classList.add('is-ready');
              hTop.val = from;
              hY.val = hoverCenter;
              hReach.val = reachFor(hoverIdx);
            }
            hTop.target = from;
            hY.target = hoverCenter;
            hReach.target = reachFor(hoverIdx);
          }

          renderAll();
          schedule();
        };

        const setActive = (idx: number) => {
          const clamped = Math.max(0, Math.min(hookItems.length - 1, idx));
          activeIdx = clamped;
          hookItems.forEach((el, i) => {
            const hit = i === activeIdx;
            el.classList.toggle('is-active', hit);
            if (hit) el.setAttribute('aria-current', 'location');
            else el.removeAttribute('aria-current');
          });
          syncRails();
        };

        const detectFromScroll = () => {
          if (pinnedIdx !== null && !userScrolled) {
            setActive(pinnedIdx);
            return;
          }
          pinnedIdx = null;

          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 40) {
            setActive(hookItems.length - 1);
            return;
          }

          const anchorY = window.innerHeight * 0.34;
          let best = 0;
          targets.forEach((el, i) => {
            if (!el) return;
            if (el.getBoundingClientRect().top <= anchorY) best = i;
          });
          setActive(best);
        };

        hookItems.forEach((item, idx) => {
          item.addEventListener('click', () => {
            pinnedIdx = idx;
            userScrolled = false;
            setActive(idx);
          });
          item.addEventListener('pointerenter', () => {
            hoverIdx = idx;
            pointerInside = true;
            syncRails();
          });
          item.addEventListener('focus', () => {
            hoverIdx = idx;
            focusInside = true;
            syncRails();
          });
          item.addEventListener('blur', () => {
            focusInside = false;
            syncRails();
          });
        });

        hookRoot.addEventListener('pointerleave', () => {
          pointerInside = false;
          syncRails();
        });

        const onIntent = (e: Event) => {
          if (e.type === 'pointerdown' && e.target instanceof Element && e.target.closest('[data-main-hook-sidebar]')) {
            return;
          }
          userScrolled = true;
        };

        window.addEventListener('scroll', detectFromScroll, { passive: true });
        window.addEventListener('wheel', onIntent, { passive: true });
        window.addEventListener('touchstart', onIntent, { passive: true });
        window.addEventListener('pointerdown', onIntent);
        window.addEventListener('keydown', onIntent);
        window.addEventListener('resize', syncRails);

        new ResizeObserver(syncRails).observe(hookRoot);
        document.fonts?.ready.then(syncRails).catch(() => {});
        detectFromScroll();
      }
    }
  }
</script>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 45;
      width: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      padding: 36px 24px 24px 28px;
      background: color-mix(in srgb, var(--c-bg) 96%, transparent);
      border-right: 1px solid var(--c-line);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: translateX(-104%);
      transition:
        transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
        background-color 0.3s ease;
    }
    .side-nav.is-visible {
      transform: translateX(0);
    }

    .side-head {
      padding-left: 2px;
    }
    .side-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .brand {
      display: inline-block;
      font-family: var(--f-display);
      font-size: 1.45rem;
      line-height: 1;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--c-fg);
    }
    .role {
      margin-top: 6px;
      font-family: var(--f-nav);
      font-size: 0.75rem;
      font-weight: 400;
      color: var(--c-muted);
      line-height: 1.3;
    }

    .side-scroll {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block: 6px;
    }

    /* ================= RAREUI HOOK SIDEBAR (with nested project indent) ================= */
    .sn-hook-list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: auto 0;
    }

    .sn-hook-rail {
      pointer-events: none;
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .sn-hook-rail.is-visible {
      opacity: 1;
    }
    .sn-hook-rail.is-hover {
      color: color-mix(in srgb, var(--c-fg) 30%, transparent);
    }
    .sn-hook-rail.is-accent {
      color: var(--c-accent);
    }

    .sn-hook-stem {
      position: absolute;
      left: 2px;
      top: 0;
      width: 1px;
      background-image: repeating-linear-gradient(
        to top,
        transparent 0 2px,
        currentColor 2px 4px
      );
    }
    .sn-hook-corner {
      position: absolute;
      left: 2px;
      top: 0;
      overflow: visible;
    }

    .sn-hook-heading {
      margin-top: 12px;
      margin-bottom: 3px;
      padding-left: 18px;
      font-family: var(--f-clash);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--c-muted);
      opacity: 0.7;
      user-select: none;
    }

    .sn-hook-item {
      position: relative;
      display: block;
      padding-block: 4.5px;
      padding-right: 6px;
      text-decoration: none;
      font-family: var(--f-nav);
      font-weight: 500;
      line-height: 1.3;
      color: var(--c-muted);
      transition: color 0.16s ease;
    }
    .sn-hook-item.is-top {
      padding-left: 18px;
      font-size: 13.5px;
    }
    .sn-hook-item.is-child {
      padding-left: 32px;
      font-size: 13px;
    }

    .sn-hook-item:hover {
      color: var(--c-fg);
    }
    .sn-hook-item.is-active {
      color: var(--c-fg);
      font-weight: 600;
    }

    .side-bottom {
      display: grid;
      gap: 10px;
      width: 100%;
    }

    .scroll-tuner {
      display: grid;
      gap: 6px;
      width: 100%;
      padding: 8px;
      border-radius: 12px;
      background: color-mix(in srgb, var(--c-fg) 4%, var(--c-bg-raised));
      border: 1px solid var(--c-line);
      user-select: none;
    }
    :global(html.ve-active) .scroll-tuner {
      display: none;
    }
    .st-row-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding-inline: 2px;
    }
    .st-label {
      color: var(--c-muted);
      font: 400 10.5px / 1 var(--f-nav);
      letter-spacing: 0.02em;
    }
    .st-group {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2px;
      padding: 2px;
      border-radius: 8px;
      background: color-mix(in srgb, var(--c-fg) 5%, transparent);
    }
    .st-btn,
    .st-snap {
      border: 0;
      border-radius: 6px;
      padding: 5px 2px;
      background: transparent;
      color: var(--c-muted);
      font: 400 10.5px / 1 var(--f-nav);
      text-align: center;
      cursor: pointer;
      transition: background-color 0.16s ease, color 0.16s ease;
    }
    .st-btn:hover,
    .st-snap:hover {
      color: var(--c-fg);
    }
    .st-btn.is-active {
      background: var(--c-accent);
      color: #ffffff;
    }
    .st-snap {
      padding: 3px 7px;
      border-radius: 999px;
      font-size: 10px;
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
      color: var(--c-muted);
    }
    .st-snap.is-on {
      background: var(--c-fg);
      color: var(--c-bg);
    }

    .side-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2px;
      padding-top: 8px;
      border-top: 1px solid var(--c-line);
    }
    .ico-btn {
      display: inline-grid;
      place-items: center;
      width: 32px;
      height: 36px;
      border-radius: 8px;
      color: var(--c-muted);
      text-decoration: none;
      transition: color 0.18s ease, background-color 0.18s ease;
    }
    .ico-btn:hover {
      color: var(--c-fg);
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-nav {
      transition: none;
    }
  }
</style>
