---
// Desktop left sidebar navigation (>= 1200px). Slides in once the visitor
// scrolls past Hero and hides over the red Contact section. Clean, monochrome,
// and borderless with typography-only scrollspy + quick action icons.
import { projects } from '../data/projects';
import { contact, profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<aside class="side-nav" data-side-nav aria-label="Section navigation" inert>
  <div class="side-head">
    <div class="side-top-row">
      <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
      <LangToggle variant="compact" />
    </div>
    <p class="role">{profile.role}</p>
  </div>

  <nav class="side-scroll" data-rail-toc aria-label="Sections & Projects">
    <ul class="rail-list" role="list">
      <svg class="rail-svg" aria-hidden="true">
        <defs>
          <linearGradient id="pun-rail-fade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="24">
            <stop offset="0" stop-color="black" />
            <stop offset="1" stop-color="white" />
          </linearGradient>
          <mask id="pun-rail-mask" maskUnits="userSpaceOnUse" x="-12" y="-12" width="240" height="800">
            <rect class="rail-mask-bg" x="-12" y="-12" width="240" height="800" fill="url(#pun-rail-fade)" />
            <g class="rail-mask-holes"></g>
            <circle class="rail-plane-hole" cx="-40" cy="-40" r="4.5" fill="black" />
          </mask>
          <mask id="pun-nodes-mask" maskUnits="userSpaceOnUse" x="-12" y="-12" width="240" height="800">
            <rect class="nodes-mask-bg" x="-12" y="-12" width="240" height="800" fill="white" />
            <circle class="rail-plane-hole-nodes" cx="-40" cy="-40" r="5" fill="black" />
          </mask>
        </defs>
        <g mask="url(#pun-rail-mask)">
          <path class="rail-path-dashed" d="" />
          <path class="rail-path-solid" d="" />
        </g>
        <g class="rail-nodes" mask="url(#pun-nodes-mask)"></g>
      </svg>

      <div class="rail-plane" data-rail-plane aria-hidden="true">
        <svg viewBox="0 0 24 24" class="rail-plane-svg">
          <path d="M12 2 20.5 21 12 17.5 3.5 21z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
      </div>

      <li class="rail-item" data-rail-id="top" data-rail-depth="0">
        <a class="rail-link" href="#top"><span class="rail-label">Intro</span></a>
      </li>
      <li class="rail-item" data-rail-id="work" data-rail-depth="0">
        <a class="rail-link" href="#work"><span class="rail-label">Projects</span></a>
      </li>
      {
        projects.map((p) => (
          <li class="rail-item" data-rail-id={p.slug} data-rail-depth="1">
            <a class="rail-link" href={`#${p.slug}`}>
              <span class="rail-label">{p.spine.label}</span>
            </a>
          </li>
        ))
      }
      <li class="rail-item" data-rail-id="about" data-rail-depth="0">
        <a class="rail-link" href="#about"><span class="rail-label">About</span></a>
      </li>
      <li class="rail-item" data-rail-id="experience" data-rail-depth="0">
        <a class="rail-link" href="#experience"><span class="rail-label">Experience</span></a>
      </li>
      <li class="rail-item" data-rail-id="contact" data-rail-depth="0">
        <a class="rail-link" href="#contact"><span class="rail-label">Contact</span></a>
      </li>
    </ul>
  </nav>

  <div class="side-bottom">
    <div class="scroll-tuner" data-scroll-tuner aria-label="Scroll feel presets">
      <div class="st-row-top">
        <span class="st-label">Scroll Weight</span>
        <button type="button" class="st-snap is-on" data-snap-toggle title="Toggle magnetic snap on project heads">
          Magnet: ON
        </button>
      </div>
      <div class="st-group" role="group" aria-label="Inertia level">
        <button type="button" class="st-btn" data-preset="light" title="Light inertia (lerp 0.14)">Light</button>
        <button type="button" class="st-btn is-active" data-preset="studio" title="Studio / Worachet feel (lerp 0.085, weight 0.85)">Studio</button>
        <button type="button" class="st-btn" data-preset="heavy" title="Heavy editorial inertia (lerp 0.055, weight 0.75)">Heavy</button>
        <button type="button" class="st-btn" data-preset="off" title="Native browser scroll">Off</button>
      </div>
    </div>

    <div class="side-foot">
      <a class="ico-btn" href={`mailto:${contact.email}`} aria-label="Send email" title={`Email (${contact.email})`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.linkedin.href} rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3.5"></rect>
          <path d="M8 11v5M8 8.2v.01M12 16v-5m0 1.8a2.5 2.5 0 0 1 4 2V16"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.behance.href} rel="noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 7.5h4.2a2.1 2.1 0 0 1 0 4.2H3.5zm0 4.2h4.6a2.3 2.3 0 0 1 0 4.6H3.5z"></path>
          <path d="M14.5 9.2h4.2M13.5 14h6.8a3.4 3.4 0 1 0-1.1 2.4"></path>
        </svg>
      </a>

      <a class="ico-btn" href={contact.github.href} rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.5 1.4-4.5-2.3-6.3-2.8m12.6 5.6v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.6 0C6.1 1.8 5 2.2 5 2.2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.5 9.3c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4v3.5"></path>
        </svg>
      </a>

      <ThemeToggle compact />
    </div>
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-side-nav]');
  if (side) {
    const hero = document.querySelector('.hero');
    const contactEl = document.querySelector('#contact');
    const desktopMq = window.matchMedia('(min-width: 1200px)');

    // Contextual show/hide: hidden over Hero and Contact, active in between on desktop
    let pastHero = !hero;
    let atContact = false;
    const syncVisibility = () => {
      const show = desktopMq.matches && pastHero && !atContact;
      side.classList.toggle('is-visible', show);
      side.inert = !show;
    };

    if (hero) {
      new IntersectionObserver(([e]) => {
        pastHero = !e.isIntersecting;
        syncVisibility();
      }, { threshold: 0.12 }).observe(hero);
    }
    if (contactEl) {
      new IntersectionObserver(([e]) => {
        atContact = e.isIntersecting;
        syncVisibility();
      }, { rootMargin: '0px 0px -35% 0px' }).observe(contactEl);
    }
    desktopMq.addEventListener('change', syncVisibility);
    syncVisibility();

    // RareUI-inspired Rail TOC with damped harmonic plane & continuous scroll progress
    const tocNav = side.querySelector<HTMLElement>('[data-rail-toc]');
    const list = tocNav?.querySelector<HTMLUListElement>('.rail-list');
    const svg = list?.querySelector<SVGSVGElement>('.rail-svg');
    const dashedPath = svg?.querySelector<SVGPathElement>('.rail-path-dashed');
    const solidPath = svg?.querySelector<SVGPathElement>('.rail-path-solid');
    const nodesGroup = svg?.querySelector<SVGGElement>('.rail-nodes');
    const holesGroup = svg?.querySelector<SVGGElement>('.rail-mask-holes');
    const fadeGrad = svg?.querySelector<SVGLinearGradientElement>('#pun-rail-fade');
    const planeEl = list?.querySelector<HTMLElement>('[data-rail-plane]');
    const holePlane1 = svg?.querySelector<SVGCircleElement>('.rail-plane-hole');
    const holePlane2 = svg?.querySelector<SVGCircleElement>('.rail-plane-hole-nodes');

    if (
      tocNav &&
      list &&
      svg &&
      dashedPath &&
      solidPath &&
      nodesGroup &&
      holesGroup &&
      fadeGrad &&
      planeEl &&
      holePlane1 &&
      holePlane2
    ) {
      const SVG_NS = 'http://www.w3.org/2000/svg';
      const RAIL_X = 8;
      const INDENT = 12;
      const OFFSET = 96;
      const TURN_SLACK = 2;

      const rows = [...list.querySelectorAll<HTMLLIElement>('.rail-item')];
      const items = rows.map((row) => ({
        id: row.dataset.railId || '',
        depth: Number(row.dataset.railDepth || 0),
        row,
        link: row.querySelector<HTMLAnchorElement>('.rail-link')!,
      }));

      const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
      let nodePts: { x: number; y: number }[] = [];
      let nodeLengths: number[] = [];
      let nodeCircles: SVGCircleElement[] = [];
      let totalLen = 0;

      let placed = false;
      let pinned: number | null = null;
      let userScrolled = false;
      let facing: 1 | -1 = 1;
      let turnFrom = 0;
      let activeIdx = 0;
      let lastReached = -1;

      const travel = { val: 0, vel: 0, target: 0, stiffness: 140, damping: 26, mass: 0.6 };
      const turn = { val: 180, vel: 0, target: 180, stiffness: 260, damping: 30, mass: 1.0 };
      let rafId = 0;
      let lastTs = 0;

      function buildPath(pts: { x: number; y: number }[]): string {
        if (!pts.length) return '';
        const out: { x: number; y: number }[] = [{ x: pts[0].x, y: 0 }, pts[0]];
        for (let i = 1; i < pts.length; i++) {
          const from = pts[i - 1];
          const to = pts[i];
          if (from.x !== to.x) {
            const bend = (to.y - from.y) * 0.3;
            out.push({ x: from.x, y: from.y + bend }, { x: to.x, y: to.y - bend });
          }
          out.push(to);
        }
        return out.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
      }

      function lengthAtY(path: SVGPathElement, maxL: number, y: number): number {
        let lo = 0;
        let hi = maxL;
        for (let i = 0; i < 24; i++) {
          const mid = (lo + hi) * 0.5;
          if (path.getPointAtLength(mid).y < y) lo = mid;
          else hi = mid;
        }
        return hi;
      }

      function stepSpring(s: typeof travel, dtSec: number): boolean {
        const steps = Math.max(1, Math.ceil(dtSec / 0.004));
        const h = dtSec / steps;
        for (let i = 0; i < steps; i++) {
          const force = -s.stiffness * (s.val - s.target) - s.damping * s.vel;
          s.vel += (force / s.mass) * h;
          s.val += s.vel * h;
        }
        if (Math.abs(s.target - s.val) < 0.08 && Math.abs(s.vel) < 0.08) {
          s.val = s.target;
          s.vel = 0;
          return false;
        }
        return true;
      }

      function applyPose(l: number, deg: number) {
        if (!totalLen) return;
        const clamped = Math.max(0, Math.min(totalLen, l));
        const at = dashedPath!.getPointAtLength(clamped);

        solidPath!.style.strokeDasharray = `${totalLen} ${totalLen}`;
        solidPath!.style.strokeDashoffset = `${Math.max(0, totalLen - clamped)}`;

        holePlane1!.setAttribute('cx', at.x.toFixed(2));
        holePlane1!.setAttribute('cy', at.y.toFixed(2));
        holePlane2!.setAttribute('cx', at.x.toFixed(2));
        holePlane2!.setAttribute('cy', at.y.toFixed(2));

        planeEl!.style.transform = `translate3d(${at.x.toFixed(2)}px, ${at.y.toFixed(2)}px, 0) rotate(${deg.toFixed(2)}deg)`;

        const reached = nodeLengths.filter((nl) => nl <= clamped + 0.5).length;
        if (reached !== lastReached) {
          lastReached = reached;
          activeIdx = Math.max(0, reached - 1);
          for (let i = 0; i < nodeCircles.length; i++) {
            const covered = i < reached;
            const c = nodeCircles[i];
            c.setAttribute('r', covered ? '3' : '3.25');
            c.classList.toggle('is-covered', covered);
          }
          for (let i = 0; i < items.length; i++) {
            const isAct = i === activeIdx;
            const isPassed = i < reached;
            items[i].link.classList.toggle('is-active', isAct);
            items[i].link.classList.toggle('is-passed', isPassed && !isAct);
            if (isAct) items[i].link.setAttribute('aria-current', 'location');
            else items[i].link.removeAttribute('aria-current');
          }
        }
      }

      function computeHeadingAt(l: number): number {
        const c = Math.max(0, Math.min(totalLen, l));
        const behind = dashedPath!.getPointAtLength(Math.max(0, c - 1));
        const ahead = dashedPath!.getPointAtLength(Math.min(totalLen, c + 1));
        const angle = (Math.atan2(ahead.y - behind.y, ahead.x - behind.x) * 180) / Math.PI + 90 + (facing < 0 ? 180 : 0);
        return angle + 360 * Math.round((turn.target - angle) / 360);
      }

      function startAnimLoop() {
        if (!rafId) {
          lastTs = 0;
          rafId = requestAnimationFrame(animTick);
        }
      }

      function animTick(ts: number) {
        const dt = lastTs ? Math.min(0.04, (ts - lastTs) * 0.001) : 1 / 60;
        lastTs = ts;

        if (reduceMq.matches) {
          travel.val = travel.target;
          travel.vel = 0;
          turn.target = computeHeadingAt(travel.val);
          turn.val = turn.target;
          turn.vel = 0;
          applyPose(travel.val, turn.val);
          rafId = 0;
          lastTs = 0;
          return;
        }

        const moving = stepSpring(travel, dt);
        turn.target = computeHeadingAt(travel.val);
        const turning = stepSpring(turn, dt);
        applyPose(travel.val, turn.val);

        if (moving || turning) {
          rafId = requestAnimationFrame(animTick);
        } else {
          rafId = 0;
          lastTs = 0;
        }
      }

      function aim(next: number) {
        const from = turnFrom;
        if ((next - from) * facing > 0) {
          turnFrom = next;
        } else if (Math.abs(next - from) > TURN_SLACK) {
          facing = facing > 0 ? -1 : 1;
          turnFrom = next;
        }
        travel.target = next;
        startAnimLoop();
      }

      function sync() {
        if (!nodeLengths.length) return;
        if (pinned !== null) {
          aim(nodeLengths[pinned] ?? nodeLengths[0]);
          return;
        }

        const scrollTop = window.scrollY;
        const viewH = window.innerHeight;
        const scrollH = document.documentElement.scrollHeight;
        const remaining = Math.max(0, scrollH - viewH - scrollTop);
        const line = Math.min(OFFSET, scrollTop);
        const anchor = line + Math.max(0, viewH - line - remaining);

        const tops = items.map((item) => {
          const el = document.getElementById(item.id);
          return el ? el.getBoundingClientRect().top : Infinity;
        });

        let index = -1;
        for (let i = tops.length - 1; i >= 0; i--) {
          if (tops[i] <= anchor) {
            index = i;
            break;
          }
        }

        let next = nodeLengths[0];
        if (index === -1) next = nodeLengths[0];
        else if (index === nodeLengths.length - 1) next = nodeLengths[index];
        else {
          const span = tops[index + 1] - tops[index];
          const progress = span > 0 ? (anchor - tops[index]) / span : 0;
          next = nodeLengths[index] + Math.min(1, Math.max(0, progress)) * (nodeLengths[index + 1] - nodeLengths[index]);
        }

        aim(next);
        if (!placed) {
          placed = true;
          travel.val = next;
          travel.vel = 0;
          turn.target = computeHeadingAt(next);
          turn.val = turn.target;
          turn.vel = 0;
          applyPose(next, turn.val);
        }
      }

      function measure() {
        const h = list!.offsetHeight;
        if (!h) return;

        nodePts = items.map((item) => ({
          x: RAIL_X + item.depth * INDENT,
          y: item.row.offsetTop + item.row.offsetHeight * 0.5,
        }));

        const w = Math.max(...nodePts.map((n) => n.x)) + RAIL_X + 6;
        svg!.setAttribute('width', `${w}`);
        svg!.setAttribute('height', `${h}`);
        svg!.setAttribute('viewBox', `0 0 ${w} ${h}`);

        const m1 = svg!.querySelector('#pun-rail-mask');
        const m2 = svg!.querySelector('#pun-nodes-mask');
        [m1, m2].forEach((m) => {
          m?.setAttribute('width', `${w + 24}`);
          m?.setAttribute('height', `${h + 24}`);
        });
        svg!.querySelector('.rail-mask-bg')?.setAttribute('width', `${w + 24}`);
        svg!.querySelector('.rail-mask-bg')?.setAttribute('height', `${h + 24}`);
        svg!.querySelector('.nodes-mask-bg')?.setAttribute('width', `${w + 24}`);
        svg!.querySelector('.nodes-mask-bg')?.setAttribute('height', `${h + 24}`);
        fadeGrad!.setAttribute('y2', `${Math.max(4, nodePts[0].y - 4)}`);

        const d = buildPath(nodePts);
        dashedPath!.setAttribute('d', d);
        solidPath!.setAttribute('d', d);

        holesGroup!.innerHTML = '';
        nodesGroup!.innerHTML = '';
        nodeCircles = nodePts.map((pt) => {
          const hole = document.createElementNS(SVG_NS, 'circle');
          hole.setAttribute('cx', pt.x.toFixed(1));
          hole.setAttribute('cy', pt.y.toFixed(1));
          hole.setAttribute('r', '4');
          hole.setAttribute('fill', 'black');
          holesGroup!.appendChild(hole);

          const c = document.createElementNS(SVG_NS, 'circle');
          c.setAttribute('cx', pt.x.toFixed(1));
          c.setAttribute('cy', pt.y.toFixed(1));
          c.setAttribute('r', '3.25');
          c.setAttribute('stroke-width', '1.25');
          c.classList.add('rail-node');
          nodesGroup!.appendChild(c);
          return c;
        });

        totalLen = dashedPath!.getTotalLength();
        nodeLengths = nodePts.map((n) => lengthAtY(dashedPath!, totalLen, n.y));
        lastReached = -1;
        sync();
        applyPose(travel.val, turn.val);
      }

      items.forEach((item, idx) => {
        item.link.addEventListener('click', () => {
          pinned = idx;
          userScrolled = false;
          sync();
        });
      });

      const onIntent = (e: Event) => {
        if (e.type === 'pointerdown' && e.target instanceof Element && e.target.closest('[data-rail-toc]')) {
          return;
        }
        userScrolled = true;
      };
      const onScroll = () => {
        if (pinned !== null && userScrolled) pinned = null;
        sync();
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('wheel', onIntent, { passive: true });
      window.addEventListener('touchstart', onIntent, { passive: true });
      window.addEventListener('pointerdown', onIntent);
      window.addEventListener('keydown', onIntent);
      window.addEventListener('resize', measure);

      const ro = new ResizeObserver(measure);
      ro.observe(list);
      document.fonts?.ready.then(measure).catch(() => {});
      measure();
    }
  }
</script>

<style>
  .side-nav {
    display: none;
  }

  @media (min-width: 1200px) {
    .side-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 45;
      width: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      padding: 24px 12px 16px 16px;
      background: color-mix(in srgb, var(--c-bg) 94%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: translateX(-104%);
      transition:
        transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
        background-color 0.3s ease;
    }
    .side-nav.is-visible {
      transform: translateX(0);
    }

    .side-head {
      padding-left: 2px;
    }
    .side-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .brand {
      display: inline-block;
      font-family: var(--f-display);
      font-size: 1.45rem;
      line-height: 1;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--c-fg);
    }
    .role {
      margin-top: 6px;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--c-muted);
      line-height: 1.3;
    }

    .side-scroll {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block: 6px;
    }

    .rail-list {
      position: relative;
      display: grid;
      gap: 2px;
      margin: auto 0;
      padding: 0;
      list-style: none;
    }

    .rail-svg {
      position: absolute;
      left: 0;
      top: 0;
      pointer-events: none;
      overflow: visible;
    }

    .rail-path-dashed,
    .rail-path-solid {
      fill: none;
      stroke-width: 1.25;
      stroke-linejoin: round;
    }
    .rail-path-dashed {
      stroke-dasharray: 2 5;
      stroke-linecap: round;
      stroke: rgb(20 19 18 / 0.22);
    }
    :global(:root[data-theme='dark']) .rail-path-dashed {
      stroke: rgb(239 233 222 / 0.24);
    }
    .rail-path-solid {
      stroke: rgb(20 19 18 / 0.56);
    }
    :global(:root[data-theme='dark']) .rail-path-solid {
      stroke: rgb(239 233 222 / 0.54);
    }

    .rail-nodes :global(.rail-node) {
      fill: transparent;
      stroke: rgb(20 19 18 / 0.28);
      transition: fill 0.2s ease, stroke 0.2s ease;
    }
    :global(:root[data-theme='dark']) .rail-nodes :global(.rail-node) {
      stroke: rgb(239 233 222 / 0.3);
    }
    .rail-nodes :global(.rail-node.is-covered) {
      fill: rgb(20 19 18 / 0.68);
      stroke: rgb(20 19 18 / 0.68);
    }
    :global(:root[data-theme='dark']) .rail-nodes :global(.rail-node.is-covered) {
      fill: rgb(239 233 222 / 0.7);
      stroke: rgb(239 233 222 / 0.7);
    }

    .rail-plane {
      position: absolute;
      left: 0;
      top: 0;
      width: 15px;
      height: 15px;
      margin-left: -7.5px;
      margin-top: -7.5px;
      color: var(--c-accent);
      pointer-events: none;
