---
import { education, experience, profileTools, skills, tools } from '../data/site';
import FadeContent from './FadeContent.jsx';
---

<section class="exp" id="experience" aria-labelledby="exp-title">
  <div class="exp-shell">
    <FadeContent client:load effect="focus" duration={0.75} threshold={0.08} once={false} exit={true}>
      <header class="exp-head">
        <p class="exp-kicker">Profile</p>
        <h2 id="exp-title" class="exp-heading">Experience</h2>
      </header>
    </FadeContent>

    <FadeContent client:load effect="fade" blur={3} duration={0.75} threshold={0.06} once={false} exit={true}>
      <ol class="exp-list" role="list">
        {
          experience.map((job) => (
            <li class="exp-row">
              <div class="exp-meta">
                <span class="exp-period">{job.period}</span>
                <span class="exp-role">{job.title}</span>
              </div>
              <div class="exp-detail">
                <h3 class="exp-company">{job.company}</h3>
                <p class="exp-summary">
                  <span data-lang-text="en">{job.summary}</span>
                  <span data-lang-text="th">{job.summaryTh}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </FadeContent>

    <FadeContent client:load effect="fade" blur={3} delay={0.06} duration={0.75} threshold={0.08} once={false} exit={true}>
      <div class="exp-subgrid">
        <div class="exp-col">
          <h3 class="exp-subhead">Education</h3>
          <ol class="edu-list" role="list">
            {
              education.map((e) => (
                <li class="edu-item">
                  <span class="edu-period">{e.period}</span>
                  <h4 class="edu-school">{e.school}</h4>
                  <p class="edu-program">{e.program}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="exp-col exp-col-cap">
          <div class="cap-group">
            <h3 class="exp-subhead">Skills</h3>
            <ul class="cap-list" role="list" aria-label="Skills">
              {skills.map((s) => <li>{s}</li>)}
            </ul>
          </div>

          <div class="cap-group">
            <h3 class="exp-subhead">Tools &amp; Software</h3>
            <ul class="cap-list" role="list" aria-label="Software">
              {profileTools.map((id) => <li>{tools[id].name}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </FadeContent>
  </div>
</section>

<style>
  .exp {
    border-top: 1px solid var(--c-line);
    padding-block: clamp(88px, 10vw, 144px);
    padding-inline: clamp(20px, 5vw, 64px);
    scroll-margin-top: 40px;
  }

  .exp-shell {
    width: 100%;
    max-width: 1024px;
    margin-inline: auto;
  }

  .exp-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .exp-kicker {
    margin: 0;
    font-family: var(--f-heading);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .exp-heading {
    margin: 0;
    font-family: var(--f-heading);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.2vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--c-fg);
  }

  /* Clean Editorial Work History Rows */
  .exp-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }

  .exp-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px 32px;
    padding-block: clamp(28px, 3.2vw, 40px);
    border-bottom: 1px solid var(--c-line);
    align-items: baseline;
  }

  .exp-meta {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exp-period {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--c-muted);
  }

  .exp-role {
    font-family: var(--f-body);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--c-fg-soft);
  }

  .exp-detail {
    grid-column: 5 / span 8;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .exp-company {
    margin: 0;
    font-family: var(--f-heading);
    font-weight: 700;
    font-size: clamp(1.375rem, 2.1vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--c-fg);
  }

  .exp-summary {
    margin: 0;
    max-width: 58ch;
    font-family: var(--f-body);
    font-size: 15.5px;
    font-weight: 400;
    line-height: 1.68;
    color: var(--c-muted);
  }

  /* Lower Editorial Grid: Education + Skills & Tools */
  .exp-subgrid {
    margin-top: clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 32px;
    align-items: start;
  }

  .exp-col {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .exp-col-cap {
    grid-column: 7 / span 6;
    gap: 36px;
  }

  .exp-subhead {
    margin: 0;
    font-family: var(--f-heading);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .edu-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .edu-period {
    font-family: var(--f-body);
    font-size: 12.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--c-muted);
  }

  .edu-school {
    margin: 2px 0 0;
    font-family: var(--f-heading);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--c-fg);
  }

  .edu-program {
    margin: 0;
    font-family: var(--f-body);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--c-muted);
  }

  .cap-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cap-list {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }

  .cap-list li {
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    color: var(--c-fg-soft);
  }

  @media (max-width: 820px) {
    .exp-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .exp-meta,
    .exp-detail {
      grid-column: 1 / -1;
    }
    .exp-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 12px;
    }
    .exp-subgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .exp-col,
    .exp-col-cap {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .cap-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
