---
// Highlight showcase ("07 SYBIL HUSKY") + Full-Screen Editorial Case Study Reader (#read-sybil-husky)
// Option 3 integration with Punmetal/sybil-husky:
//   - Authentic 1920x1080 Day & Night world illustrations (interactive toggle)
//   - Real character portraits & NFT Mint Tier specs from src/data/content.ts
//   - Live interactive Next.js website embed (https://sybil-husky.vercel.app) scaled to 1920px desktop
//   - 864px media (+20% wider than the centered, left-aligned 720px text column)
import Picture from './Picture.astro';
import { assetUrl } from '../lib/media';
import { projects } from '../data/projects';
import { tools } from '../data/site';

const sybil = projects.find((p) => p.slug === 'sybil-husky')!;
const k2o = projects.find((p) => p.slug === 'k2o')!;
const logoMarkSrc = assetUrl('media/07-sybil-logo-mark.webp');
const LIVE_URL = 'https://sybil-husky.vercel.app';

const overviewText =
  'A fantasy-inspired visual identity, character collection, and Web3 airdrop farming landing page for Sybil Husky. Blending Arctic folklore with approachable product design, the project pairs minimal vector branding and six character tiers with a dual Day/Night Next.js web experience.';

const roleBullets = [
  'Visual identity, husky emblem mark, and overall art direction.',
  'Character illustrations across rarity tiers and Baby Husky editions.',
  'Dual Day (Sunrise) & Night (Aurora) Arctic citadel key artwork.',
  'Full 1920px landing page UI including Mint Tier & Airdrop Estimator flows.',
];

const challengeBullets = [
  'Turn complex crypto airdrop farming & rune-multiplier math into an approachable narrative.',
  'Design two complete world atmospheres (Day & Night) while keeping UI readability sharp.',
  'Maintain character silhouette consistency across six collectible rarity tiers.',
];

const mintTiers = [
  {
    badge: 'Tier 01 · Apprentice',
    title: 'Siberian Apprentice',
    img: assetUrl('media/07-sybil-char-apprentice.webp'),
    stats: '100 Runes · $100 · Base Tier',
  },
  {
    badge: 'Tier 02 · Mage',
    title: 'Siberian Mage',
    img: assetUrl('media/07-sybil-char-mage.webp'),
    stats: 'Bonus Frost Gear · Companion',
  },
  {
    badge: 'Tier 03 · Sorcerer',
    title: 'Siberian Sorcerer',
    img: assetUrl('media/07-sybil-char-sorcerer.webp'),
    stats: '660 Runes · $600 · +10% Bonus',
  },
  {
    badge: 'Tier 04 · Supreme',
    title: 'Siberian Supreme',
    img: assetUrl('media/07-sybil-char-supreme.webp'),
    stats: '1,820 Runes · $1,400 · +30% Bonus',
  },
  {
    badge: 'Edition · Baby 01',
    title: 'Baby Husky (Frost)',
    img: assetUrl('media/07-sybil-char-baby1.webp'),
    stats: 'Special Community Edition',
  },
  {
    badge: 'Edition · Baby 02',
    title: 'Baby Husky (Ember)',
    img: assetUrl('media/07-sybil-char-baby2.webp'),
    stats: 'Special Community Edition',
  },
];

const sections = [
  { id: 'cs-overview', label: 'Overview' },
  { id: 'cs-challenge', label: 'The challenge' },
  { id: 'cs-world', label: 'World & environment' },
  { id: 'cs-tiers', label: 'Character & NFT tiers' },
  { id: 'cs-landing', label: 'Live landing page' },
  { id: 'cs-outcome', label: 'Outcome' },
];
---

<article
  class="project sybil-highlight-test"
  id="sybil-husky-test"
  aria-labelledby="sybil-test-title"
>
  <div class="f428-canvas" data-ve-editorial="sybil-husky-test">
    <!-- Header (07 + SYBIL HUSKY) & Overview -->
    <header class="f131" data-ve-free="sybil-test:header" data-ve-label="07 Header & Overview">
      <div class="f130">
        <p class="f-no" data-reveal>07</p>
        <h3 id="sybil-test-title" class="f-title" data-reveal style="--reveal-d: 50ms">
          Sybil Husky
        </h3>
      </div>

      <div class="f71">
        <h4 class="f-overview-h" data-reveal style="--reveal-d: 100ms">Overview</h4>
        <p class="f-overview-p" data-reveal style="--reveal-d: 140ms">
          {overviewText}
        </p>
      </div>
    </header>

    <!-- Highlight Card (1080 x 576 with 60px margin on 1200px frame) -->
    <div
      class="f429"
      data-ve-free="sybil-test:hero-card"
      data-ve-label="07 Highlight Card"
      data-open-sybil-case
      role="button"
      tabindex="0"
      aria-label="Open Sybil Husky Full Case Study"
    >
      <img
        class="f-group354"
        src={logoMarkSrc}
        width="568"
        height="306"
        alt="Sybil Husky logo mark and wordmark"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Bottom Row: Full Case Study CTA + My Role + The Challenge -->
    <div class="f-bottom-row">
      <a
        href="#read-sybil-husky"
        class="f430-btn"
        data-open-sybil-case
        data-ve-free="sybil-test:cta"
        data-ve-label="07 Full Case Study Button"
      >
        <span>Full Case Study</span>
      </a>

      <div class="f72" data-ve-free="sybil-test:role" data-ve-label="07 My Role">
        <h4 class="f-col-h" data-reveal>My Role</h4>
        <ul class="f-col-list" data-reveal style="--reveal-d: 60ms">
          {roleBullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="f128" data-ve-free="sybil-test:problem" data-ve-label="07 The Challenge">
        <h4 class="f-col-h" data-reveal style="--reveal-d: 60ms">The Challenge</h4>
        <ul class="f-col-list" data-reveal style="--reveal-d: 120ms">
          {challengeBullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Full-Screen Editorial Case Study Reader (#read-sybil-husky) -->
  <dialog class="cs-reader" data-sybil-case-dialog aria-labelledby="cs-main-title">
    <div class="cs-layout">
      <!-- Left Sticky Navigation Sidebar -->
      <aside class="cs-sidebar" aria-label="Case study sections">
        <button type="button" class="cs-back" data-close-sybil-case>
          <span aria-hidden="true">←</span>
          <span>All work</span>
        </button>

        <div class="cs-toc-wrap">
          <p class="cs-proj-name">Sybil Husky</p>
          <nav aria-label="Table of contents">
            <ul class="cs-toc" role="list">
              {
                sections.map((s, idx) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class:list={['cs-toc-link', { 'is-active': idx === 0 }]}
                      data-cs-toc={s.id}
                    >
                      <span class="cs-toc-bar" aria-hidden="true" />
                      <span>{s.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="cs-side-foot">
          <a href={LIVE_URL} rel="noopener" target="_blank" class="cs-live-pill">
            <span>Visit live site</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a href="#k2o" class="cs-next" data-cs-next="#k2o">
            <span class="cs-next-lbl">Next project</span>
            <span class="cs-next-title">{k2o.spine.label} <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </aside>

      <!-- Right Scrollable Editorial Reading Column -->
      <div class="cs-scroller" data-cs-scroller>
        <div class="cs-article">
          <!-- Section 1: Overview -->
          <section id="cs-overview" class="cs-sec" data-cs-section>
            <div class="cs-hero-banner">
              <img
                src={logoMarkSrc}
                width="568"
                height="306"
                alt="Sybil Husky brand mark and wordmark"
                class="cs-hero-logo"
              />
            </div>

            <h1 id="cs-main-title" class="cs-h1">Sybil Husky</h1>
            <p class="cs-subtitle">
              A Web3 NFT collectible brand and airdrop farming platform built around Arctic folklore—spanning vector branding, tiered husky companions, dual Day/Night worlds, and a shipped Next.js website.
            </p>

            <dl class="cs-meta-grid">
              <div>
                <dt>Client</dt>
                <dd>SybilHusky Collective</dd>
              </div>
              <div>
                <dt>Stack &amp; Delivery</dt>
                <dd>Figma → Next.js 16 + React</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>Visual Identity, Character Design &amp; UI</dd>
              </div>
            </dl>

            <p class="cs-prose">
              In the wintry landscapes of the crypto world, SybilHusky reimagines cryptocurrency airdrop farming through loyal husky companions. Collectors mint tiered SybilHusky NFTs—unlocking higher rune multipliers and greater shares of farming rewards as their pack levels up.
            </p>
          </section>

          <!-- Section 2: The Challenge -->
          <section id="cs-challenge" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">The challenge</h2>
            <p class="cs-prose">
              DeFi and airdrop farming tools often intimidate newcomers with dense spreadsheets and generic dark dashboards. Meanwhile, many NFT projects rely on cluttered mascots that break down at small UI sizes.
            </p>
            <p class="cs-prose">
              The design challenge was twofold: craft an iconic, minimal husky emblem that scales cleanly from favicon to hero banner, and wrap real utility—<strong>Mint Tier selection</strong>, <strong>38-month Airdrop Estimator math</strong>, and <strong>FAQ onboarding</strong>—inside an inviting storybook world.
            </p>

            <div class="cs-callout-grid">
              <div class="cs-callout">
                <h3>01 · Approachable Web3 utility</h3>
                <p>Replaced abstract APY tables with interactive tier cards, rune counts, and a draggable duration slider showing exact reward projections.</p>
              </div>
              <div class="cs-callout">
                <h3>02 · Seamless Day &amp; Night worlds</h3>
                <p>Designed matching sunrise and aurora landscapes so switching Light/Dark theme transforms the entire Arctic scene, not just text colors.</p>
              </div>
            </div>
          </section>

          <!-- Section 3: World & Environment (Interactive Day/Night Switcher) -->
          <section id="cs-world" class="cs-sec" data-cs-section>
            <div class="cs-sec-head-row">
              <h2 class="cs-h2">World &amp; environment</h2>
              <div class="cs-seg" role="group" aria-label="Switch environment lighting">
                <button type="button" class="cs-seg-btn is-active" data-world-mode="night">
                  Night · Aurora
                </button>
                <button type="button" class="cs-seg-btn" data-world-mode="day">
                  Day · Sunrise
                </button>
              </div>
            </div>

            <p class="cs-prose">
              Full-bleed <code>1920×1080</code> illustrated landscapes anchor the top hero and theme switcher on the live site—transitioning between crisp golden alpine sunrise and glowing northern-lights twilight.
            </p>

            <figure class="cs-figure">
              <div class="cs-world-stage" data-world-stage="night">
                <div class="cs-world-layer is-night">
                  <Picture
                    name="07-sybil-bg-night"
                    alt="Sybil Husky night landscape with Arctic citadel under northern lights"
                    sizes="(min-width: 900px) 864px, 92vw"
                  />
                </div>
                <div class="cs-world-layer is-day">
                  <Picture
                    name="07-sybil-bg-day"
                    alt="Sybil Husky day landscape with pastel sunrise behind snowy peaks and castle"
                    sizes="(min-width: 900px) 864px, 92vw"
                  />
                </div>
              </div>
              <figcaption data-world-caption>
                Night mode artwork — 1920×1080 northern lights key visual used in Dark theme.
              </figcaption>
            </figure>
          </section>

          <!-- Section 4: Character & NFT Tiers -->
          <section id="cs-tiers" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">Character &amp; NFT tiers</h2>
            <p class="cs-prose">
              Each collectible starts from the same geometric husky silhouette and escalates through costume accessories, magical aura, and rune economics—from <strong>Tier 1 Apprentice / Mage</strong> (100 Runes) up to <strong>Tier 3 Supreme</strong> (1,820 Runes, +30% bonus).
            </p>

            <figure class="cs-figure">
              <div class="cs-img-box">
                <Picture
                  name="07-sybil-tiers"
                  alt="Six husky character cards: Apprentice, Mage, Sorcerer, Supreme, Special, Super Special"
                  sizes="(min-width: 900px) 864px, 92vw"
                />
              </div>
              <figcaption>Full 6-tier collectible progression banner.</figcaption>
            </figure>

            <div class="cs-char-grid" role="list" aria-label="Character tier portraits">
              {
                mintTiers.map((c) => (
                  <div class="cs-char-card" role="listitem">
                    <div class="cs-char-thumb">
                      <img src={c.img} width="300" height="300" alt={c.title} loading="lazy" decoding="async" />
                    </div>
                    <div class="cs-char-meta">
                      <span class="cs-char-badge">{c.badge}</span>
                      <strong>{c.title}</strong>
                      <span class="cs-char-stats">{c.stats}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Section 5: Live Interactive Landing Page -->
          <section id="cs-landing" class="cs-sec" data-cs-section>
            <div class="cs-sec-head-row">
              <h2 class="cs-h2">Live landing page UI</h2>
              <div class="cs-seg" role="group" aria-label="Landing page view mode">
                <button type="button" class="cs-seg-btn is-active" data-lp-mode="live">
                  Live Site (Interactive)
                </button>
                <button type="button" class="cs-seg-btn" data-lp-mode="shot">
                  Overview Mockup
                </button>
              </div>
            </div>

            <p class="cs-prose">
              Explore the shipped Next.js build of <strong>sybil-husky.vercel.app</strong> right here—scroll through the 6 sections, toggle the theme, inspect the Mint Tiers, or adjust the 38-month Airdrop Estimator slider.
            </p>

            <div class="cs-browser-frame" data-browser-frame="live">
              <div class="cs-browser-bar">
                <div class="cs-browser-dots" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <div class="cs-browser-url">
                  <span>sybil-husky.vercel.app</span>
                  <span class="cs-live-badge">LIVE</span>
                </div>
                <a href={LIVE_URL} rel="noopener" target="_blank" class="cs-browser-open">
                  Open ↗
                </a>
              </div>

              <!-- Live 1920px-scaled iframe (lazy-loaded on reader open) -->
              <div class="cs-iframe-stage" data-iframe-stage>
                <iframe
                  class="cs-iframe"
                  data-sybil-iframe
                  data-src={LIVE_URL}
                  title="Sybil Husky live website preview"
                  loading="lazy"
                ></iframe>
              </div>

              <!-- Static high-res overview fallback/toggle -->
              <div class="cs-shot-stage" data-shot-stage hidden>
                <Picture
                  name="07-sybil-landing"
                  alt="Sybil Husky landing page UI shown on laptops and as a section overview"
                  sizes="(min-width: 900px) 864px, 92vw"
                />
              </div>
            </div>
          </section>

          <!-- Section 6: Outcome -->
          <section id="cs-outcome" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">Outcome</h2>
            <p class="cs-prose">
              Delivered a complete end-to-end visual package and production Next.js 16 front-end—preserving crisp vector logo geometry, dual 1920×1080 environmental artwork, six character rarity tiers, and interactive calculator/mint controls ready for Web3 launch.
            </p>

            <div class="cs-tools-bar">
              <span class="cs-tools-lbl">Tools &amp; Software</span>
              <div class="cs-tools-list">
                {
                  sybil.tools.map((id) => (
                    <span class="cs-tool-pill">
                      <strong>{tools[id].abbr}</strong> {tools[id].name}
                    </span>
                  ))
                }
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </dialog>
</article>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-sybil-case-dialog]');
  const openers = document.querySelectorAll<HTMLElement>('[data-open-sybil-case]');
  const closer = document.querySelector<HTMLButtonElement>('[data-close-sybil-case]');
  const scroller = dialog?.querySelector<HTMLElement>('[data-cs-scroller]');
  const tocLinks = dialog ? [...dialog.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')] : [];
  const sections = dialog ? [...dialog.querySelectorAll<HTMLElement>('[data-cs-section]')] : [];
  const nextLink = dialog?.querySelector<HTMLAnchorElement>('[data-cs-next]');

  // Interactive Day/Night world switcher
  const worldStage = dialog?.querySelector<HTMLElement>('[data-world-stage]');
  const worldBtns = dialog ? [...dialog.querySelectorAll<HTMLButtonElement>('[data-world-mode]')] : [];
  const worldCaption = dialog?.querySelector<HTMLElement>('[data-world-caption]');

  // Live iframe scaler & view mode switcher
  const lpBtns = dialog ? [...dialog.querySelectorAll<HTMLButtonElement>('[data-lp-mode]')] : [];
  const iframeStage = dialog?.querySelector<HTMLElement>('[data-iframe-stage]');
  const shotStage = dialog?.querySelector<HTMLElement>('[data-shot-stage]');
  const iframeEl = dialog?.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');

  const CASE_HASH = '#read-sybil-husky';

  function scaleLiveFrame() {
    if (!iframeStage || !iframeEl) return;
    const w = iframeStage.clientWidth;
    if (w <= 0) return;
    const s = w / 1920;
    const targetH = Math.round(Math.min(540, Math.max(320, w * 0.625)));
    iframeStage.style.height = `${targetH}px`;
    iframeEl.style.width = '1920px';
    iframeEl.style.height = `${Math.round(targetH / s)}px`;
    iframeEl.style.transform = `scale(${s.toFixed(4)})`;
  }

  if (dialog && scroller) {
    const setActiveToc = (id: string) => {
      for (const link of tocLinks) {
        link.classList.toggle('is-active', link.dataset.csToc === id);
      }
    };

    const ensureIframeLoaded = () => {
      if (iframeEl && !iframeEl.src && iframeEl.dataset.src) {
        iframeEl.src = iframeEl.dataset.src;
      }
      requestAnimationFrame(scaleLiveFrame);
    };

    const openModal = (pushHash = true) => {
      if (document.documentElement.classList.contains('ve-active')) return;
      if (!dialog.open) {
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        scroller.scrollTop = 0;
        setActiveToc(sections[0]?.id || 'cs-overview');
        ensureIframeLoaded();
      }
      if (pushHash && location.hash !== CASE_HASH) {
        history.pushState({ caseStudy: 'sybil-husky' }, '', CASE_HASH);
      }
    };

    const closeModal = (clearHash = true) => {
      if (dialog.open) {
        dialog.close();
      }
      document.documentElement.style.overflow = '';
      if (clearHash && location.hash === CASE_HASH) {
        history.pushState(null, '', '#sybil-husky-test');
      }
    };

    openers.forEach((el) => {
      el.addEventListener('click', (e) => {
        if (document.documentElement.classList.contains('ve-active')) return;
        e.preventDefault();
        openModal(true);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(true);
        }
      });
    });

    closer?.addEventListener('click', () => closeModal(true));

    // World Day/Night Toggle
    worldBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.worldMode || 'night';
        if (worldStage) worldStage.dataset.worldStage = mode;
        worldBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (worldCaption) {
          worldCaption.textContent =
            mode === 'day'
              ? 'Day mode artwork — 1920×1080 alpine sunrise key visual used in Light theme.'
              : 'Night mode artwork — 1920×1080 northern lights key visual used in Dark theme.';
        }
      });
    });

    // Live Site / Mockup Toggle
    lpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.lpMode || 'live';
        lpBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (iframeStage && shotStage) {
          const isLive = mode === 'live';
          iframeStage.hidden = !isLive;
          shotStage.hidden = isLive;
          if (isLive) ensureIframeLoaded();
        }
      });
    });

    if (iframeStage) {
      const ro = new ResizeObserver(scaleLiveFrame);
      ro.observe(iframeStage);
      window.addEventListener('resize', scaleLiveFrame);
    }

    // TOC scrolling inside reader
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = link.dataset.csToc;
        const target = id ? dialog.querySelector<HTMLElement>(`#${id}`) : null;
        if (target) {
          setActiveToc(id!);
          scroller.scrollTo({ top: target.offsetTop - 48, behavior: 'smooth' });
        }
      });
    });

    // Update active TOC pill on scroll
    const onReaderScroll = () => {
      const cutoff = scroller.scrollTop + scroller.clientHeight * 0.28;
      let currentId = sections[0]?.id || 'cs-overview';
      for (const sec of sections) {
        if (sec.offsetTop <= cutoff) {
          currentId = sec.id;
        }
      }
      setActiveToc(currentId);
    };
    scroller.addEventListener('scroll', onReaderScroll, { passive: true });

    // Next project jump
    nextLink?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const dest = nextLink.dataset.csNext || '#k2o';
      if (dialog.open) dialog.close();
      document.documentElement.style.overflow = '';
      history.pushState(null, '', dest);
      const destEl = document.querySelector<HTMLElement>(dest);
      destEl?.scrollIntoView({ behavior: 'smooth' });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      if (location.hash === CASE_HASH) {
        history.replaceState(null, '', '#sybil-husky-test');
      }
    });

    const syncFromHash = () => {
      if (location.hash === CASE_HASH) {
        openModal(false);
      } else if (dialog.open) {
        closeModal(false);
      }
    };
    window.addEventListener('hashchange', syncFromHash);
    window.addEventListener('popstate', syncFromHash);
    if (location.hash === CASE_HASH) {
      openModal(false);
    }
  }
</script>

<style>
  /* ================= Highlight Showcase (Warm Dark Ramp + 4px Grid) ================= */
  .sybil-highlight-test {
    background: #141312;
    color: #efe9de;
    position: relative;
    overflow: hidden;
  }

  .f428-canvas {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    box-sizing: border-box;
    padding: 48px 60px 104px;
    display: flex;
    flex-direction: column;
  }

  .f131 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
    max-width: 672px;
  }

  .f130 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
  }

  .f-no {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: #ff3838;
  }

  .f-title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-transform: none;
    color: #efe9de;
  }

  .f71 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
  }

  .f-overview-h {
    margin: 0;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
