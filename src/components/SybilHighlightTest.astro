---
// Highlight showcase ("07 SYBIL HUSKY") + Full-Screen Editorial Case Study Reader (#read-sybil-husky)
// Polished under unslop Light/Polish Mode: 4px spacing scale, unified site typography,
// warm studio dark ramp with 8% hairlines, and real project copy.
import Picture from './Picture.astro';
import { assetUrl } from '../lib/media';
import { projects } from '../data/projects';
import { tools } from '../data/site';

const sybil = projects.find((p) => p.slug === 'sybil-husky')!;
const k2o = projects.find((p) => p.slug === 'k2o')!;
const logoMarkSrc = assetUrl('media/07-sybil-logo-mark.webp');

const overviewText =
  'A fantasy-inspired visual identity and collectible card system for Sybil Husky. Blending Arctic folklore with clean vector craft, the project spans a minimal husky mark, six progression tiers, northern-lights world art, and a responsive landing page.';

const roleBullets = [
  'Visual identity, logo mark, and overall art direction.',
  'Character design across six collectible rarity tiers.',
  'Northern-lights fantasy environment illustration.',
  'Landing page UI layout and responsive web assets.',
];

const challengeBullets = [
  'Keep the mascot silhouette legible from 24px avatars up to hero banners.',
  'Build clear rarity distinction across six tiers while sharing one base anatomy.',
  'Connect rich fantasy illustration with a clean, scannable landing page.',
];

const sections = [
  { id: 'cs-overview', label: 'Overview' },
  { id: 'cs-challenge', label: 'The challenge' },
  { id: 'cs-world', label: 'World & environment' },
  { id: 'cs-tiers', label: 'Character tiers' },
  { id: 'cs-landing', label: 'Landing page UI' },
  { id: 'cs-outcome', label: 'Outcome' },
];
---

<article
  class="project sybil-highlight-test"
  id="sybil-husky-test"
  aria-labelledby="sybil-test-title"
>
  <div class="f428-canvas" data-ve-editorial="sybil-husky-test">
    <!-- Header (07 + SYBIL HUSKY) & Overview -->
    <header class="f131" data-ve-free="sybil-test:header" data-ve-label="07 Header & Overview">
      <div class="f130">
        <p class="f-no" data-reveal>07</p>
        <h3 id="sybil-test-title" class="f-title" data-reveal style="--reveal-d: 50ms">
          SYBIL HUSKY
        </h3>
      </div>

      <div class="f71">
        <h4 class="f-overview-h" data-reveal style="--reveal-d: 100ms">Overview</h4>
        <p class="f-overview-p" data-reveal style="--reveal-d: 140ms">
          {overviewText}
        </p>
      </div>
    </header>

    <!-- Highlight Card (1080 x 576 with 60px margin on 1200px frame) -->
    <div
      class="f429"
      data-ve-free="sybil-test:hero-card"
      data-ve-label="07 Highlight Card"
      data-open-sybil-case
      role="button"
      tabindex="0"
      aria-label="Open Sybil Husky Full Case Study"
    >
      <img
        class="f-group354"
        src={logoMarkSrc}
        width="568"
        height="306"
        alt="Sybil Husky logo mark and wordmark"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Bottom Row: Full Case Study CTA + My Role + The Challenge -->
    <div class="f-bottom-row">
      <a
        href="#read-sybil-husky"
        class="f430-btn"
        data-open-sybil-case
        data-ve-free="sybil-test:cta"
        data-ve-label="07 Full Case Study Button"
      >
        <span>Full Case Study</span>
      </a>

      <div class="f72" data-ve-free="sybil-test:role" data-ve-label="07 My Role">
        <h4 class="f-col-h" data-reveal>My Role</h4>
        <ul class="f-col-list" data-reveal style="--reveal-d: 60ms">
          {roleBullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="f128" data-ve-free="sybil-test:problem" data-ve-label="07 The Challenge">
        <h4 class="f-col-h" data-reveal style="--reveal-d: 60ms">The Challenge</h4>
        <ul class="f-col-list" data-reveal style="--reveal-d: 120ms">
          {challengeBullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Full-Screen Editorial Case Study Reader (#read-sybil-husky) -->
  <dialog class="cs-reader" data-sybil-case-dialog aria-labelledby="cs-main-title">
    <div class="cs-layout">
      <!-- Left Sticky Navigation Sidebar -->
      <aside class="cs-sidebar" aria-label="Case study sections">
        <button type="button" class="cs-back" data-close-sybil-case>
          <span aria-hidden="true">←</span>
          <span>All work</span>
        </button>

        <div class="cs-toc-wrap">
          <p class="cs-proj-name">Sybil Husky</p>
          <nav aria-label="Table of contents">
            <ul class="cs-toc" role="list">
              {
                sections.map((s, idx) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class:list={['cs-toc-link', { 'is-active': idx === 0 }]}
                      data-cs-toc={s.id}
                    >
                      <span class="cs-toc-bar" aria-hidden="true" />
                      <span>{s.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <a href="#k2o" class="cs-next" data-cs-next="#k2o">
          <span class="cs-next-lbl">Next project</span>
          <span class="cs-next-title">{k2o.spine.label} <span aria-hidden="true">→</span></span>
        </a>
      </aside>

      <!-- Right Scrollable Editorial Reading Column -->
      <div class="cs-scroller" data-cs-scroller>
        <div class="cs-article">
          <!-- Section 1: Overview -->
          <section id="cs-overview" class="cs-sec" data-cs-section>
            <div class="cs-hero-banner">
              <img
                src={logoMarkSrc}
                width="568"
                height="306"
                alt="Sybil Husky brand mark and wordmark"
                class="cs-hero-logo"
              />
            </div>

            <h1 id="cs-main-title" class="cs-h1">Sybil Husky</h1>
            <p class="cs-subtitle">
              A fantasy-inspired Web3 brand identity, six-tier collectible character system, northern-lights world illustration, and interactive landing page UI.
            </p>

            <dl class="cs-meta-grid">
              <div>
                <dt>Client</dt>
                <dd>Sybil Husky Collective</dd>
              </div>
              <div>
                <dt>Dates</dt>
                <dd>2024 — Digital &amp; Web3 Release</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>Visual Identity, Character Design &amp; UI</dd>
              </div>
            </dl>

            <p class="cs-prose">
              Sybil Husky is a character-driven digital project blending mystical Arctic folklore with a clean, modern collectible card identity. I led the visual direction from the core geometric husky emblem through to the six progression tiers, environmental key art, and the responsive web interface.
            </p>
          </section>

          <!-- Section 2: The Challenge -->
          <section id="cs-challenge" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">The challenge</h2>
            <p class="cs-prose">
              Most character collectible projects suffer from visual clutter—overly complex mascots that lose legibility at small avatar sizes, paired with generic dark-mode landing pages that feel disconnected from the artwork.
            </p>
            <p class="cs-prose">
              Our goal was to establish an immediately recognizable silhouette that works both as a minimal monochrome mark and as the foundation for six distinct RPG-inspired character classes, while keeping the website navigation intuitive for first-time visitors.
            </p>

            <div class="cs-callout-grid">
              <div class="cs-callout">
                <h3>01 · Recognizable silhouette</h3>
                <p>Built the logo mark from sharp crescent curves so the husky ear-and-muzzle profile stays legible from a 24px favicon up to billboard scale.</p>
              </div>
              <div class="cs-callout">
                <h3>02 · Cohesive tier progression</h3>
                <p>Designed a clear visual hierarchy across six rarity tiers so collectors can tell an Apprentice from a Super Special card at a glance.</p>
              </div>
            </div>
          </section>

          <!-- Section 3: World & Environment -->
          <section id="cs-world" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">World &amp; environment</h2>
            <p class="cs-prose">
              To ground the characters in a memorable setting, I illustrated an Arctic mountain citadel beneath ribbons of aurora borealis. The cool cyan-to-cobalt palette provides high contrast against the warm gold and crimson accents of the higher-tier character cards.
            </p>

            <figure class="cs-figure">
              <div class="cs-img-box">
                <Picture
                  name="07-sybil-environment"
                  alt="Illustrated snowy mountain landscape with a castle under the northern lights"
                  sizes="(min-width: 900px) 780px, 92vw"
                />
              </div>
              <figcaption>Environmental key visual — Northern lights citadel and layered alpine terrain.</figcaption>
            </figure>
          </section>

          <!-- Section 4: Character Tiers -->
          <section id="cs-tiers" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">Character tiers</h2>
            <p class="cs-prose">
              Every character shares the same base husky anatomy for brand consistency, while costume design, lighting effects, and card frame colors escalate across six tiers: <strong>Apprentice</strong>, <strong>Mage</strong>, <strong>Sorcerer</strong>, <strong>Supreme</strong>, <strong>Special</strong>, and <strong>Super Special</strong>.
            </p>

            <figure class="cs-figure">
              <div class="cs-img-box">
                <Picture
                  name="07-sybil-tiers"
                  alt="Six husky character cards: Apprentice, Mage, Sorcerer, Supreme, Special, Super Special"
                  sizes="(min-width: 900px) 780px, 92vw"
                />
              </div>
              <figcaption>The six collectible tiers — progressing from everyday winter gear to arcane cosmic regalia.</figcaption>
            </figure>
          </section>

          <!-- Section 5: Landing Page UI -->
          <section id="cs-landing" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">Landing page UI</h2>
            <p class="cs-prose">
              The web experience brings the world art and card system together into a single editorial landing page. Visitors can explore the lore, inspect each rarity tier, and preview the collection layout across desktop and tablet breakpoints.
            </p>

            <figure class="cs-figure">
              <div class="cs-img-box">
                <Picture
                  name="07-sybil-landing"
                  alt="Sybil Husky landing page UI shown on laptops and as a section overview"
                  sizes="(min-width: 900px) 780px, 92vw"
                />
              </div>
              <figcaption>Full landing page architecture — hero showcase, lore breakdown, and interactive tier gallery.</figcaption>
            </figure>
          </section>

          <!-- Section 6: Outcome -->
          <section id="cs-outcome" class="cs-sec" data-cs-section>
            <h2 class="cs-h2">Outcome</h2>
            <p class="cs-prose">
              The final identity package delivered a complete, production-ready design system: vector brand guidelines, six high-resolution character illustrations with modular card frames, widescreen environmental art, and a responsive Figma UI kit ready for front-end handoff.
            </p>

            <div class="cs-tools-bar">
              <span class="cs-tools-lbl">Tools &amp; Software</span>
              <div class="cs-tools-list">
                {
                  sybil.tools.map((id) => (
                    <span class="cs-tool-pill">
                      <strong>{tools[id].abbr}</strong> {tools[id].name}
                    </span>
                  ))
                }
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </dialog>
</article>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-sybil-case-dialog]');
  const openers = document.querySelectorAll<HTMLElement>('[data-open-sybil-case]');
  const closer = document.querySelector<HTMLButtonElement>('[data-close-sybil-case]');
  const scroller = dialog?.querySelector<HTMLElement>('[data-cs-scroller]');
  const tocLinks = dialog ? [...dialog.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')] : [];
  const sections = dialog ? [...dialog.querySelectorAll<HTMLElement>('[data-cs-section]')] : [];
  const nextLink = dialog?.querySelector<HTMLAnchorElement>('[data-cs-next]');

  const CASE_HASH = '#read-sybil-husky';

  if (dialog && scroller) {
    const setActiveToc = (id: string) => {
      for (const link of tocLinks) {
        link.classList.toggle('is-active', link.dataset.csToc === id);
      }
    };

    const openModal = (pushHash = true) => {
      if (document.documentElement.classList.contains('ve-active')) return;
      if (!dialog.open) {
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        scroller.scrollTop = 0;
        setActiveToc(sections[0]?.id || 'cs-overview');
      }
      if (pushHash && location.hash !== CASE_HASH) {
        history.pushState({ caseStudy: 'sybil-husky' }, '', CASE_HASH);
      }
    };

    const closeModal = (clearHash = true) => {
      if (dialog.open) {
        dialog.close();
      }
      document.documentElement.style.overflow = '';
      if (clearHash && location.hash === CASE_HASH) {
        history.pushState(null, '', '#sybil-husky-test');
      }
    };

    openers.forEach((el) => {
      el.addEventListener('click', (e) => {
        if (document.documentElement.classList.contains('ve-active')) return;
        e.preventDefault();
        openModal(true);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(true);
        }
      });
    });

    closer?.addEventListener('click', () => closeModal(true));

    // Clicking a TOC link scrolls inside the reader scroller (not the main window)
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = link.dataset.csToc;
        const target = id ? dialog.querySelector<HTMLElement>(`#${id}`) : null;
        if (target) {
          setActiveToc(id!);
          scroller.scrollTo({ top: target.offsetTop - 48, behavior: 'smooth' });
        }
      });
    });

    // Update active TOC pill on scroll inside the reader
    const onReaderScroll = () => {
      const cutoff = scroller.scrollTop + scroller.clientHeight * 0.28;
      let currentId = sections[0]?.id || 'cs-overview';
      for (const sec of sections) {
        if (sec.offsetTop <= cutoff) {
          currentId = sec.id;
        }
      }
      setActiveToc(currentId);
    };
    scroller.addEventListener('scroll', onReaderScroll, { passive: true });

    // Next project link closes reader and jumps to target project
    nextLink?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const dest = nextLink.dataset.csNext || '#k2o';
      if (dialog.open) dialog.close();
      document.documentElement.style.overflow = '';
      history.pushState(null, '', dest);
      const destEl = document.querySelector<HTMLElement>(dest);
      destEl?.scrollIntoView({ behavior: 'smooth' });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      if (location.hash === CASE_HASH) {
        history.replaceState(null, '', '#sybil-husky-test');
      }
    });

    // Support direct URL / refresh / browser Back button with #read-sybil-husky
    const syncFromHash = () => {
      if (location.hash === CASE_HASH) {
        openModal(false);
      } else if (dialog.open) {
        closeModal(false);
      }
    };
    window.addEventListener('hashchange', syncFromHash);
    window.addEventListener('popstate', syncFromHash);
    if (location.hash === CASE_HASH) {
      openModal(false);
    }
  }
</script>

<style>
  /* ================= Highlight Showcase (Warm Dark Ramp + 4px Grid) ================= */
  .sybil-highlight-test {
    background: #141312;
    color: #efe9de;
    position: relative;
    overflow: hidden;
  }

  .f428-canvas {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    box-sizing: border-box;
    padding: 48px 60px 104px;
    display: flex;
    flex-direction: column;
  }

  /* Header & Overview: 4px spacing scale */
  .f131 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
    max-width: 672px;
  }

  .f130 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
  }

  .f-no {
    margin: 0;
    font-family: var(--f-heading);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: #ff3838;
  }

  .f-title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #efe9de;
  }

  .f71 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
  }

  .f-overview-h {
    margin: 0;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    color: #ff3838;
  }

  .f-overview-p {
    margin: 0;
    font-family: var(--f-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.55;
    color: #cbc4b8;
  }

  /* Highlight Card (1080 x 576 with 60px margin on 1200px frame) */
  .f429 {
    box-sizing: border-box;
    margin-top: 48px;
    width: 100%;
    max-width: 1080px;
    min-height: 576px;
    padding: 80px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #bbdefb 0%, #ffffff 100%);
    border-radius: 24px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.45);
    cursor: pointer;
    transition:
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.24s ease;
  }
  .f429:hover {
    transform: translateY(-2px);
    box-shadow:
      0 20px 44px rgb(0 0 0 / 0.42),
      inset 0 0 0 1px rgb(255 255 255 / 0.6);
  }
  .f429:active {
    transform: scale(0.99);
  }
  .f429:focus-visible {
    outline: 3px solid #ff3838;
    outline-offset: 4px;
  }

  .f-group354 {
    display: block;
    width: 100%;
    max-width: 624px;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Bottom Row: 64px below card */
  .f-bottom-row {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 48px;
    align-items: start;
  }
  @media (min-width: 1200px) {
    .f-bottom-row {
      width: 100%;
      max-width: 1080px;
      grid-template-columns: 248px 1fr 1fr;
      column-gap: 80px;
    }
    .f72 {
      width: 332px;
    }
    .f128 {
      width: 344px;
    }
  }

  /* Primary Action Button (Warm off-white primary on dark surface per unslop) */
  .f430-btn {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 16px 24px;
    gap: 8px;
    width: 248px;
    height: 72px;
    background: #efe9de;
    border: 0;
    border-radius: 999px;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: #141312;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.16s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.16s ease,
      color 0.16s ease;
  }
  .f430-btn:hover {
    background: #ff3838;
    color: #ffffff;
  }
  .f430-btn:active {
    transform: scale(0.97);
  }
  .f430-btn:focus-visible {
    outline: 3px solid #ff3838;
    outline-offset: 4px;
  }

  .f72,
  .f128 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .f-col-h {
    margin: 0;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    color: #ff3838;
  }

  .f-col-list {
    margin: 0;
    padding-left: 1.2em;
    font-family: var(--f-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.55;
    color: #cbc4b8;
  }
  .f-col-list li + li {
    margin-top: 4px;
  }

  @media (max-width: 1199px) {
    .f428-canvas {
      padding: 40px var(--gutter) 72px;
    }
    .f429 {
      min-height: 360px;
      padding: 48px 32px;
    }
    .f-bottom-row {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
  }

  /* ================= Full-Screen Editorial Case Study Reader (Warm Dark Ramp) ================= */
  .cs-reader {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #161513;
    color: #efe9de;
    overflow: hidden;
  }
  .cs-reader::backdrop {
    background: rgb(12 11 10 / 0.88);
  }

  .cs-layout {
    display: grid;
    grid-template-columns: 264px minmax(0, 1fr);
    width: 100%;
    height: 100dvh;
  }

  /* Left Sidebar (All work + TOC + Next) */
  .cs-sidebar {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 24px 36px 32px;
    background: #12110f;
    border-right: 1px solid rgb(239 233 222 / 0.08);
    height: 100dvh;
    user-select: none;
  }

  .cs-back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 4px;
    border: 0;
    background: transparent;
    color: #aaa398;
    font: 500 14px / 1.2 var(--f-body);
    cursor: pointer;
    transition: color 0.16s ease, transform 0.16s ease;
  }
  .cs-back:hover {
    color: #efe9de;
    transform: translateX(-2px);
  }

  .cs-toc-wrap {
    display: grid;
    gap: 12px;
    margin-block: auto;
  }

  .cs-proj-name {
    margin: 0 0 4px 12px;
    font-family: var(--f-display);
    font-size: 18px;
    font-weight: 400;
    color: #efe9de;
    letter-spacing: -0.01em;
  }

  .cs-toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .cs-toc-link {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding-inline: 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    color: #8a847a;
    font: 500 14px / 1.2 var(--f-body);
    text-decoration: none;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .cs-toc-link:hover {
    color: #efe9de;
  }
  .cs-toc-bar {
    width: 12px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.45;
    transition: width 0.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
