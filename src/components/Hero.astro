---
import { profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import HeroShapes from './HeroShapes';
---

<header class="hero" id="top">
  <div class="shapes"><HeroShapes client:load /></div>
  <nav class="hero-nav container" aria-label="Primary">
    <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
    <ul role="list">
      <li><a href="#work">Work</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><ThemeToggle /></li>
    </ul>
  </nav>

  <div class="hero-body container">
    <p class="wordmark display" aria-hidden="true">
      <span data-shape-obstacle>Port</span><span data-shape-obstacle>folio</span>
    </p>

    <div class="hero-intro">
      <p class="hero-status">
        <span class="status-dot" aria-hidden="true"></span>
        {profile.availability}
      </p>
      <h1 class="hero-name">
        Hi, I’m <span class="nick">{profile.nickname}</span> — {profile.role}
      </h1>
      <p class="hero-lead">{profile.heroSummary}</p>
      <div class="hero-cta">
        <a class="btn btn-dark" href="#work">See the work</a>
        <a class="btn btn-light" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--c-hero); /* same red as the shapes canvas, shown until it hydrates */
    color: var(--c-ink);
    overflow: hidden;
  }
  /* Shape Physics fills the hero behind the content */
  .shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero > :not(.shapes) {
    position: relative;
    z-index: 1;
  }
  /* let the pointer through to the shapes except on links and controls */
  .hero-nav,
  .hero-body {
    pointer-events: none;
  }
  .hero-nav :is(a, button, label, input),
  .hero-body :is(a, button) {
    pointer-events: auto;
  }

  .hero-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }
  .brand {
    font-family: var(--f-display);
    font-size: 1.5rem;
    color: var(--c-ink-display);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .hero-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 32px);
    margin: 0;
  }
  .hero-nav a:not(.brand) {
    display: inline-block;
    padding-block: 10px;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .hero-nav a:not(.brand):hover {
    text-decoration: underline;
  }

  .hero-body {
    container-type: inline-size;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5vw, 56px);
    padding-block: clamp(24px, 6vh, 72px) clamp(40px, 8vh, 96px);
  }

  .wordmark {
    font-family: var(--f-heading);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--c-ink-display);
    /* "FOLIO" is ~6.5em wide in BBH Bartle: sized to ~70% of the container,
       leaving wide side margins for the hero shapes to fall past */
    font-size: min(12.5rem, calc(100cqi / 9.3));
    line-height: 0.84;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .hero-intro {
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.14);
    border: 1px solid rgb(0 0 0 / 0.22);
    color: var(--c-ink);
    font-size: var(--fs-0);
    font-weight: 700;
    line-height: 1.2;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #111;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.45);
  }
  .hero-name {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
  }
  .nick {
    white-space: nowrap;
  }
  .hero-lead {
    max-width: 58ch;
    color: var(--c-ink);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.125rem);
    font-weight: 500;
    line-height: 1.5;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .btn-dark {
    background: var(--c-ink-display);
    color: #f2f2f2;
  }
  .btn-dark:hover {
    background: #000;
  }
  .btn-light {
    background: #f2f2f2;
    color: #000;
  }
  .btn-light:hover {
    background: #fff;
  }
  .hero :focus-visible {
    box-shadow: 0 0 0 3px var(--c-hero), 0 0 0 6px #000;
  }

  @media (min-width: 900px) {
    .hero-intro {
      grid-template-columns: 1fr auto;
      column-gap: 32px;
      align-items: end;
      justify-items: start;
      text-align: left;
    }
    .hero-intro > :not(.hero-cta) {
      grid-column: 1;
    }
    .hero-cta {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-top: 0;
    }
  }
</style>
