---
import { profile } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import HeroShapes from './HeroShapes';
---

<header class="hero" id="top">
  <div class="shapes"><HeroShapes client:load /></div>
  <nav class="hero-nav container" aria-label="Primary">
    <a class="brand" href="#top" aria-label="Pun, back to top">PUN</a>
    <ul role="list">
      <li><a href="#work">Projects</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
      <li class="hero-utils">
        <LangToggle variant="hero" />
        <ThemeToggle />
      </li>
    </ul>
  </nav>

  <div class="hero-body container">
    <div class="hero-intro" data-shape-obstacle="box">
      <p class="hero-status">
        <span class="status-dot" aria-hidden="true"></span>
        {profile.availability}
      </p>
      <h1 class="hero-name">
        Hi, I’m <span class="nick">{profile.nickname}</span> — {profile.role}
      </h1>
      <p class="hero-lead">{profile.heroSummary}</p>
      <div class="hero-cta">
        <a class="btn btn-dark" href="#work">Explore projects</a>
        <a class="btn btn-light" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--c-hero); /* same red as the shapes canvas, shown until it hydrates */
    color: var(--c-ink);
    overflow: hidden;
  }
  /* Shape Physics fills the hero behind the content */
  .shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero > :not(.shapes) {
    position: relative;
    z-index: 1;
  }
  /* let the pointer through to the shapes except on links and controls */
  .hero-nav,
  .hero-body {
    pointer-events: none;
  }
  .hero-nav :is(a, button, label, input),
  .hero-body :is(a, button) {
    pointer-events: auto;
  }

  .hero-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }
  .brand {
    font-family: var(--f-display);
    font-size: 1.5rem;
    color: var(--c-ink-display);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .hero-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 32px);
    margin: 0;
  }
  .hero-utils {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-nav a:not(.brand) {
    display: inline-block;
    padding-block: 10px;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .hero-nav a:not(.brand):hover {
    text-decoration: underline;
  }
  @media (max-width: 480px) {
    .hero-nav ul {
      gap: 10px;
      font-size: 0.875rem;
    }
    .hero-utils {
      gap: 4px;
    }
    .hero-nav :global(.lang-btn) {
      padding: 4px 7px;
      font-size: 10.5px;
    }
    .hero-nav :global(.theme-toggle) {
      min-width: 44px;
    }
  }

  .hero-body {
    flex: 1;
    display: grid;
    place-items: center;
    padding-block: clamp(24px, 6vh, 64px) clamp(56px, 10vh, 104px);
  }

  .hero-intro {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
    max-width: min(100%, 720px);
    padding: 20px 24px;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.14);
    border: 1px solid rgb(0 0 0 / 0.22);
    color: var(--c-ink);
    font-size: var(--fs-0);
    font-weight: 700;
    line-height: 1.2;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #111;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.45);
  }
  .hero-name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--c-ink-display);
  }
  .nick {
    white-space: nowrap;
  }
  .hero-lead {
    max-width: 54ch;
    color: var(--c-ink);
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.2rem);
    font-weight: 500;
    line-height: 1.6;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  .btn-dark {
    background: var(--c-ink-display);
    color: #f2f2f2;
  }
  .btn-dark:hover {
    background: #000;
  }
  .btn-light {
    background: #f2f2f2;
    color: #000;
  }
  .btn-light:hover {
    background: #fff;
  }
  .hero :focus-visible {
    box-shadow: 0 0 0 3px var(--c-hero), 0 0 0 6px #000;
  }
</style>
