---
// Main-page showcase layout trial for Project 01 (K2O Songkran Music Festival),
// matching Figma Frame 432: centered 820px editorial column with mono index,
// uppercase Archivo Black display title, 16:9 rounded-32 visual stage,
// Kodchasan overview + FULL CASE STUDY pill CTA, and Category/Scope/Tools specs.
import type { Project } from '../data/projects';
import { caseStudies } from '../data/caseStudies';
import Picture from './Picture.astro';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const cs = caseStudies[p.slug];
const titleId = `${p.slug}-title`;
---

<article class="project k2o-frame" id={p.slug} data-project-title={p.title} aria-labelledby={titleId}>
  <div class="k2o-surface">
    <div class="k2o-col">
      <header class="k2o-head" data-reveal>
        <p class="k2o-no" aria-hidden="true">{p.no}</p>
        <h3 id={titleId} class="k2o-title">
          <a
            class="k2o-title-link"
            href={`#read-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
          >
            <span class="visually-hidden">Project {p.no}: </span>
            {p.title}
          </a>
        </h3>
      </header>

      <a
        class="k2o-media"
        href={`#read-${p.slug}`}
        data-open-case={p.slug}
        data-case-trigger
        aria-label={`Open full case study for ${p.title}`}
        data-reveal
        style="--reveal-d: 80ms"
      >
        <Picture
          name="01-k2o-planb-poster"
          alt="K2O Songkran Music Festival panoramic BTS Asok Plan B digital OOH takeover"
          sizes="(min-width: 1200px) 940px, 92vw"
        />
      </a>

      <div class="k2o-lower" data-reveal style="--reveal-d: 140ms">
        <div class="k2o-left">
          <div class="k2o-overview-wrap">
            <h4 class="k2o-kicker">Overview</h4>
            <p class="k2o-overview">
              <span data-lang-text="en">{cs?.subtitle ?? p.description}</span>
              <span data-lang-text="th">{cs?.subtitleTh ?? p.descriptionTh}</span>
            </p>
          </div>

          <a
            class="k2o-cta"
            href={`#read-${p.slug}`}
            data-open-case={p.slug}
          >
            <span>FULL CASE STUDY</span>
          </a>
        </div>

        <dl class="k2o-specs">
          <div class="k2o-spec-row">
            <dt class="k2o-kicker">Category</dt>
            <dd class="k2o-spec-val">Key Visual</dd>
          </div>
          <div class="k2o-spec-row">
            <dt class="k2o-kicker">Scope</dt>
            <dd class="k2o-spec-val">Festival</dd>
          </div>
          <div class="k2o-spec-row">
            <dt class="k2o-kicker">Tools</dt>
            <dd class="k2o-spec-val">Photoshop, Illustrator, Blender</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</article>

<style>
  .k2o-frame {
    position: relative;
  }
  .k2o-frame::before {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: var(--c-line);
  }

  .k2o-surface {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(48px, 4.8vw, 62px) clamp(20px, 6vw, 120px);
    background: var(--c-bg);
    transition: background-color 0.25s ease;
  }
  :global(:root[data-theme='dark']) .k2o-surface {
    background: #242424;
  }

  .k2o-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(28px, 3.2vw, 40px);
    width: 100%;
    max-width: 940px;
  }

  .k2o-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .k2o-no {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.1;
    color: var(--c-accent);
  }
  :global(:root[data-theme='dark']) .k2o-no {
    color: #ff2b2b;
  }

  .k2o-title {
    margin: 0;
    width: 100%;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    color: var(--c-fg);
  }
  :global(:root[data-theme='dark']) .k2o-title {
    color: #fbf5eb;
  }

  .k2o-title-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }
  .k2o-title-link:hover {
    opacity: 0.86;
  }

  .k2o-media {
    display: block;
    width: 100%;
    aspect-ratio: 940 / 529;
    border-radius: clamp(20px, 2.6vw, 32px);
    overflow: hidden;
    background: linear-gradient(180deg, #d9d9d9 0%, #737373 100%);
    box-shadow: 0 24px 54px rgb(0 0 0 / 0.16);
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
  }
  :global(:root[data-theme='dark']) .k2o-media {
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.42);
  }
  .k2o-media:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 64px rgb(0 0 0 / 0.24);
  }
  .k2o-media :global(picture),
  .k2o-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .k2o-media:hover :global(img) {
    transform: scale(1.025);
  }

  .k2o-lower {
    display: grid;
    grid-template-columns: minmax(0, 542fr) minmax(0, 303fr);
    align-items: start;
    gap: clamp(32px, 6.8vw, 95px);
    width: 100%;
  }

  .k2o-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .k2o-overview-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .k2o-kicker {
    margin: 0;
    font-family: 'Kodchasan', var(--f-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.1;
    color: var(--c-accent);
  }
  :global(:root[data-theme='dark']) .k2o-kicker {
    color: #ff2b2b;
  }

  .k2o-overview {
    margin: 0;
    font-family: 'Kodchasan', var(--f-body);
    font-weight: 500;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.4;
    color: var(--c-fg);
  }
  :global(:root[data-theme='dark']) .k2o-overview {
    color: #ffffff;
  }

  .k2o-cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 248px;
    height: 80px;
    padding: 15px 10px;
    border-radius: 999px;
    background: var(--c-fg);
    color: var(--c-bg);
    font-family: 'Kodchasan', var(--f-body);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  :global(:root[data-theme='dark']) .k2o-cta {
    background: #ffffff;
    color: #000000;
  }
  .k2o-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgb(0 0 0 / 0.22);
  }
  .k2o-cta:active {
    transform: scale(0.97);
  }

  .k2o-specs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin: 0;
    width: 100%;
  }

  .k2o-spec-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--c-line);
  }
  :global(:root[data-theme='dark']) .k2o-spec-row {
    border-bottom-color: #5a5a5a;
  }

  .k2o-spec-val {
    margin: 0;
    font-family: 'Kodchasan', var(--f-body);
    font-weight: 700;
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.4;
    color: var(--c-fg);
  }
  :global(:root[data-theme='dark']) .k2o-spec-val {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .k2o-lower {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .k2o-cta {
      width: 224px;
      height: 64px;
      font-size: 17px;
    }
  }
</style>
