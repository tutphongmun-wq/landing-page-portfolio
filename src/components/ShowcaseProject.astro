                      data-sp-thumb
                      data-src={item.src}
                      data-alt={item.alt}
                    >
                      <Picture
                        name={item.name}
                        alt=""
                        sizes="(min-width: 900px) 264px, 32vw"
                      />
                    </button>
                  ))}
                </div>
              </div>
            </FadeContent>
          ) : (
            /* ================= OPTION 1: FULL-GRID 1280PX WIDE HERO ================= */
            heroImage && (
              <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.95} threshold={0.1}>
                <a
                  class="sp-media sp-wide-media"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                  data-case-trigger
                  aria-label={`Explore ${p.title}`}
                  style={`--sp-pos: ${heroPos};`}
                >
                  <Picture
                    name={heroImage}
                    alt={heroAlt}
                    sizes="(min-width: 1100px) 1280px, 92vw"
                  />
                </a>
              </FadeContent>
            )
          )}

          <!-- Bottom Two-Column Info Row (Full-Width Flush with Hero) -->
          <FadeContent client:load once={false} exit={true} effect="fade" blur={4} duration={0.85} threshold={0.12}>
            <div class="sp-bottom">
