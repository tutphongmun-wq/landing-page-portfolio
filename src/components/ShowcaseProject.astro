---
// Editorial Showcase Layout for Main Page Projects (01–03)
// Supports 3 distinct desktop composition variants for live comparison:
//   - "wide"    (Project 01): Full 1280px grid width, balanced hero height to fit 1 screen
//   - "split"   (Project 02): 2-column horizontal split (60% visual left / 40% overview + meta + CTA right)
//   - "gallery" (Project 03): 1280px grid with main hero + interactive 3-thumbnail preview strip on the right
import type { Media, Project } from '../data/projects';
import { caseStudies } from '../data/caseStudies';
import { tools } from '../data/site';
import { posterUrl } from '../lib/media';
import Picture from './Picture.astro';
import FadeContent from './FadeContent.jsx';

export type ShowcaseVariant = 'wide' | 'split' | 'gallery' | 'editorial' | 'bento' | 'bento-h' | 'worachet';

interface Props {
  project: Project;
  variant?: ShowcaseVariant;
}

const { project: p, variant = 'wide' } = Astro.props;
const titleId = `${p.slug}-title`;
const cs = caseStudies[p.slug];

const heroImage =
  cs?.cover.kind === 'photo' || cs?.cover.kind === 'framed'
    ? cs.cover.image
    : p.media.find((m) => m.kind === 'image')?.name ?? '';

const heroAlt =
  cs?.cover.alt ??
  (p.media.find((m) => m.kind === 'image') as { alt?: string } | undefined)?.alt ??
  p.title;

const heroPos =
  p.slug === 'infographic'
    ? 'center 10%'
    : p.slug === 'visual-content'
      ? 'center 25%'
      : cs?.cover.kind === 'photo' && cs.cover.position
        ? cs.cover.position
        : 'center center';

// Curated 3 preview images for Option 3 ("gallery" & "editorial" variants)
const allImages = p.media.filter((m): m is Extract<Media, { kind: 'image' }> => m.kind === 'image');
const curatedGalleryMap: Record<string, { name: string; alt: string }[]> = {
  'thumbnails-posters': [
    { name: '03-thumbs-netflix-snow', alt: 'Netflix Thailand snow challenge Sapporo trip thumbnail' },
    { name: '03-thumbs-masterchef', alt: 'MasterChef The Professionals Thailand thumbnail' },
    { name: '03-thumbs-netflix-codex', alt: 'Netflix Thailand six technologies thumbnail' },
  ],
  'visual-content': [
    { name: '04-content-post-tree-of-alpha', alt: 'Newspaper collage visual for Tree of Alpha' },
    { name: '04-content-buyback', alt: 'Crypto buyback and token burn flaming Bitcoin visual' },
    { name: '04-content-call-center', alt: 'Call-center scam psychology red editorial visual' },
  ],
  infographic: [
    { name: '05-info-ev-sales', alt: 'Electric car prices and sales in Thailand infographic' },
    { name: '05-info-pixar', alt: 'Nine business lessons from Pixar infographic' },
    { name: '05-info-ethereum', alt: 'Five stages of the Ethereum roadmap infographic' },
  ],
  '16-personalities': [
    { name: '06-16p-cover', alt: 'Stack of 16 Personalities books with colorful rounded cover' },
    { name: '06-16p-spread-purple', alt: 'Purple book spread for the INTP type with DNA graphics' },
    { name: '06-16p-spread-yellow', alt: 'Yellow book spread featuring desert adventurer character' },
  ],
  'sybil-husky': [
    { name: '07-sybil-bg-night', alt: 'Sybil Husky 4K Arctic fortress under the northern lights (Night mode)' },
    { name: '07-sybil-bg-day', alt: 'Sybil Husky 4K Arctic fortress at alpine sunrise (Day mode)' },
    { name: '07-sybil-landing', alt: 'Sybil Husky Next.js landing page UI overview' },
  ],
};

const galleryItems = (
  curatedGalleryMap[p.slug] ??
  [heroImage, ...allImages.map((m) => m.name).filter((n) => n !== heroImage)]
    .slice(0, 3)
    .map((name) => ({
      name,
      alt: allImages.find((m) => m.name === name)?.alt ?? p.title,
    }))
)
  .map((item) => ({ ...item, src: posterUrl(item.name) }))
  .filter((item) => Boolean(item.src));

const categoryVal = cs?.meta.find((m) => m.label.toLowerCase() === 'category')?.value ?? 'Design';
const scopeVal = cs?.meta.find((m) => m.label.toLowerCase() === 'scope')?.value ?? p.role[0] ?? '';
const yearVal = cs?.meta.find((m) => m.label.toLowerCase() === 'year')?.value ?? '';
const toolsVal = p.tools.map((t) => tools[t]?.name ?? t).join(', ');

const clientMap: Record<string, string> = {
  'visual-content': 'Enter to Start · Binance TH',
  infographic: 'Enter to Start',
  '16-personalities': 'Editorial Book Project',
  'sybil-husky': 'Web3 NFT Brand',
};
const clientLabel =
  clientMap[p.slug] ?? (p.client && !p.client.includes('[TODO]') ? p.client : '');

const overviewEn = cs?.subtitle ?? (Array.isArray(p.description) ? p.description[0] : p.description);
const overviewTh = cs?.subtitleTh ?? (Array.isArray(p.descriptionTh) ? p.descriptionTh[0] : p.descriptionTh);
const highlightsEn = p.role.slice(0, 3);
const highlightsTh = p.roleTh.slice(0, 3);
const isGalleryStage = variant === 'gallery' || variant === 'editorial';
const isEditorialScale = variant === 'editorial' || variant === 'bento-h';

// Worachet-style editorial fields (used on K2O main-page showcase)
const storyEn = cs?.overviewParagraphs[0] ?? overviewEn;
const storyTh = cs?.overviewParagraphsTh[0] ?? overviewTh;
const challengeEn = cs?.challenge.paragraphs[0] ?? '';
const challengeTh = cs?.challenge.paragraphsTh[0] ?? challengeEn;
const approachEn = cs?.challenge.callouts[0]?.body ?? '';
const approachTh = cs?.challenge.callouts[0]?.bodyTh ?? approachEn;
const worachetMetricsMap: Record<string, { value: string; labelEn: string; labelTh: string }[]> = {
  k2o: [
    { value: '6', labelEn: 'Headliner artist posters', labelTh: 'โปสเตอร์เปิดตัวศิลปินหลัก' },
    { value: '5-Panel', labelEn: 'BTS Asok Plan B OOH motion', labelTh: 'จอ Motion 5 แผง BTS อโศก' },
    { value: yearVal || '2026', labelEn: 'S2O Festival · Bangkok', labelTh: 'S2O Festival · กรุงเทพฯ' },
  ],
  'thumbnails-posters': [
    { value: '6', labelEn: 'Netflix TH 16:9 thumbnails', labelTh: 'ปกคลิป 16:9 Netflix Thailand' },
    { value: '3', labelEn: 'Vertical 9:16 key posters', labelTh: 'โปสเตอร์รายการแนวตั้ง 9:16' },
    { value: yearVal || '2025', labelEn: 'MollageBKK · Bangkok', labelTh: 'MollageBKK · กรุงเทพฯ' },
  ],
};
const worachetMetrics = worachetMetricsMap[p.slug] ?? [
  { value: categoryVal, labelEn: 'Category', labelTh: 'ประเภทงาน' },
  { value: scopeVal, labelEn: 'Scope', labelTh: 'ขอบเขตงาน' },
  { value: yearVal || '2025', labelEn: clientLabel || 'Bangkok', labelTh: clientLabel || 'กรุงเทพฯ' },
];
const worachetRoleMap: Record<string, string> = {
  k2o: 'Graphic & Visual Designer · S2O Festival, Bangkok',
  'thumbnails-posters': 'Freelance Graphic Designer · MollageBKK, Bangkok',
};
const worachetRoleLine = worachetRoleMap[p.slug] ?? `Graphic & Visual Designer · ${clientLabel || 'Bangkok'}`;
const isWorachetMediaFirst = variant === 'worachet' && p.slug === 'thumbnails-posters';
---

<article
  class:list={[
    'project',
    'project-showcase',
    `is-${variant}`,
    { 'is-editorial': isEditorialScale, 'is-wide-canvas': p.slug === 'visual-content' },
  ]}
  id={p.slug}
  data-project-title={p.title}
  data-showcase-variant={variant}
  aria-labelledby={titleId}
>
  <div class="sp-shell">
    {variant === 'worachet' ? (
      /* ================= WORACHET-EXACT EDITORIAL LAYOUT (Projects 01 & 03) ================= */
      <div class:list={['wr-wrap', { 'is-media-first': isWorachetMediaFirst }]}>
        {isWorachetMediaFirst && heroImage && (
          <div class="wr-media-bleed">
            <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.95} threshold={0.1}>
              <a
                class="wr-media"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
                data-case-trigger
                aria-label={`Explore ${p.title}`}
                style={`--sp-pos: ${heroPos};`}
              >
                <Picture
                  name={heroImage}
                  alt={heroAlt}
                  sizes="(min-width: 1200px) 1408px, 100vw"
                />
              </a>
            </FadeContent>
          </div>
        )}

        <!-- Top Header Block (1024px editorial column) -->
        <FadeContent client:load once={false} exit={true} effect="focus" duration={0.85} threshold={0.12}>
          <header class="wr-head">
            <p class="wr-kicker">
              <span>{p.no} / 07</span>
              <span>{categoryVal}</span>
              {yearVal && <span>{yearVal}</span>}
            </p>

            <h3 id={titleId} class="wr-title">
              <a
                class="wr-title-link"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
                data-case-trigger
                aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
              >
                <span class="visually-hidden">Project {p.no}: </span>
                {p.title}
              </a>
            </h3>

            <p class="wr-subtitle">
              <span data-lang-text="en">{overviewEn}</span>
              <span data-lang-text="th">{overviewTh}</span>
            </p>
          </header>
        </FadeContent>

        <!-- Full-Bleed Oversized 16:9 Hero Image (breaks out to 1408px × 792px) -->
        {!isWorachetMediaFirst && heroImage && (
          <div class="wr-media-bleed">
            <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.95} threshold={0.1}>
              <a
                class="wr-media"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
                data-case-trigger
                aria-label={`Explore ${p.title}`}
                style={`--sp-pos: ${heroPos};`}
              >
                <Picture
                  name={heroImage}
                  alt={heroAlt}
                  sizes="(min-width: 1200px) 1408px, 100vw"
                />
              </a>
            </FadeContent>
          </div>
        )}

        <!-- 3. Bottom 12-Column Editorial Story + Metrics Grid (1024px column) -->
        <FadeContent client:load once={false} exit={true} effect="fade" blur={4} duration={0.9} threshold={0.12}>
          <div class="wr-body">
            <!-- Left 7 columns: Story Lead + 2-Col Challenge/Approach + CTA -->
            <div class="wr-story-col">
              <p class="wr-story-lead">
                <span data-lang-text="en">{storyEn}</span>
                <span data-lang-text="th">{storyTh}</span>
              </p>

              <div class="wr-subgrid">
                <div class="wr-subblock">
                  <h4 class="wr-subhead">The challenge</h4>
                  <p class="wr-subcopy">
                    <span data-lang-text="en">{challengeEn}</span>
                    <span data-lang-text="th">{challengeTh}</span>
                  </p>
                </div>

                <div class="wr-subblock">
                  <h4 class="wr-subhead">Approach</h4>
                  <p class="wr-subcopy">
                    <span data-lang-text="en">{approachEn}</span>
                    <span data-lang-text="th">{approachTh}</span>
                  </p>
                </div>
              </div>

              <div class="wr-actions">
                <a
                  class="wr-cta"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                >
                  <span>Read the full case study</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Right 4 columns (col-start-9): 3 Stacked Metrics + Role Credit -->
            <div class="wr-metrics-col">
              <dl class="wr-metrics-list">
                {worachetMetrics.map((m) => (
                  <div class="wr-metric">
                    <dt class="wr-metric-val">{m.value}</dt>
                    <dd class="wr-metric-lbl">
                      <span data-lang-text="en">{m.labelEn}</span>
                      <span data-lang-text="th">{m.labelTh}</span>
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="wr-role-line">{worachetRoleLine}</p>
            </div>
          </div>
        </FadeContent>
      </div>
    ) : variant === 'bento' ? (
      /* ================= STICKY SPLIT BENTO GRID (Project 02) ================= */
      <div class="sp-bento-layout">
        <!-- Left: 5-Tile Editorial Bento Collage -->
        <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.9} threshold={0.08}>
          <div class="sp-bento-grid">
          <!-- Row 1 Left (8 cols): Billboard Hero -->
          <a
            class="sp-bento-tile is-span-8 is-r1"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Explore ${p.title} — Billboard campaign`}
          >
            <Picture
              name="02-standup-billboard"
              alt="Startup Standup Comedy roadside billboard campaign mockup"
              sizes="(min-width: 1100px) 600px, 92vw"
            />
          </a>

          <!-- Row 1 Right (4 cols): Official Logo Lockup on Deep Ocean -->
          <a
            class="sp-bento-tile is-span-4 is-r1 is-logo-tile"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Explore ${p.title} — Logo lockup`}
          >
            <Picture
              name="02-standup-logo"
              alt="Startup Standup Comedy official logo lockup"
              sizes="(min-width: 1100px) 280px, 45vw"
            />
          </a>

          <!-- Row 2 Left (5 cols): Venue Roll-Up Banners (portrait) -->
          <a
            class="sp-bento-tile is-span-5 is-r2"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Explore ${p.title} — Roll-up banners`}
          >
            <Picture
              name="02-standup-banners"
              alt="Two roll-up banners using the Startup Standup Comedy key visual"
              sizes="(min-width: 1100px) 380px, 92vw"
            />
          </a>

          <!-- Row 2 Right (7 cols): Key Visual + Official Brand Palette Tile -->
          <div class="sp-bento-stack is-span-7 is-r2">
            <a
              class="sp-bento-tile is-kv-tile"
              href={`#project-${p.slug}`}
              data-open-case={p.slug}
              data-case-trigger
              aria-label={`Explore ${p.title} — Primary key visual`}
            >
              <Picture
                name="02-standup-kv"
                alt="Startup Standup Comedy primary key visual"
                sizes="(min-width: 1100px) 520px, 92vw"
              />
            </a>

            {p.palette && p.palette.length > 0 && (
              <div class="sp-bento-palette" aria-label={`${p.title} brand color palette`}>
                <span class="sp-bento-pal-label">Brand Palette</span>
                <div class="sp-bento-swatches">
                  {p.palette.map((sw) => (
                    <div class="sp-bento-swatch">
                      <span
                        class="sp-bento-dot"
                        style={`background:${sw.hex}`}
                        aria-hidden="true"
                      />
                      <span class="sp-bento-hex">{sw.hex}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Row 3 Full (12 cols): Brick-Wall Speaker Posters -->
          <a
            class="sp-bento-tile is-span-12 is-r3"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Explore ${p.title} — Speaker poster series`}
          >
            <Picture
              name="02-standup-wall-posters"
              alt="Three Startup Standup Comedy speaker posters mounted on a brick wall"
              sizes="(min-width: 1100px) 900px, 92vw"
            />
          </a>
          </div>
        </FadeContent>

        <!-- Right: Sticky Editorial Info Column -->
        <aside class="sp-bento-aside">
          <FadeContent client:load once={false} exit={true} effect="focus" duration={0.85} threshold={0.1}>
            <header class="sp-head">
              <p class="sp-no" aria-hidden="true">
                {p.no} / 07
              </p>
              <h3 id={titleId} class="sp-title">
                <a
                  class="sp-title-link"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                  data-case-trigger
                  aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
                >
                  <span class="visually-hidden">Project {p.no}: </span>
                  {p.title}
                </a>
              </h3>
            </header>
          </FadeContent>

          <FadeContent client:load once={false} exit={true} effect="fade" blur={2} delay={0.08} duration={0.85} threshold={0.1}>
            <div class="sp-overview-copy">
              <h4 class="sp-kicker">Overview</h4>
              <p class="sp-desc">
                <span data-lang-text="en">{overviewEn}</span>
                <span data-lang-text="th">{overviewTh}</span>
              </p>
            </div>
          </FadeContent>

          <dl class="sp-meta-col is-compact">
            <div class="sp-meta-row">
              <dt class="sp-meta-label">Category</dt>
              <dd class="sp-meta-val">{categoryVal}</dd>
            </div>
            <div class="sp-meta-row">
              <dt class="sp-meta-label">Scope</dt>
              <dd class="sp-meta-val">{scopeVal}</dd>
            </div>
            <div class="sp-meta-row">
              <dt class="sp-meta-label">Year</dt>
              <dd class="sp-meta-val">{yearVal}</dd>
            </div>
          </dl>

          <a
            class="sp-cta"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
          >
            Explore project
          </a>
        </aside>
      </div>
    ) : (
    <div class="sp-inner">
      <!-- 1. Project Index & Title -->
      <FadeContent client:load once={false} exit={true} effect="focus" duration={0.85} threshold={0.12}>
        <header class="sp-head">
          <p class="sp-no" aria-hidden="true">
            {p.no} / 07
          </p>
          <h3 id={titleId} class="sp-title">
            <a
              class="sp-title-link"
              href={`#project-${p.slug}`}
              data-open-case={p.slug}
              data-case-trigger
              aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
            >
              <span class="visually-hidden">Project {p.no}: </span>
              {p.title}
            </a>
          </h3>
        </header>
      </FadeContent>

      {variant === 'split' ? (
        /* ================= OPTION 2: HORIZONTAL SPLIT (LEFT VISUAL / RIGHT DETAILS) ================= */
        <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.9} threshold={0.1}>
          <div class="sp-split-grid">
            {heroImage && (
              <a
                class="sp-media sp-split-media"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
                data-case-trigger
                aria-label={`Explore ${p.title}`}
                style={`--sp-pos: ${heroPos};`}
              >
                <Picture
                  name={heroImage}
                  alt={heroAlt}
                  sizes="(min-width: 1100px) 760px, 92vw"
                />
              </a>
            )}

            <div class="sp-split-aside">
              <div class="sp-overview-copy">
                <h4 class="sp-kicker">Overview</h4>
                <p class="sp-desc">
                  <span data-lang-text="en">{overviewEn}</span>
                  <span data-lang-text="th">{overviewTh}</span>
                </p>
              </div>

              <dl class="sp-meta-col is-compact">
                <div class="sp-meta-row">
                  <dt class="sp-meta-label">Category</dt>
                  <dd class="sp-meta-val">{categoryVal}</dd>
                </div>
                <div class="sp-meta-row">
                  <dt class="sp-meta-label">Scope</dt>
                  <dd class="sp-meta-val">{scopeVal}</dd>
                </div>
                <div class="sp-meta-row">
                  <dt class="sp-meta-label">Year</dt>
                  <dd class="sp-meta-val">{yearVal}</dd>
                </div>
              </dl>

              <a
                class="sp-cta"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
              >
                Explore project
              </a>
            </div>
          </div>
        </FadeContent>
      ) : (
        <>
          {variant === 'bento-h' ? (
            /* ================= HORIZONTAL BENTO GRID (Project 05 Infographic) ================= */
            <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.95} threshold={0.1}>
              <div class="sp-hbento-grid">
                <!-- Left Tall 4:5 Tile: EV Sales Infographic -->
                <a
                  class="sp-bento-tile sp-hb-tall"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                  data-case-trigger
                  aria-label={`Explore ${p.title} — EV Sales Infographic`}
                >
                  <Picture
                    name="05-info-ev-sales"
                    alt="Infographic comparing electric car prices and sales in Thailand"
                    sizes="(min-width: 1100px) 480px, 92vw"
                  />
                </a>

                <!-- Center Column: 2 Stacked Editorial Infographics -->
                <div class="sp-hb-mid">
                  <a
                    class="sp-bento-tile sp-hb-mid-tile"
                    href={`#project-${p.slug}`}
                    data-open-case={p.slug}
                    data-case-trigger
                    aria-label={`Explore ${p.title} — Ethereum Roadmap`}
                  >
                    <Picture
                      name="05-info-ethereum"
                      alt="Infographic: the five stages of the Ethereum roadmap"
                      sizes="(min-width: 1100px) 480px, 92vw"
                    />
                  </a>
                  <a
                    class="sp-bento-tile sp-hb-mid-tile is-top-crop"
                    href={`#project-${p.slug}`}
                    data-open-case={p.slug}
                    data-case-trigger
                    aria-label={`Explore ${p.title} — Bitcoin Timeline`}
                  >
                    <Picture
                      name="05-info-bitcoin-timeline"
                      alt="Timeline of Bitcoin price events from 2020 to 2023"
                      sizes="(min-width: 1100px) 480px, 92vw"
                    />
                  </a>
                </div>

                <!-- Right Tall 4:5 Tile: Pixar 9 Business Lessons -->
                <a
                  class="sp-bento-tile sp-hb-tall"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                  data-case-trigger
                  aria-label={`Explore ${p.title} — Pixar Business Lessons`}
                >
                  <Picture
                    name="05-info-pixar"
                    alt="Infographic: nine business lessons from Pixar"
                    sizes="(min-width: 1100px) 480px, 92vw"
                  />
                </a>
              </div>
            </FadeContent>
          ) : isGalleryStage ? (
            /* ================= OPTION 3 / EDITORIAL: MAIN HERO + RIGHT 3-THUMBNAIL PREVIEW STRIP ================= */
            <FadeContent client:load once={false} exit={true} effect="focus" blur={4} duration={0.95} threshold={0.1}>
              <div class="sp-gallery-stage" data-sp-gallery>
                {heroImage && (
                  <a
                    class="sp-media sp-gallery-main"
                    href={`#project-${p.slug}`}
                    data-open-case={p.slug}
                    data-case-trigger
                    aria-label={`Explore ${p.title}`}
                    style={`--sp-pos: ${heroPos};`}
                  >
                    <img
                      src={galleryItems[0]?.src ?? posterUrl(heroImage)}
                      alt={galleryItems[0]?.alt ?? heroAlt}
                      class="sp-gallery-main-img"
                      data-sp-main-img
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}

                <div class="sp-thumb-rail" role="tablist" aria-label={`${p.title} preview thumbnails`}>
                  {galleryItems.map((item, idx) => (
                    <button
                      type="button"
                      role="tab"
                      class:list={['sp-thumb-btn', { 'is-active': idx === 0 }]}
                      aria-selected={idx === 0 ? 'true' : 'false'}
