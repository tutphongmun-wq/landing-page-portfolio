---
// Editorial Showcase Layout for Main Page Projects (01–03)
// Supports 3 distinct desktop composition variants for live comparison:
//   - "wide"    (Project 01): Full 1280px grid width, balanced hero height to fit 1 screen
//   - "split"   (Project 02): 2-column horizontal split (60% visual left / 40% overview + meta + CTA right)
//   - "gallery" (Project 03): 1280px grid with main hero + interactive 3-thumbnail preview strip on the right
import type { Media, Project } from '../data/projects';
import { caseStudies } from '../data/caseStudies';
import { tools } from '../data/site';
import { posterUrl } from '../lib/media';
import Picture from './Picture.astro';

export type ShowcaseVariant = 'wide' | 'split' | 'gallery';

interface Props {
  project: Project;
  variant?: ShowcaseVariant;
}

const { project: p, variant = 'wide' } = Astro.props;
const titleId = `${p.slug}-title`;
const cs = caseStudies[p.slug];

const heroImage =
  cs?.cover.kind === 'photo' || cs?.cover.kind === 'framed'
    ? cs.cover.image
    : p.media.find((m) => m.kind === 'image')?.name ?? '';

const heroAlt =
  cs?.cover.alt ??
  (p.media.find((m) => m.kind === 'image') as { alt?: string } | undefined)?.alt ??
  p.title;

const heroPos =
  p.slug === 'infographic'
    ? 'center 10%'
    : p.slug === 'visual-content'
      ? 'center 25%'
      : cs?.cover.kind === 'photo' && cs.cover.position
        ? cs.cover.position
        : 'center center';

// Curated 3 preview images for Option 3 ("gallery" variant)
const allImages = p.media.filter((m): m is Extract<Media, { kind: 'image' }> => m.kind === 'image');
const curatedGalleryMap: Record<string, { name: string; alt: string }[]> = {
  'thumbnails-posters': [
    { name: '03-thumbs-netflix-snow', alt: 'Netflix Thailand snow challenge Sapporo trip thumbnail' },
    { name: '03-thumbs-masterchef', alt: 'MasterChef The Professionals Thailand thumbnail' },
    { name: '03-thumbs-netflix-codex', alt: 'Netflix Thailand six technologies thumbnail' },
  ],
  'visual-content': [
    { name: '04-content-post-tree-of-alpha', alt: 'Newspaper collage visual for Tree of Alpha' },
    { name: '04-content-buyback', alt: 'Crypto buyback and token burn flaming Bitcoin visual' },
    { name: '04-content-call-center', alt: 'Call-center scam psychology red editorial visual' },
  ],
  infographic: [
    { name: '05-info-ev-sales', alt: 'Electric car prices and sales in Thailand infographic' },
    { name: '05-info-pixar', alt: 'Nine business lessons from Pixar infographic' },
    { name: '05-info-ethereum', alt: 'Five stages of the Ethereum roadmap infographic' },
  ],
  '16-personalities': [
    { name: '06-16p-cover', alt: 'Stack of 16 Personalities books with colorful rounded cover' },
    { name: '06-16p-spread-purple', alt: 'Purple book spread for the INTP type with DNA graphics' },
    { name: '06-16p-spread-yellow', alt: 'Yellow book spread featuring desert adventurer character' },
  ],
  'sybil-husky': [
    { name: '07-sybil-bg-night', alt: 'Sybil Husky 4K Arctic fortress under the northern lights (Night mode)' },
    { name: '07-sybil-bg-day', alt: 'Sybil Husky 4K Arctic fortress at alpine sunrise (Day mode)' },
    { name: '07-sybil-landing', alt: 'Sybil Husky Next.js landing page UI overview' },
  ],
};

const galleryItems = (
  curatedGalleryMap[p.slug] ??
  [heroImage, ...allImages.map((m) => m.name).filter((n) => n !== heroImage)]
    .slice(0, 3)
    .map((name) => ({
      name,
      alt: allImages.find((m) => m.name === name)?.alt ?? p.title,
    }))
)
  .map((item) => ({ ...item, src: posterUrl(item.name) }))
  .filter((item) => Boolean(item.src));

const categoryVal = cs?.meta.find((m) => m.label.toLowerCase() === 'category')?.value ?? 'Design';
const scopeVal = cs?.meta.find((m) => m.label.toLowerCase() === 'scope')?.value ?? p.role[0] ?? '';
const toolsVal = p.tools.map((t) => tools[t]?.name ?? t).join(', ');

const overviewEn = cs?.subtitle ?? (Array.isArray(p.description) ? p.description[0] : p.description);
const overviewTh = cs?.subtitleTh ?? (Array.isArray(p.descriptionTh) ? p.descriptionTh[0] : p.descriptionTh);
---

<article
  class:list={['project', 'project-showcase', `is-${variant}`]}
  id={p.slug}
  data-project-title={p.title}
  data-showcase-variant={variant}
  aria-labelledby={titleId}
>
  <div class="sp-shell">
    <div class="sp-inner">
      <!-- 1. Project Index & Title -->
      <header class="sp-head">
        <p class="sp-no" aria-hidden="true" data-reveal>
          {p.no}
        </p>
        <h3 id={titleId} class="sp-title" data-reveal style="--reveal-d: 50ms">
          <a
            class="sp-title-link"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
          >
            <span class="visually-hidden">Project {p.no}: </span>
            {p.title}
          </a>
        </h3>
      </header>

      {variant === 'split' ? (
        /* ================= OPTION 2: HORIZONTAL SPLIT (LEFT VISUAL / RIGHT DETAILS) ================= */
        <div class="sp-split-grid" data-reveal style="--reveal-d: 90ms">
          {heroImage && (
            <a
              class="sp-media sp-split-media"
              href={`#project-${p.slug}`}
              data-open-case={p.slug}
              data-case-trigger
              aria-label={`Explore ${p.title}`}
              style={`--sp-pos: ${heroPos};`}
            >
              <Picture
                name={heroImage}
                alt={heroAlt}
                sizes="(min-width: 1100px) 760px, 92vw"
              />
            </a>
          )}

          <div class="sp-split-aside">
            <div class="sp-overview-copy">
              <h4 class="sp-kicker">Overview</h4>
              <p class="sp-desc">
                <span data-lang-text="en">{overviewEn}</span>
                <span data-lang-text="th">{overviewTh}</span>
              </p>
            </div>

            <dl class="sp-meta-col is-compact">
              <div class="sp-meta-row">
                <dt class="sp-meta-label">Category</dt>
                <dd class="sp-meta-val">{categoryVal}</dd>
              </div>
              <div class="sp-meta-row">
                <dt class="sp-meta-label">Scope</dt>
                <dd class="sp-meta-val">{scopeVal}</dd>
              </div>
              <div class="sp-meta-row">
                <dt class="sp-meta-label">Tools</dt>
                <dd class="sp-meta-val">{toolsVal}</dd>
              </div>
            </dl>

            <a
              class="sp-cta"
              href={`#project-${p.slug}`}
              data-open-case={p.slug}
            >
              Explore project
            </a>
          </div>
        </div>
      ) : (
        <>
          {variant === 'gallery' ? (
            /* ================= OPTION 3: MAIN HERO + RIGHT 3-THUMBNAIL PREVIEW STRIP ================= */
            <div class="sp-gallery-stage" data-sp-gallery data-reveal style="--reveal-d: 90ms">
              {heroImage && (
                <a
                  class="sp-media sp-gallery-main"
                  href={`#project-${p.slug}`}
                  data-open-case={p.slug}
                  data-case-trigger
                  aria-label={`Explore ${p.title}`}
                  style={`--sp-pos: ${heroPos};`}
                >
                  <img
                    src={galleryItems[0]?.src ?? posterUrl(heroImage)}
                    alt={galleryItems[0]?.alt ?? heroAlt}
                    class="sp-gallery-main-img"
                    data-sp-main-img
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}

              <div class="sp-thumb-rail" role="tablist" aria-label={`${p.title} preview thumbnails`}>
                {galleryItems.map((item, idx) => (
                  <button
                    type="button"
                    role="tab"
                    class:list={['sp-thumb-btn', { 'is-active': idx === 0 }]}
                    aria-selected={idx === 0 ? 'true' : 'false'}
                    aria-label={`Preview ${idx + 1}: ${item.alt}`}
                    data-sp-thumb
                    data-src={item.src}
                    data-alt={item.alt}
                  >
                    <Picture
                      name={item.name}
                      alt=""
                      sizes="(min-width: 900px) 248px, 32vw"
                    />
                  </button>
                ))}
              </div>
            </div>
          ) : (
            /* ================= OPTION 1: FULL-GRID 1280PX WIDE HERO ================= */
            heroImage && (
              <a
                class="sp-media sp-wide-media"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
                data-case-trigger
                aria-label={`Explore ${p.title}`}
                data-reveal
                style={`--reveal-d: 90ms; --sp-pos: ${heroPos};`}
              >
                <Picture
                  name={heroImage}
                  alt={heroAlt}
                  sizes="(min-width: 1100px) 1280px, 92vw"
                />
              </a>
            )
          )}

          <!-- Bottom Two-Column Info Row (Full-Width Flush with Hero) -->
          <div class="sp-bottom" data-reveal style="--reveal-d: 140ms">
            <div class="sp-overview-col">
              <div class="sp-overview-copy">
                <h4 class="sp-kicker">Overview</h4>
                <p class="sp-desc">
                  <span data-lang-text="en">{overviewEn}</span>
                  <span data-lang-text="th">{overviewTh}</span>
                </p>
              </div>

              <a
                class="sp-cta"
                href={`#project-${p.slug}`}
                data-open-case={p.slug}
              >
                Explore project
              </a>
            </div>

            <dl class="sp-meta-col">
              <div class="sp-meta-row">
                <dt class="sp-meta-label">Category</dt>
                <dd class="sp-meta-val">{categoryVal}</dd>
              </div>

              <div class="sp-meta-row">
                <dt class="sp-meta-label">Scope</dt>
                <dd class="sp-meta-val">{scopeVal}</dd>
              </div>

              <div class="sp-meta-row">
                <dt class="sp-meta-label">Tools</dt>
                <dd class="sp-meta-val">{toolsVal}</dd>
              </div>
            </dl>
          </div>
        </>
      )}
    </div>
  </div>
</article>

<script>
  // Interactive thumbnail switcher for Option 3 ("gallery" variant)
  document.querySelectorAll<HTMLElement>('[data-sp-gallery]').forEach((stage) => {
    const mainImg = stage.querySelector<HTMLImageElement>('[data-sp-main-img]');
    const thumbs = [...stage.querySelectorAll<HTMLButtonElement>('[data-sp-thumb]')];
    if (!mainImg || !thumbs.length) return;

    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextSrc = btn.dataset.src;
        const nextAlt = btn.dataset.alt ?? '';
        if (!nextSrc || mainImg.getAttribute('src') === nextSrc) return;

        thumbs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        mainImg.classList.add('is-swapping');
        window.setTimeout(() => {
          mainImg.src = nextSrc;
          mainImg.alt = nextAlt;
          mainImg.classList.remove('is-swapping');
        }, 120);
      });
    });
  });
</script>

<style>
  .project-showcase {
    padding-block: clamp(44px, 5vw, 68px);
    padding-inline: var(--gutter);
    scroll-margin-top: 40px;
  }

  .sp-shell {
    width: 100%;
    max-width: var(--max-w);
    margin-inline: auto;
  }

  .sp-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.4vw, 30px);
  }

  /* 1. Header */
  .sp-head {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .sp-no {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 600;
    font-size: clamp(1.0625rem, 1.35vw, 1.375rem);
    line-height: 1.1;
    color: var(--c-accent);
    letter-spacing: 0.01em;
  }

  .sp-title {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 600;
    font-size: clamp(1.85rem, 3.6vw, 3.25rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    color: var(--c-fg);
  }

  .sp-title-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .sp-title-link:hover {
    opacity: 0.82;
  }
  .sp-title-link:focus-visible {
    outline: none;
    box-shadow: var(--focus);
    border-radius: 6px;
  }

  /* Shared Hero Media Frame */
  .sp-media {
    position: relative;
    display: block;
    width: 100%;
    border-radius: clamp(18px, 2.2vw, 28px);
    overflow: hidden;
    background: var(--c-bg-raised);
    border: 1px solid var(--c-line);
    box-shadow: 0 16px 40px var(--c-shadow-soft);
    text-decoration: none;
  }
  .sp-media:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }
  .sp-media :global(picture),
  .sp-media :global(img),
  .sp-gallery-main-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--sp-pos, center center);
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease;
  }
  .sp-media:hover :global(img),
  .sp-media:hover .sp-gallery-main-img {
    transform: scale(1.022);
  }

  /* ================= OPTION 1 ("wide") ================= */
  .sp-wide-media {
    aspect-ratio: 21 / 9.4;
    max-height: 50vh;
  }

  /* ================= OPTION 2 ("split") ================= */
  .sp-split-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.48fr) minmax(0, 1fr);
    gap: clamp(28px, 3.8vw, 52px);
    align-items: stretch;
  }

  .sp-split-media {
    aspect-ratio: 16 / 10.5;
    height: 100%;
    min-height: 360px;
  }

  .sp-split-aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-block: 4px;
  }

  /* ================= OPTION 3 ("gallery") ================= */
  .sp-gallery-stage {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 248px;
    gap: 16px;
    align-items: stretch;
  }

  .sp-gallery-main {
    aspect-ratio: 16 / 9;
    max-height: 52vh;
  }

  .sp-gallery-main-img.is-swapping {
    opacity: 0.35;
  }

  .sp-thumb-rail {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-height: 52vh;
  }

  .sp-thumb-btn {
    position: relative;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 16px;
    overflow: hidden;
    background: var(--c-bg-raised);
    cursor: pointer;
    opacity: 0.68;
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms ease;
  }
  .sp-thumb-btn :global(picture),
  .sp-thumb-btn :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sp-thumb-btn:hover {
    opacity: 0.94;
    transform: translateY(-2px);
  }
  .sp-thumb-btn.is-active {
    opacity: 1;
    border-color: var(--c-accent);
    box-shadow: 0 8px 20px var(--c-shadow-soft);
  }
  .sp-thumb-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }

  /* ================= BOTTOM TWO-COLUMN INFO ROW (Options 1 & 3) ================= */
  .sp-bottom {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.38fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .sp-overview-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.2vw, 28px);
  }

  .sp-overview-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .sp-kicker {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.1;
    color: var(--c-accent);
  }

  .sp-desc {
    margin: 0;
    font-family: var(--f-nav);
    font-weight: 500;
    font-size: clamp(0.95rem, 1.08vw, 1.0625rem);
    line-height: 1.48;
    color: var(--c-fg);
    max-width: 56ch;
  }
  :global(:root[data-lang='th']) .sp-desc {
    font-family: var(--f-body);
    line-height: 1.65;
  }

  /* Explore project pill CTA */
  .sp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 224px;
    min-height: 62px;
    padding: 14px 32px;
    border-radius: 999px;
    background: var(--c-fg);
    color: var(--c-bg);
    font-family: var(--f-clash);
    font-weight: 500;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sp-cta:hover {
    background: var(--c-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .sp-cta:active {
    transform: translateY(0);
  }
  .sp-cta:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }

  /* Right Metadata Column */
  .sp-meta-col {
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sp-meta-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 13px;
    border-bottom: 1.5px solid var(--c-line);
  }
  .sp-meta-col.is-compact .sp-meta-row {
    gap: 6px;
    padding-block: 11px;
  }
  .sp-meta-row:first-child {
    padding-top: 0;
  }
  .sp-meta-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  :global(:root[data-theme='dark']) .sp-meta-row {
    border-bottom-color: #5a5a5a;
  }

  .sp-meta-label {
    margin: 0;
    font-family: var(--f-clash);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.1;
    color: var(--c-accent);
  }

  .sp-meta-val {
    margin: 0;
    font-family: var(--f-nav);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.32;
    color: var(--c-fg);
  }
  .sp-meta-col.is-compact .sp-meta-val {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 1024px) {
    .sp-split-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .sp-split-media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
    .sp-gallery-stage {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .sp-gallery-main,
    .sp-wide-media {
      aspect-ratio: 16 / 9;
      max-height: none;
    }
    .sp-thumb-rail {
      grid-template-rows: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-height: none;
      gap: 10px;
    }
    .sp-thumb-btn {
      aspect-ratio: 16 / 9;
      border-radius: 12px;
    }
  }

  @media (max-width: 820px) {
    .sp-bottom {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .sp-cta {
      min-width: 200px;
      min-height: 54px;
      padding: 12px 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-media :global(img),
    .sp-gallery-main-img,
    .sp-thumb-btn,
    .sp-cta {
      transition: none;
    }
  }
</style>
