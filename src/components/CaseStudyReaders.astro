    color: color-mix(in srgb, var(--cs-fg) 30%, transparent);
  }
  .cs-hook-rail.is-accent {
    color: var(--cs-accent);
  }
  .cs-hook-stem {
    position: absolute;
    left: 2px;
    top: 0;
    width: 1px;
    background-image: repeating-linear-gradient(
      to top,
      transparent 0 2px,
      currentColor 2px 4px
    );
  }
  .cs-hook-corner {
    position: absolute;
    left: 2px;
    top: 0;
    overflow: visible;
  }
  .cs-hook-item {
    display: block;
    border-radius: 8px;
    padding: 6px 8px 6px 20px;
    text-align: left;
    font: 400 14px / 1.4 var(--f-nav);
    color: color-mix(in srgb, var(--cs-fg) 52%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cs-hook-item:hover {
    color: color-mix(in srgb, var(--cs-fg) 84%, transparent);
  }
  .cs-hook-item.is-active {
    color: var(--cs-fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-hook-rail,
    .cs-hook-item {
      transition: none;
    }
  }

  .cs-side-foot {
    display: grid;
    gap: 16px;
  }
  .cs-live-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--cs-surface);
    border: 1px solid transparent;
    color: var(--cs-fg);
    font: 500 13px / 1.2 var(--f-nav);
    text-decoration: none;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .cs-live-pill:hover {
    background: var(--cs-surface-2);
    color: var(--cs-accent);
  }

  .cs-next {
    display: grid;
    gap: 4px;
    padding-left: 12px;
    text-decoration: none;
    color: var(--cs-fg);
  }
  .cs-next-lbl {
    font: 400 12px / 1.2 var(--f-nav);
    color: var(--cs-muted);
  }
  .cs-next-title {
    font: 400 14px / 1.3 var(--f-nav);
    color: var(--cs-fg);
    transition: color 0.16s ease;
  }
  .cs-next:hover .cs-next-title {
    color: var(--cs-accent);
  }

  /* Right Scrollable Reading Area */
  .cs-scroller {
    height: 100dvh;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
    padding: 0 0 120px;
    box-sizing: border-box;
  }
  .cs-scroller:focus,
  .cs-scroller:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .cs-scope {
    display: block;
    width: 100%;
  }

  /* Centered 864px media column with 60px outer breathing room */
  .cs-pad,
  .cs-article {
    width: 100%;
    max-width: calc(864px + 120px);
    padding-inline: 60px;
    box-sizing: border-box;
    margin-inline: auto;
  }

  .cs-article {
    margin-top: 72px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 72px;
  }

  .cs-sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    scroll-margin-top: 48px;
  }
  .cs-sec-overview {
    scroll-margin-top: 0;
  }

  /* Left-aligned 720px text column centered inside the 864px media frame */
  .cs-h1,
  .cs-subtitle,
  .cs-meta-grid,
  .cs-h2,
  .cs-prose,
  .cs-callout-grid,
  .cs-tools-bar,
  .cs-foot-nav,
  .cs-sec-head-row,
  .cs-figure figcaption {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    text-align: left;
  }

  .cs-sec-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cs-sec-head-row .cs-h2 {
    width: auto;
    margin: 0;
  }

  /* ================= Full-Width Flush-Top Cover Banner (486px, Flat) ================= */
  .cs-hero-banner {
    position: relative;
    width: 100%;
    height: 486px;
    border-radius: 0;
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: none;
  }
  .cs-hero-banner.is-logo {
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 56px);
  }
  .cs-hero-logo {
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: contain;
  }

  .cs-hero-banner.is-photo :global(picture),
  .cs-hero-banner.is-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cover-pos, center center);
  }
  .cs-hero-banner.is-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.04) 0%, rgb(0 0 0 / 0) 60%, rgb(0 0 0 / 0.18) 100%);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .cs-hero-banner.is-photo::after {
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.08) 0%,
      rgb(0 0 0 / 0) 55%,
      color-mix(in srgb, var(--cs-bg) 56%, transparent) 100%
    );
  }

  .cs-hero-banner.is-framed {
    display: grid;
    place-items: center;
    padding: 36px 48px;
  }
  .cs-hero-framed-inner {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }
  .cs-hero-framed-inner :global(picture),
  .cs-hero-framed-inner :global(img) {
    display: block;
    max-width: 100%;
    max-height: 414px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: none;
  }

  .cs-hero-banner.is-trio {
    display: grid;
    place-items: center;
    padding: 36px 48px;
  }
  .cs-hero-trio {
    width: 100%;
    max-width: 960px;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .cs-trio-card {
    height: 356px;
    border-radius: 12px;
    overflow: hidden;
    background: #1c1a18;
    border: 0;
    box-shadow: none;
    transform: translateY(8px);
  }
  .cs-trio-card.is-center {
    height: 396px;
    transform: translateY(-4px);
    box-shadow: none;
  }
  .cs-hero-trio.is-square {
    max-width: 1020px;
  }
  .cs-hero-trio.is-square .cs-trio-card {
    height: auto;
    aspect-ratio: 1 / 1;
  }
  .cs-hero-trio.is-square .cs-trio-card.is-center {
    height: auto;
    aspect-ratio: 1 / 1;
    transform: translateY(-8px) scale(1.04);
  }
  .cs-trio-card :global(picture),
  .cs-trio-card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ================= Editorial Typography (Clash Display 600 + Satoshi 400/500/700) ================= */
  .cs-h1 {
    margin: 12px auto 0;
    font-family: var(--f-clash);
    font-weight: 600;
    font-size: clamp(38px, 4.6vw, 56px);
    line-height: 1.04;
    letter-spacing: 0.01em;
    color: var(--cs-fg);
  }

  .cs-subtitle {
    margin: -8px auto 0;
    font: 400 clamp(16px, 1.4vw, 19px) / 1.55 var(--f-nav);
    color: var(--cs-muted);
  }

  .cs-meta-grid {
    margin: 8px auto;
    padding-block: 20px;
    border-top: 1px solid var(--cs-line);
    border-bottom: 1px solid var(--cs-line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .cs-meta-grid dt {
    font: 400 12px / 1.3 var(--f-nav);
    color: var(--cs-muted);
    margin-bottom: 4px;
  }
  .cs-meta-grid dd {
    margin: 0;
    font: 500 14px / 1.45 var(--f-nav);
    color: var(--cs-fg);
  }

  .cs-h2 {
    margin: 0 auto;
    font-family: var(--f-clash);
    font-weight: 600;
    font-size: clamp(26px, 2.7vw, 34px);
    line-height: 1.12;
    letter-spacing: 0.01em;
    color: var(--cs-fg);
  }

  .cs-prose {
    margin: 0 auto;
    font: 400 clamp(16px, 1.2vw, 18px) / 1.7 var(--f-nav);
    color: var(--cs-fg-soft);
  }

  .cs-callout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 4px;
  }
  .cs-callout {
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
    display: grid;
    gap: 8px;
  }
  .cs-callout h3 {
    margin: 0;
    font-family: var(--f-nav);
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.35;
    letter-spacing: 0;
    color: var(--cs-accent);
  }
  .cs-callout p {
    margin: 0;
    font: 400 14px / 1.55 var(--f-nav);
    color: var(--cs-fg-soft);
  }

  /* ================= Segmented Control Pill ================= */
  .cs-seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border-radius: 999px;
    background: var(--cs-surface);
    border: 1px solid transparent;
  }
  .cs-seg-btn {
    border: 0;
    border-radius: 999px;
    padding: 7px 14px;
    background: transparent;
    color: var(--cs-muted);
    font: 500 12.5px / 1 var(--f-nav);
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .cs-seg-btn:hover {
    color: var(--cs-fg);
  }
  .cs-seg-btn.is-active {
    background: var(--cs-fg);
    color: var(--cs-bg);
  }

  /* ================= Figures, Full-Bleed Galleries & Interactive Media (864px, Flat) ================= */
  .cs-figure {
    margin: 8px 0 0;
    display: grid;
    gap: 12px;
  }
  .cs-img-box {
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-img-box :global(picture),
  .cs-img-box :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cs-figure figcaption {
    font: 400 13px / 1.45 var(--f-nav);
    color: var(--cs-muted);
  }

  .cs-zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    transition: filter 0.2s ease, transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-zoom:hover {
    filter: brightness(1.06);
  }
  .cs-zoom:focus-visible {
    outline: 2px solid var(--cs-accent);
    outline-offset: -2px;
  }

  /* Multi-column Galleries (Full-bleed edge-to-edge, no inner padding or borders) */
  .cs-gallery {
    display: grid;
    gap: 16px;
  }
  .cs-gallery.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cs-gallery.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .cs-gallery-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-gallery-media {
    position: relative;
    flex: 1;
    width: 100%;
    overflow: hidden;
    background: var(--cs-surface-2);
  }
  .cs-gallery-media :global(picture),
  .cs-gallery-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-gallery.is-contain .cs-gallery-media {
    display: grid;
    place-items: center;
    padding: 0;
    box-sizing: border-box;
    min-height: 0;
  }
  .cs-gallery.is-contain .cs-gallery-media :global(picture),
  .cs-gallery.is-contain .cs-gallery-media :global(img) {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }
  .cs-gallery-lbl {
    display: block;
    padding: 10px 14px;
    background: var(--cs-surface);
    border-top: 0;
    font: 500 12.5px / 1.3 var(--f-nav);
    color: var(--cs-fg-soft);
  }

  .cs-palette-wrap {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid transparent;
  }
  .cs-reader :global(.bencho-palette),
  :global(:root[data-theme='dark']) .cs-reader :global(.bencho-palette) {
    background: var(--cs-surface);
    border-color: transparent;
  }
  .cs-reader :global(.bp-capsule),
  .cs-reader :global(.bp-shuffle),
  :global(:root[data-theme='dark']) .cs-reader :global(.bp-capsule),
  :global(:root[data-theme='dark']) .cs-reader :global(.bp-shuffle) {
    background: var(--cs-surface-2);
    color: var(--cs-fg);
    border-color: transparent;
    box-shadow: none;
  }
  .cs-reader :global(.bp-swatch),
  :global(:root[data-theme='dark']) .cs-reader :global(.bp-swatch) {
    border-color: transparent;
  }
  .cs-reader :global(.bp-swatch:hover),
  :global(:root[data-theme='dark']) .cs-reader :global(.bp-swatch:hover) {
    box-shadow: none;
  }

  .cs-media-frame {
    border-radius: 16px;
    overflow: hidden;
    background: #141414;
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-media-frame :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .cs-model-frame {
    width: 100%;
    height: 520px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-model-frame :global(.model-slot) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
  }

  .cs-map-frame {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-map-frame :global(.fmap) {
    border-radius: 0;
  }
  @media (min-width: 780px) {
    .cs-map-frame :global(.fmap) {
      grid-template-columns: minmax(0, 1.32fr) minmax(248px, 0.92fr);
      height: 580px;
    }
    .cs-map-frame :global(.fm-stage) {
      height: 100%;
      aspect-ratio: auto;
    }
    .cs-map-frame :global(.fm-panel) {
      overflow-y: auto;
      border-top: 0;
    }
  }

  /* ================= Sybil Husky Specific Interactive Blocks ================= */
  .cs-world-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-world-layer {
    position: absolute;
    inset: 0;
    transition: opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-world-layer :global(picture),
  .cs-world-layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-world-stage[data-world-stage='night'] .is-day {
    opacity: 0;
    pointer-events: none;
  }
  .cs-world-stage[data-world-stage='day'] .is-night {
    opacity: 0;
    pointer-events: none;
  }

  .cs-char-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .cs-char-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: 14px;
    background: var(--cs-surface);
    border: 1px solid transparent;
  }
  .cs-char-thumb {
    width: 68px;
    height: 68px;
    border-radius: 10px;
    overflow: hidden;
    flex: none;
    background: var(--cs-surface-2);
  }
  .cs-char-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs-char-meta {
    display: grid;
    gap: 3px;
    min-width: 0;
    text-align: left;
  }
  .cs-char-badge {
    font: 700 11px / 1 var(--f-nav);
    color: var(--cs-accent);
  }
  .cs-char-meta strong {
    font: 500 14px / 1.2 var(--f-nav);
    color: var(--cs-fg);
  }
  .cs-char-stats {
    font: 400 12px / 1.3 var(--f-nav);
    color: var(--cs-muted);
  }

  .cs-browser-frame {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
  }
  .cs-browser-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--cs-surface);
    border-bottom: 1px solid var(--cs-line);
  }
  .cs-browser-dots {
    display: flex;
    gap: 6px;
  }
  .cs-browser-dots span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--cs-line-strong);
  }
  .cs-browser-url {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--cs-surface-2);
    border: 1px solid transparent;
    font: 500 12px / 1 var(--f-nav);
    color: var(--cs-fg-soft);
  }
  .cs-live-badge {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--cs-accent-soft);
    color: var(--cs-accent);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .cs-browser-open {
    font: 500 12.5px / 1 var(--f-nav);
    color: var(--cs-fg);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--cs-surface-2);
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .cs-browser-open:hover {
    background: var(--cs-accent);
    color: #ffffff;
  }

  .cs-iframe-stage {
    position: relative;
    width: 100%;
    height: 540px;
    overflow: hidden;
    background: #141414;
  }
  .cs-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1200px;
    border: 0;
    transform-origin: top left;
    transform: scale(0.45);
  }
  .cs-shot-stage :global(picture),
  .cs-shot-stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ================= Outcome Tools Bar ================= */
  .cs-tools-bar {
    margin-top: 8px;
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--cs-surface);
    border: 1px solid transparent;
    box-shadow: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
  }
  .cs-tools-lbl {
    font: 500 13px / 1 var(--f-nav);
    color: var(--cs-muted);
  }
  .cs-tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cs-tool-pill {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--cs-surface-2);
    border: 1px solid transparent;
    font: 400 13px / 1.2 var(--f-nav);
    color: var(--cs-fg);
  }
  .cs-tool-pill strong {
    font-family: var(--f-nav);
    font-weight: 500;
    color: var(--cs-accent);
    margin-right: 4px;
  }

  /* Bottom Editorial Previous / Next Project Navigation */
  .cs-foot-nav {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--cs-line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    box-sizing: border-box;
  }
  .cs-foot-link {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: var(--cs-fg);
    min-width: 0;
  }
  .cs-foot-link.is-prev {
    justify-items: start;
    text-align: left;
  }
  .cs-foot-link.is-next {
    justify-items: end;
    text-align: right;
  }
  .cs-foot-lbl {
    font: 500 12px / 1.2 var(--f-nav);
    color: var(--cs-muted);
  }
  .cs-foot-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 18px / 1.25 var(--f-display);
    letter-spacing: 0.01em;
    color: var(--cs-fg);
    transition: color 0.16s ease;
  }
  .cs-foot-arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-foot-link:hover .cs-foot-title {
    color: var(--cs-accent);
  }
  .cs-foot-link.is-prev:hover .cs-foot-arrow {
    transform: translateX(-3px);
  }
  .cs-foot-link.is-next:hover .cs-foot-arrow {
    transform: translateX(3px);
  }

  /* ================= Full-Bleed Per-Section Aspect & Grid Alignment ================= */
  /* 01 K2O Identity: uniform 4:5 full-bleed cards; Primary Mark sits on seamless #000 */
  #k2o-identity .cs-gallery.is-contain .cs-gallery-media,
  #startup-standup-identity .cs-gallery.is-contain .cs-gallery-media {
    aspect-ratio: 4 / 5;
  }
  #k2o-identity .cs-gallery.is-contain .cs-gallery-card:nth-child(2) .cs-gallery-media,
