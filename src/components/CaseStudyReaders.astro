---
// Unified Full-Screen Editorial Case Study Reader for ALL 7 projects (#project-<slug>)
// + Floating Cursor Tooltip ("Click to Explore full project") triggered on main Work titles.
//
// Layout matches the approved Sybil Husky reader architecture:
//   - Left sticky navigation sidebar (256px): Back to All work, Project Name, live TOC, optional Live Site pill, Next project
//   - Right scrollable reading pane:
//       - Flush-top, edge-to-edge full-width cover banner (486px height)
//       - Centered 720px left-aligned editorial text column
//       - Centered 864px media breakout column (+20% wider than text)
import Picture from './Picture.astro';
import Palette from './Palette.astro';
import VideoSlot from './VideoSlot.astro';
import ModelSlot from './ModelSlot.astro';
import FestivalMap from './FestivalMap.astro';
import BookFlipbook from './BookFlipbook.astro';
import PosterDeck from './PosterDeck.astro';
import ImageCompare from './ImageCompare.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { projects } from '../data/projects';
import { caseStudies } from '../data/caseStudies';
import { tools } from '../data/site';
import { assetUrl, posterUrl } from '../lib/media';

const sybilMintTiers = [
  {
    badge: 'Tier 01 · Apprentice',
    title: 'Siberian Apprentice',
    img: assetUrl('media/07-sybil-char-apprentice.webp'),
    stats: '100 Runes · $100 · Base Tier',
  },
  {
    badge: 'Tier 02 · Mage',
    title: 'Siberian Mage',
    img: assetUrl('media/07-sybil-char-mage.webp'),
    stats: 'Bonus Frost Gear · Companion',
  },
  {
    badge: 'Tier 03 · Sorcerer',
    title: 'Siberian Sorcerer',
    img: assetUrl('media/07-sybil-char-sorcerer.webp'),
    stats: '660 Runes · $600 · +10% Bonus',
  },
  {
    badge: 'Tier 04 · Supreme',
    title: 'Siberian Supreme',
    img: assetUrl('media/07-sybil-char-supreme.webp'),
    stats: '1,820 Runes · $1,400 · +30% Bonus',
  },
  {
    badge: 'Special · Detective',
    title: 'Detective Husky',
    img: assetUrl('media/07-sybil-char-special.webp'),
    stats: 'Limited Lore Edition',
  },
  {
    badge: 'Super Special · Cosmic',
    title: 'Cosmic Archmage',
    img: assetUrl('media/07-sybil-char-super-special.webp'),
    stats: 'Ultra-Rare Collector Tier',
  },
  {
    badge: 'Edition · Baby 01',
    title: 'Baby Husky (Ember)',
    img: assetUrl('media/07-sybil-char-baby1.webp'),
    stats: 'Cream BG Community Edition',
  },
  {
    badge: 'Edition · Baby 02',
    title: 'Baby Husky (Frost)',
    img: assetUrl('media/07-sybil-char-baby2.webp'),
    stats: 'Cream BG Community Edition',
  },
];

const sybilCardItems = [
  {
    image: '07-sybil-card-apprentice',
    alt: 'Sybil Husky Tier 01 Apprentice collectible card',
    label: 'Apprentice · Tier 01',
  },
  {
    image: '07-sybil-card-mage',
    alt: 'Sybil Husky Tier 02 Mage collectible card',
    label: 'Mage · Tier 02',
  },
  {
    image: '07-sybil-card-sorcerer',
    alt: 'Sybil Husky Tier 03 Sorcerer collectible card',
    label: 'Sorcerer · Tier 03',
  },
  {
    image: '07-sybil-card-supreme',
    alt: 'Sybil Husky Tier 04 Supreme collectible card',
    label: 'Supreme · Tier 04',
  },
  {
    image: '07-sybil-card-special',
    alt: 'Sybil Husky Special Detective collectible card',
    label: 'Special Edition',
  },
  {
    image: '07-sybil-card-super-special',
    alt: 'Sybil Husky Super Special Cosmic collectible card',
    label: 'Super Special Edition',
  },
];
---

<!-- Singleton Floating Cursor Tooltip for Project Titles -->
<div class="case-cursor-tip" data-case-cursor-tip aria-hidden="true">
  Click to Explore full project
</div>

<!-- Full-Screen Editorial Case Study Dialogs (#project-<slug>) -->
{
  projects.map((p, idx) => {
    const cs = caseStudies[p.slug];
    if (!cs) return null;
    const prevProject = projects[(idx - 1 + projects.length) % projects.length];
    const nextProject = projects[(idx + 1) % projects.length];
    const tocItems = [
      { id: `${p.slug}-overview`, label: 'Overview' },
      { id: `${p.slug}-challenge`, label: 'The challenge' },
      ...cs.sections.map((s) => ({ id: `${p.slug}-${s.id}`, label: s.tocLabel })),
      { id: `${p.slug}-outcome`, label: 'Outcome' },
    ];

    return (
      <dialog
        class="cs-reader"
        data-case-dialog={p.slug}
        aria-labelledby={`cs-title-${p.slug}`}
      >
        <div class="cs-layout">
          <!-- Left Sticky Navigation Sidebar -->
          <aside class="cs-sidebar" aria-label={`${p.title} project navigation`}>
            <div class="cs-side-top">
              <button type="button" class="cs-back" data-close-case={p.slug}>
                <span aria-hidden="true">←</span>
                <span>All projects</span>
              </button>
              <div class="cs-side-tools">
                <LangToggle variant="compact" />
                <ThemeToggle compact />
              </div>
            </div>

            <div class="cs-toc-wrap">
              <p class="cs-proj-name">{cs.sidebarName}</p>
              <nav aria-label="Table of contents">
                <div class="cs-hook-list" data-hook-sidebar>
                  <span class="cs-hook-rail is-hover" data-hook-rail="hover" aria-hidden="true">
                    <span class="cs-hook-stem" data-hook-stem></span>
                    <svg width="12" height="7" viewBox="0 0 12 7" fill="none" class="cs-hook-corner" data-hook-corner>
                      <path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
                    </svg>
                  </span>
                  <span class="cs-hook-rail is-accent" data-hook-rail="active" aria-hidden="true">
                    <span class="cs-hook-stem" data-hook-stem></span>
                    <svg width="12" height="7" viewBox="0 0 12 7" fill="none" class="cs-hook-corner" data-hook-corner>
                      <path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
                    </svg>
                  </span>
                  {tocItems.map((item, tIdx) => (
                    <a
                      href={`#${item.id}`}
                      class:list={['cs-hook-item', { 'is-active': tIdx === 0 }]}
                      data-cs-toc={item.id}
                      data-hook-item
                      aria-current={tIdx === 0 ? 'location' : undefined}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </nav>
            </div>

            <div class="cs-side-foot">
              {cs.liveUrl && (
                <a href={cs.liveUrl.href} rel="noopener" target="_blank" class="cs-live-pill">
                  <span>{cs.liveUrl.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              <a
                href={`#project-${nextProject.slug}`}
                class="cs-next"
                data-next-case={nextProject.slug}
              >
                <span class="cs-next-lbl">Next project</span>
                <span class="cs-next-title">
                  {nextProject.spine.label} <span aria-hidden="true">→</span>
                </span>
              </a>
            </div>
          </aside>

          <!-- Right Scrollable Editorial Reading Column -->
          <div class="cs-scroller" data-cs-scroller tabindex="-1">
            <article class="cs-scope">
              <!-- Section 1: Overview + Full-Width Flush-Top Cover Banner -->
              <section
                id={`${p.slug}-overview`}
                class="cs-sec cs-sec-overview"
                data-cs-section
              >
                {cs.cover.kind === 'logo' && (
                  <div class="cs-hero-banner is-logo" style={`background:${cs.cover.bg}`}>
                    <img
                      src={assetUrl(cs.cover.logoFile)}
                      width="568"
                      height="306"
                      alt={cs.cover.alt}
                      class="cs-hero-logo"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                {cs.cover.kind === 'photo' && (
                  <div
                    class="cs-hero-banner is-photo"
                    style={`background:${cs.cover.bg};--cover-pos:${cs.cover.position ?? 'center center'}`}
                  >
                    <Picture
                      name={cs.cover.image}
                      alt={cs.cover.alt}
                      sizes="100vw"
                      class="cs-hero-photo"
                    />
                  </div>
                )}

                {cs.cover.kind === 'framed' && (
                  <div class="cs-hero-banner is-framed" style={`background:${cs.cover.bg}`}>
                    <div
                      class="cs-hero-framed-inner"
                      style={cs.cover.maxWidth ? `max-width:${cs.cover.maxWidth}px` : undefined}
                    >
                      <Picture
                        name={cs.cover.image}
                        alt={cs.cover.alt}
                        sizes="(min-width: 900px) 960px, 94vw"
                      />
                    </div>
                  </div>
                )}

                {cs.cover.kind === 'trio' && (
                  <div class="cs-hero-banner is-trio" style={`background:${cs.cover.bg}`}>
                    <div
                      class:list={['cs-hero-trio', cs.cover.aspect === '1 / 1' && 'is-square']}
                    >
                      {cs.cover.images.map((imgName, cIdx) => (
                        <div class:list={['cs-trio-card', cIdx === 1 && 'is-center']}>
                          <Picture
                            name={imgName}
                            alt={cs.cover.alts[cIdx]}
                            sizes="(min-width: 900px) 320px, 34vw"
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div class="cs-pad cs-sec">
                  <h1 id={`cs-title-${p.slug}`} class="cs-h1">{p.title}</h1>
                  <p class="cs-subtitle">
                    <span data-lang-text="en">{cs.subtitle}</span>
                    <span data-lang-text="th">{cs.subtitleTh}</span>
                  </p>

                  <dl class="cs-meta-grid">
                    {cs.meta.map((m) => (
                      <div>
                        <dt>{m.label}</dt>
                        <dd>{m.value}</dd>
                      </div>
                    ))}
                  </dl>

                  {cs.overviewParagraphs.map((para, oIdx) => (
                    <p class="cs-prose">
                      <span data-lang-text="en">{para}</span>
                      <span data-lang-text="th">{cs.overviewParagraphsTh[oIdx] ?? para}</span>
                    </p>
                  ))}
                </div>
              </section>

              <div class="cs-article">
                <!-- Section 2: The Challenge -->
                <section id={`${p.slug}-challenge`} class="cs-sec" data-cs-section>
                  <h2 class="cs-h2">The challenge</h2>
                  {cs.challenge.paragraphs.map((para, cIdx) => (
                    <p class="cs-prose">
                      <span data-lang-text="en">{para}</span>
                      <span data-lang-text="th">{cs.challenge.paragraphsTh[cIdx] ?? para}</span>
                    </p>
                  ))}

                  <div class="cs-callout-grid">
                    {cs.challenge.callouts.map((c) => (
                      <div class="cs-callout">
                        <h3>
                          <span data-lang-text="en">{c.title}</span>
                          <span data-lang-text="th">{c.titleTh}</span>
                        </h3>
                        <p>
                          <span data-lang-text="en">{c.body}</span>
                          <span data-lang-text="th">{c.bodyTh}</span>
                        </p>
                      </div>
                    ))}
                  </div>
                </section>

                <!-- Project-Specific Editorial Sections -->
                {cs.sections.map((sec) => {
                  const hasLiveToggle = sec.blocks.some((b) => b.kind === 'sybil-live');

                  return (
                    <section id={`${p.slug}-${sec.id}`} class="cs-sec" data-cs-section>
                      {hasLiveToggle ? (
                        <div class="cs-sec-head-row">
                          <h2 class="cs-h2">{sec.heading}</h2>
                          <div class="cs-seg" role="group" aria-label="Switch landing page preview">
                            <button
                              type="button"
                              class="cs-seg-btn is-active"
                              data-lp-mode="live"
                            >
                              Live Site (Interactive)
                            </button>
                            <button type="button" class="cs-seg-btn" data-lp-mode="mockup">
                              Overview Mockup
                            </button>
                          </div>
                        </div>
                      ) : (
                        <h2 class="cs-h2">{sec.heading}</h2>
                      )}

                      {sec.paragraphs.map((para, sIdx) => (
                        <p class="cs-prose">
                          <span data-lang-text="en">{para}</span>
                          <span data-lang-text="th">{sec.paragraphsTh[sIdx] ?? para}</span>
                        </p>
                      ))}

                      {sec.blocks.map((block) => {
                        if (block.kind === 'figure') {
                          const zUrl = posterUrl(block.image);
                          return (
                            <figure class="cs-figure">
                              <div class="cs-img-box">
                                {zUrl ? (
                                  <button
                                    type="button"
                                    class="cs-zoom"
                                    data-zoom={zUrl}
                                    data-zoom-alt={block.alt}
                                    aria-label={`View larger: ${block.alt}`}
                                  >
                                    <Picture
                                      name={block.image}
                                      alt=""
                                      sizes="(min-width: 900px) 864px, 92vw"
                                    />
                                  </button>
                                ) : (
                                  <Picture
                                    name={block.image}
                                    alt={block.alt}
                                    sizes="(min-width: 900px) 864px, 92vw"
                                  />
                                )}
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'grid') {
                          return (
                            <figure class="cs-figure">
                              <div
                                class:list={[
                                  'cs-gallery',
                                  block.cols === 3 ? 'cols-3' : 'cols-2',
                                  block.fit === 'contain' && 'is-contain',
                                ]}
                              >
                                {block.items.map((item) => {
                                  const zUrl = posterUrl(item.image);
                                  const sizes =
                                    block.cols === 3
                                      ? '(min-width: 900px) 280px, 46vw'
                                      : '(min-width: 900px) 424px, 92vw';
                                  return (
                                    <div class="cs-gallery-card">
                                      <div
                                        class="cs-gallery-media"
                                        style={block.aspect ? `aspect-ratio:${block.aspect}` : undefined}
                                      >
                                        {zUrl ? (
                                          <button
                                            type="button"
                                            class="cs-zoom"
                                            data-zoom={zUrl}
                                            data-zoom-alt={item.alt}
                                            aria-label={`View larger: ${item.alt}`}
                                          >
                                            <Picture name={item.image} alt="" sizes={sizes} />
                                          </button>
                                        ) : (
                                          <Picture name={item.image} alt={item.alt} sizes={sizes} />
                                        )}
                                      </div>
                                      {item.label && <span class="cs-gallery-lbl">{item.label}</span>}
                                    </div>
                                  );
                                })}
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'palette' && p.palette) {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-palette-wrap">
                                <Palette swatches={p.palette} variant={p.slug === 'startup-standup' ? 'bencho' : 'strip'} />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'video') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-media-frame">
                                <VideoSlot
                                  name={block.name}
                                  label={block.label}
                                  poster={block.poster}
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'model') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-model-frame">
                                <ModelSlot
                                  name={block.name}
                                  label={block.label}
                                  poster={block.poster}
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'map') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-map-frame">
                                <FestivalMap
                                  name={block.name}
                                  label={block.label}
                                  idSuffix="cs"
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'sybil-world') {
                          return (
                            <figure class="cs-figure">
                              <ImageCompare
                                beforeImage="07-sybil-bg-night"
                                afterImage="07-sybil-bg-day"
                                beforeAlt="Sybil Husky Arctic fortress under the northern lights (Night mode)"
                                afterAlt="Sybil Husky Arctic fortress at alpine sunrise (Day mode)"
                                beforeLabel="Night · Aurora"
                                afterLabel="Day · Sunrise"
                                initial={50}
                                corner={20}
                              />
                              <figcaption>
                                <span data-lang-text="en">
                                  Drag or flick the divider to compare the 4K (3840×2160) Night Aurora and Day Sunrise worlds.
                                </span>
                                <span data-lang-text="th">
                                  ลากหรือปัดเส้นแบ่งเพื่อเปรียบเทียบฉาก 4K (3840×2160) ระหว่างโหมดกลางคืน (Night) และกลางวัน (Day)
                                </span>
                              </figcaption>
                            </figure>
                          );
                        }

                        if (block.kind === 'sybil-tiers') {
                          return (
                            <>
                              <div class="cs-char-grid">
                                {sybilMintTiers.map((tier) => (
                                  <div class="cs-char-card">
                                    <div class="cs-char-thumb">
                                      <img
                                        src={tier.img}
                                        width="160"
                                        height="160"
                                        alt={tier.title}
                                        loading="lazy"
                                        decoding="async"
                                      />
                                    </div>
                                    <div class="cs-char-meta">
                                      <span class="cs-char-badge">{tier.badge}</span>
                                      <strong>{tier.title}</strong>
                                      <span class="cs-char-stats">{tier.stats}</span>
                                    </div>
                                  </div>
                                ))}
                              </div>

                              <figure class="cs-figure">
                                <PosterDeck items={sybilCardItems} initialIndex={2} transparent holo />
                                <figcaption>
                                  <span data-lang-text="en">
                                    Complete six-tier collectible card system — click any side card to browse, or click the active card to inspect in 3D Holo view.
                                  </span>
                                  <span data-lang-text="th">
                                    ระบบออกแบบการ์ด NFT ครบทั้ง 6 ระดับ — คลิกการ์ดข้างๆ เพื่อเลื่อน หรือคลิกการ์ดกลางเพื่อขยายดูเอฟเฟกต์ Holo 3D
                                  </span>
                                </figcaption>
                              </figure>
                            </>
                          );
                        }

                        if (block.kind === 'sybil-live') {
                          return (
                            <div class="cs-browser-frame">
                              <div class="cs-browser-bar">
                                <div class="cs-browser-dots" aria-hidden="true">
                                  <span />
                                  <span />
                                  <span />
                                </div>
                                <div class="cs-browser-url">
                                  <span class="cs-live-badge">LIVE</span>
                                  <span>sybil-husky.vercel.app</span>
                                </div>
                                <a
                                  href={block.liveUrl}
                                  rel="noopener"
                                  target="_blank"
                                  class="cs-browser-open"
                                >
                                  Open ↗
                                </a>
                              </div>

                              <div class="cs-iframe-stage" data-iframe-stage>
                                <iframe
                                  class="cs-iframe"
                                  data-sybil-iframe
                                  data-src={block.liveUrl}
                                  title="Sybil Husky live website preview"
                                  loading="lazy"
                                />
                              </div>

                              <div class="cs-shot-stage" data-shot-stage hidden>
                                <Picture
                                  name="07-sybil-landing"
                                  alt="Sybil Husky landing page UI shown on laptops and as a section overview"
                                  sizes="(min-width: 900px) 864px, 92vw"
                                />
                              </div>
                            </div>
                          );
                        }

                        if (block.kind === 'book-flipbook') {
                          return (
                            <figure class="cs-figure">
                              <BookFlipbook />
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'poster-deck') {
                          return (
                            <figure class="cs-figure">
                              <PosterDeck items={block.items} initialIndex={block.initialIndex} />
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        return null;
                      })}
                    </section>
                  );
                })}

                <!-- Final Section: Outcome & Tools -->
                <section id={`${p.slug}-outcome`} class="cs-sec" data-cs-section>
                  <h2 class="cs-h2">Outcome</h2>
                  <p class="cs-prose">
                    <span data-lang-text="en">{cs.outcome}</span>
                    <span data-lang-text="th">{cs.outcomeTh}</span>
                  </p>

                  <div class="cs-tools-bar">
                    <span class="cs-tools-lbl">Tools &amp; Software</span>
                    <div class="cs-tools-list">
                      {p.tools.map((id) => (
                        <span class="cs-tool-pill">
                          <strong>{tools[id].abbr}</strong> {tools[id].name}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Bottom Editorial Previous / Next Project Navigation -->
                  <nav class="cs-foot-nav" aria-label="Previous and next project">
                    <a
                      href={`#project-${prevProject.slug}`}
                      class="cs-foot-link is-prev"
                      data-switch-case={prevProject.slug}
                    >
                      <span class="cs-foot-lbl">Previous project</span>
                      <span class="cs-foot-title">
                        <span class="cs-foot-arrow" aria-hidden="true">←</span>
                        <span>{prevProject.spine.label}</span>
                      </span>
                    </a>

                    <a
                      href={`#project-${nextProject.slug}`}
                      class="cs-foot-link is-next"
                      data-switch-case={nextProject.slug}
                    >
                      <span class="cs-foot-lbl">Next project</span>
                      <span class="cs-foot-title">
                        <span>{nextProject.spine.label}</span>
                        <span class="cs-foot-arrow" aria-hidden="true">→</span>
                      </span>
                    </a>
                  </nav>
                </section>
              </div>
            </article>
          </div>
        </div>
      </dialog>
    );
  })
}

<script>
  // ================= Unified Full Case Study Dialog Controller =================
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>('[data-case-dialog]').forEach((dlg) => {
    const slug = dlg.dataset.caseDialog;
    if (slug) dialogs.set(slug, dlg);
  });

  const cursorTip = document.querySelector<HTMLElement>('[data-case-cursor-tip]');
  const HASH_PREFIX = '#project-';
  let activeSlug: string | null = null;

  const hideCursorTip = () => {
    cursorTip?.classList.remove('is-visible');
  };

  // Scale Sybil Husky 1920px live iframe inside its container
  function scaleDialogIframes(dlg: HTMLDialogElement) {
    const stage = dlg.querySelector<HTMLElement>('[data-iframe-stage]');
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
    if (!stage || !frame) return;
    const w = stage.clientWidth;
    if (w <= 0) return;
    const s = w / 1920;
    const targetH = Math.round(Math.min(540, Math.max(320, w * 0.625)));
    stage.style.height = `${targetH}px`;
    frame.style.width = '1920px';
    frame.style.height = `${Math.round(targetH / s)}px`;
    frame.style.transform = `scale(${s.toFixed(4)})`;
  }

  function pauseDialogMedia(dlg: HTMLDialogElement) {
    dlg.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
      if (!v.paused) v.pause();
    });
  }

  function closeAllDialogs(updateHash = false) {
    const prevSlug = activeSlug;
    dialogs.forEach((dlg) => {
      if (dlg.open) {
        pauseDialogMedia(dlg);
        dlg.close();
      }
    });
    activeSlug = null;
    document.documentElement.style.overflow = '';
    if (updateHash && location.hash.startsWith(HASH_PREFIX)) {
      const fallbackHash = prevSlug && document.getElementById(prevSlug) ? `#${prevSlug}` : '#work';
      history.pushState(null, '', fallbackHash);
    }
  }

  function openCaseStudy(slug: string, pushHash = true) {
    if (document.documentElement.classList.contains('ve-active')) return;
    const dlg = dialogs.get(slug);
    if (!dlg) return;

    hideCursorTip();

    // Close any other currently open case study dialog smoothly
    dialogs.forEach((other, otherSlug) => {
      if (otherSlug !== slug && other.open) {
        pauseDialogMedia(other);
        other.close();
      }
    });

    activeSlug = slug;

    const scroller = dlg.querySelector<HTMLElement>('[data-cs-scroller]');
    const tocLinks = [...dlg.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')];
    const sections = [...dlg.querySelectorAll<HTMLElement>('[data-cs-section]')];

    if (!dlg.open) {
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    }

    if (scroller) {
      scroller.scrollTop = 0;
      scroller.focus({ preventScroll: true });
    }
    const firstId = sections[0]?.id;
    if (firstId) {
      tocLinks.forEach((l) => {
        const hit = l.dataset.csToc === firstId;
        l.classList.toggle('is-active', hit);
        if (hit) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
      dlg.dispatchEvent(new CustomEvent('cs-hook-sync'));
    }

    // Lazy-load live iframe if present (Sybil Husky)
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
    if (frame && !frame.src && frame.dataset.src) {
      frame.src = frame.dataset.src;
    }
    requestAnimationFrame(() => scaleDialogIframes(dlg));

    const targetHash = `${HASH_PREFIX}${slug}`;
    if (pushHash && location.hash !== targetHash) {
      history.pushState({ caseStudy: slug }, '', targetHash);
    }
  }

  // Wire per-dialog interactive controls (TOC, Close, Next Project, Sybil toggles)
  dialogs.forEach((dlg, slug) => {
    const scroller = dlg.querySelector<HTMLElement>('[data-cs-scroller]');
    const tocLinks = [...dlg.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')];
    const sections = [...dlg.querySelectorAll<HTMLElement>('[data-cs-section]')];
    const closeBtn = dlg.querySelector<HTMLButtonElement>('[data-close-case]');
    const switchLinks = [
      ...dlg.querySelectorAll<HTMLAnchorElement>('[data-next-case], [data-switch-case]'),
    ];

    // RareUI Hook Sidebar spring controller (present when [data-hook-sidebar] is used, e.g. K2O)
    const hookRoot = dlg.querySelector<HTMLElement>('[data-hook-sidebar]');
    let syncHookSidebar = () => {};
    if (hookRoot) {
      const hookItems = [...hookRoot.querySelectorAll<HTMLAnchorElement>('[data-hook-item]')];
      const hoverRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="hover"]');
      const activeRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="active"]');
      const hStem = hoverRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const hCorner = hoverRail?.querySelector<SVGElement>('[data-hook-corner]');
      const aStem = activeRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const aCorner = activeRail?.querySelector<SVGElement>('[data-hook-corner]');

      if (hookItems.length && hoverRail && activeRail && hStem && hCorner && aStem && aCorner) {
        const CORNER = 6;
        const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
        let centers: number[] = [];
        let hoverIdx: number | null = null;
        let pointerInside = false;
        let focusInside = false;
        let placed = false;

        const aTop = { val: 0, vel: 0, target: 0 };
        const aY = { val: 16, vel: 0, target: 16 };
        const hTop = { val: 0, vel: 0, target: 0 };
        const hY = { val: 16, vel: 0, target: 16 };
        let rafId = 0;
        let lastTs = 0;

        const stepSpring = (s: { val: number; vel: number; target: number }, dtSec: number): boolean => {
          const steps = Math.max(1, Math.ceil(dtSec / 0.004));
          const h = dtSec / steps;
          for (let i = 0; i < steps; i++) {
            const force = -420 * (s.val - s.target) - 34 * s.vel;
            s.vel += (force / 0.7) * h;
            s.val += s.vel * h;
          }
          if (Math.abs(s.target - s.val) < 0.08 && Math.abs(s.vel) < 0.08) {
            s.val = s.target;
            s.vel = 0;
            return false;
          }
          return true;
        };

        const renderRails = () => {
          aStem.style.top = `${aTop.val.toFixed(2)}px`;
          aStem.style.height = `${Math.max(0, aY.val - CORNER - aTop.val).toFixed(2)}px`;
          aCorner.style.top = `${(aY.val - CORNER).toFixed(2)}px`;

          hStem.style.top = `${hTop.val.toFixed(2)}px`;
          hStem.style.height = `${Math.max(0, hY.val - CORNER - hTop.val).toFixed(2)}px`;
          hCorner.style.top = `${(hY.val - CORNER).toFixed(2)}px`;
        };

        const animTick = (ts: number) => {
          const dt = lastTs ? Math.min(0.04, (ts - lastTs) * 0.001) : 1 / 60;
          lastTs = ts;
          if (reduceMq.matches) {
            aTop.val = aTop.target;
            aTop.vel = 0;
            aY.val = aY.target;
            aY.vel = 0;
            hTop.val = hTop.target;
            hTop.vel = 0;
            hY.val = hY.target;
            hY.vel = 0;
            renderRails();
            rafId = 0;
            lastTs = 0;
            return;
          }
          const m1 = stepSpring(aTop, dt);
          const m2 = stepSpring(aY, dt);
          const m3 = stepSpring(hTop, dt);
          const m4 = stepSpring(hY, dt);
          renderRails();
          if (m1 || m2 || m3 || m4) {
            rafId = requestAnimationFrame(animTick);
          } else {
            rafId = 0;
            lastTs = 0;
          }
        };

        const schedule = () => {
          if (!rafId) {
            lastTs = 0;
            rafId = requestAnimationFrame(animTick);
          }
        };

        const measure = () => {
          centers = hookItems.map((el) => el.offsetTop + el.offsetHeight * 0.5);
        };

        syncHookSidebar = () => {
          measure();
          const activeIndex = hookItems.findIndex((el) => el.classList.contains('is-active'));
          const activeCenter = activeIndex >= 0 ? (centers[activeIndex] ?? null) : null;
          const hoverCenter = hoverIdx !== null ? (centers[hoverIdx] ?? null) : null;

          activeRail.classList.toggle('is-visible', activeCenter !== null);
          if (activeCenter !== null) {
            aTop.target = 0;
            aY.target = activeCenter;
            if (!placed && activeCenter > 0) {
              placed = true;
              aTop.val = 0;
              aY.val = activeCenter;
            }
          }

          const showHover = (pointerInside || focusInside) && hoverIdx !== null && hoverIdx !== activeIndex && hoverCenter !== null;
          hoverRail.classList.toggle('is-visible', showHover);
          if (hoverCenter !== null) {
            const from =
              activeCenter !== null && hoverCenter <= activeCenter
                ? Math.max(0, hoverCenter - CORNER)
                : (activeCenter ?? 0);
            if (!hoverRail.classList.contains('is-ready')) {
              hoverRail.classList.add('is-ready');
              hTop.val = from;
              hY.val = hoverCenter;
            }
            hTop.target = from;
            hY.target = hoverCenter;
          }

          renderRails();
          schedule();
        };

        hookItems.forEach((item, idx) => {
          item.addEventListener('pointerenter', () => {
            hoverIdx = idx;
            pointerInside = true;
            syncHookSidebar();
          });
          item.addEventListener('focus', () => {
            hoverIdx = idx;
            focusInside = true;
            syncHookSidebar();
          });
          item.addEventListener('blur', () => {
            focusInside = false;
            syncHookSidebar();
          });
        });

        hookRoot.addEventListener('pointerleave', () => {
          pointerInside = false;
          syncHookSidebar();
        });

        new ResizeObserver(syncHookSidebar).observe(hookRoot);
        dlg.addEventListener('cs-hook-sync', () => requestAnimationFrame(syncHookSidebar));
      }
    }

    const setActiveToc = (id: string) => {
      for (const link of tocLinks) {
        const hit = link.dataset.csToc === id;
        link.classList.toggle('is-active', hit);
        if (hit) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      syncHookSidebar();
    };

    closeBtn?.addEventListener('click', () => closeAllDialogs(true));

    // Sidebar Next + bottom Previous/Next project links switch seamlessly between Full Case Studies
    switchLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetSlug = link.dataset.switchCase || link.dataset.nextCase;
        if (targetSlug) openCaseStudy(targetSlug, true);
      });
    });

    let tocPinnedUntil = 0;
    const clearPin = () => {
      tocPinnedUntil = 0;
    };
    scroller?.addEventListener('wheel', clearPin, { passive: true });
    scroller?.addEventListener('touchstart', clearPin, { passive: true });

    // TOC smooth scroll inside reader
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = link.dataset.csToc;
        const target = id ? dlg.querySelector<HTMLElement>(`#${CSS.escape(id)}`) : null;
        if (target && scroller) {
          tocPinnedUntil = performance.now() + 900;
          setActiveToc(id!);
          const isOverview = target.classList.contains('cs-sec-overview');
          scroller.scrollTo({
            top: isOverview ? 0 : Math.max(0, target.offsetTop - 48),
            behavior: 'smooth',
          });
        }
      });
    });

    // Live TOC spy on scroll
    scroller?.addEventListener(
      'scroll',
      () => {
        if (performance.now() < tocPinnedUntil) return;
        const atBottom =
          scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight <= 24;
        if (atBottom && sections.length) {
          setActiveToc(sections[sections.length - 1].id);
          return;
        }
        const cutoff = scroller.scrollTop + scroller.clientHeight * 0.28;
        let currentId = sections[0]?.id || '';
        for (const sec of sections) {
          if (sec.offsetTop <= cutoff) currentId = sec.id;
        }
        if (currentId) setActiveToc(currentId);
      },
      { passive: true },
    );

    // Handle ESC / native dialog close
    dlg.addEventListener('close', () => {
      pauseDialogMedia(dlg);
      if (activeSlug === slug) {
        activeSlug = null;
        document.documentElement.style.overflow = '';
        if (location.hash === `${HASH_PREFIX}${slug}`) {
          const fallbackHash = document.getElementById(slug) ? `#${slug}` : '#work';
          history.replaceState(null, '', fallbackHash);
        }
      }
    });

    // Sybil Live Site / Mockup Toggle
    const lpBtns = [...dlg.querySelectorAll<HTMLButtonElement>('[data-lp-mode]')];
    const iframeStage = dlg.querySelector<HTMLElement>('[data-iframe-stage]');
    const shotStage = dlg.querySelector<HTMLElement>('[data-shot-stage]');
    lpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.lpMode || 'live';
        lpBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (iframeStage && shotStage) {
          const isLive = mode === 'live';
          iframeStage.hidden = !isLive;
          shotStage.hidden = isLive;
          if (isLive) {
            const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
            if (frame && !frame.src && frame.dataset.src) frame.src = frame.dataset.src;
            requestAnimationFrame(() => scaleDialogIframes(dlg));
          }
        }
      });
    });

    if (iframeStage) {
      new ResizeObserver(() => scaleDialogIframes(dlg)).observe(iframeStage);
      window.addEventListener('resize', () => {
        if (dlg.open) scaleDialogIframes(dlg);
      });
    }
  });

  // Global click delegation for all [data-open-case] triggers (project titles)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element)?.closest<HTMLElement>('[data-open-case]');
    if (!trigger) return;
    if (document.documentElement.classList.contains('ve-active')) return;
    const slug = trigger.dataset.openCase;
    if (slug && dialogs.has(slug)) {
      e.preventDefault();
      openCaseStudy(slug, true);
    }
  });

  // Hash & browser Back/Forward sync
  const LEGACY_HASH_PREFIX = '#read-';
  const syncFromHash = () => {
    if (location.hash.startsWith(HASH_PREFIX)) {
      const slug = location.hash.slice(HASH_PREFIX.length);
      if (dialogs.has(slug)) {
        openCaseStudy(slug, false);
        return;
      }
    } else if (location.hash.startsWith(LEGACY_HASH_PREFIX)) {
      const slug = location.hash.slice(LEGACY_HASH_PREFIX.length);
      if (dialogs.has(slug)) {
        history.replaceState({ caseStudy: slug }, '', `${HASH_PREFIX}${slug}`);
        openCaseStudy(slug, false);
        return;
      }
    }
    if (activeSlug) {
      closeAllDialogs(false);
    }
  };
  window.addEventListener('hashchange', syncFromHash);
  window.addEventListener('popstate', syncFromHash);
  syncFromHash();

  // ================= Floating Cursor Tooltip ("Click to Explore full project") =================
  if (cursorTip) {
    let hoveredTrigger: HTMLElement | null = null;

    const positionTip = (x: number, y: number) => {
      const offsetX = 14;
      const offsetY = 16;
      const rect = cursorTip.getBoundingClientRect();
      const tipW = rect.width || 240;
      const tipH = rect.height || 36;
      const clampedX = Math.min(x + offsetX, window.innerWidth - tipW - 12);
      const clampedY = Math.min(y + offsetY, window.innerHeight - tipH - 12);
      cursorTip.style.transform = `translate3d(${Math.round(clampedX)}px, ${Math.round(clampedY)}px, 0)`;
    };

    document.addEventListener(
      'pointerover',
      (e) => {
        if (e.pointerType === 'touch') return;
        if (document.documentElement.classList.contains('ve-active')) return;
        const trigger = (e.target as Element)?.closest<HTMLElement>('[data-case-trigger]');
        if (!trigger) return;
        hoveredTrigger = trigger;
        positionTip(e.clientX, e.clientY);
        cursorTip.classList.add('is-visible');
      },
      { passive: true },
    );

    document.addEventListener(
      'pointermove',
      (e) => {
        if (!hoveredTrigger || e.pointerType === 'touch') return;
        positionTip(e.clientX, e.clientY);
      },
      { passive: true },
    );

    document.addEventListener(
      'pointerout',
      (e) => {
        if (!hoveredTrigger) return;
        const next = (e.relatedTarget as Element | null)?.closest<HTMLElement>('[data-case-trigger]');
        if (next === hoveredTrigger) return;
        hoveredTrigger = null;
        hideCursorTip();
      },
      { passive: true },
    );

    window.addEventListener(
      'scroll',
      () => {
        if (hoveredTrigger) {
          hoveredTrigger = null;
          hideCursorTip();
        }
      },
      { passive: true },
    );
    window.addEventListener('blur', hideCursorTip);
  }
</script>

