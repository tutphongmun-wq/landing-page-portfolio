---
// Unified Full-Screen Editorial Case Study Reader for ALL 7 projects (#read-<slug>)
// + Floating Cursor Tooltip ("Click to Explore full project") triggered on main Work titles.
//
// Layout matches the approved Sybil Husky reader architecture:
//   - Left sticky navigation sidebar (256px): Back to All work, Project Name, live TOC, optional Live Site pill, Next project
//   - Right scrollable reading pane:
//       - Flush-top, edge-to-edge full-width cover banner (486px height)
//       - Centered 720px left-aligned editorial text column
//       - Centered 864px media breakout column (+20% wider than text)
import Picture from './Picture.astro';
import Palette from './Palette.astro';
import VideoSlot from './VideoSlot.astro';
import ModelSlot from './ModelSlot.astro';
import FestivalMap from './FestivalMap.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { projects } from '../data/projects';
import { caseStudies } from '../data/caseStudies';
import { tools } from '../data/site';
import { assetUrl, posterUrl } from '../lib/media';

const sybilMintTiers = [
  {
    badge: 'Tier 01 · Apprentice',
    title: 'Siberian Apprentice',
    img: assetUrl('media/07-sybil-char-apprentice.webp'),
    stats: '100 Runes · $100 · Base Tier',
  },
  {
    badge: 'Tier 02 · Mage',
    title: 'Siberian Mage',
    img: assetUrl('media/07-sybil-char-mage.webp'),
    stats: 'Bonus Frost Gear · Companion',
  },
  {
    badge: 'Tier 03 · Sorcerer',
    title: 'Siberian Sorcerer',
    img: assetUrl('media/07-sybil-char-sorcerer.webp'),
    stats: '660 Runes · $600 · +10% Bonus',
  },
  {
    badge: 'Tier 04 · Supreme',
    title: 'Siberian Supreme',
    img: assetUrl('media/07-sybil-char-supreme.webp'),
    stats: '1,820 Runes · $1,400 · +30% Bonus',
  },
  {
    badge: 'Edition · Baby 01',
    title: 'Baby Husky (Frost)',
    img: assetUrl('media/07-sybil-char-baby1.webp'),
    stats: 'Special Community Edition',
  },
  {
    badge: 'Edition · Baby 02',
    title: 'Baby Husky (Ember)',
    img: assetUrl('media/07-sybil-char-baby2.webp'),
    stats: 'Special Community Edition',
  },
];
const k2oPalettes = [
  {
    id: 'opt1',
    short: 'Opt 1',
    name: 'Warm Paper',
    lightBg: '#FBF5EB',
    darkBg: '#161513',
  },
  {
    id: 'opt2',
    short: 'Opt 2',
    name: 'True Neutral Zinc',
    lightBg: '#FAFAFA',
    darkBg: '#09090B',
  },
  {
    id: 'opt3',
    short: 'Opt 3',
    name: 'Cool Slate',
    lightBg: '#F8FAFC',
    darkBg: '#0F172A',
  },
  {
    id: 'opt4',
    short: 'Opt 4',
    name: 'Soft Charcoal',
    lightBg: '#F5F5F7',
    darkBg: '#1C1C1E',
  },
] as const;
---

<!-- Singleton Floating Cursor Tooltip for Project Titles -->
<div class="case-cursor-tip" data-case-cursor-tip aria-hidden="true">
  Click to Explore full project
</div>

<!-- Full-Screen Editorial Case Study Dialogs (#read-<slug>) -->
{
  projects.map((p, idx) => {
    const cs = caseStudies[p.slug];
    if (!cs) return null;
    const nextProject = projects[(idx + 1) % projects.length];
    const isSybilPreview = p.slug === 'sybil-husky';
    const isK2oHook = p.slug === 'k2o';
    const tocItems = isSybilPreview
      ? [
          { id: `${p.slug}-overview`, label: 'Overview' },
          ...cs.sections.map((s) => ({ id: `${p.slug}-${s.id}`, label: s.tocLabel })),
        ]
      : [
          { id: `${p.slug}-overview`, label: 'Overview' },
          { id: `${p.slug}-challenge`, label: 'The challenge' },
          ...cs.sections.map((s) => ({ id: `${p.slug}-${s.id}`, label: s.tocLabel })),
          { id: `${p.slug}-outcome`, label: 'Outcome' },
        ];

    return (
      <dialog
        class="cs-reader"
        data-case-dialog={p.slug}
        data-k2o-palette={isK2oHook ? 'opt1' : undefined}
        aria-labelledby={`cs-title-${p.slug}`}
      >
        <div class="cs-layout">
          <!-- Left Sticky Navigation Sidebar -->
          <aside class="cs-sidebar" aria-label={`${p.title} project navigation`}>
            <div class="cs-side-top">
              <button type="button" class="cs-back" data-close-case={p.slug}>
                <span aria-hidden="true">←</span>
                <span>All projects</span>
              </button>
              <div class="cs-side-tools">
                <LangToggle variant="compact" />
                <ThemeToggle compact />
              </div>
            </div>

            <div class="cs-toc-wrap">
              <p class="cs-proj-name">{cs.sidebarName}</p>
              <nav aria-label="Table of contents">
                {isK2oHook ? (
                  <div class="cs-hook-list" data-hook-sidebar>
                    <span class="cs-hook-rail is-hover" data-hook-rail="hover" aria-hidden="true">
                      <span class="cs-hook-stem" data-hook-stem></span>
                      <svg width="12" height="7" viewBox="0 0 12 7" fill="none" class="cs-hook-corner" data-hook-corner>
                        <path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
                      </svg>
                    </span>
                    <span class="cs-hook-rail is-accent" data-hook-rail="active" aria-hidden="true">
                      <span class="cs-hook-stem" data-hook-stem></span>
                      <svg width="12" height="7" viewBox="0 0 12 7" fill="none" class="cs-hook-corner" data-hook-corner>
                        <path d="M0.5 0a6 6 0 0 0 6 6H12" stroke="currentColor" stroke-dasharray="2 2" />
                      </svg>
                    </span>
                    {tocItems.map((item, tIdx) => (
                      <a
                        href={`#${item.id}`}
                        class:list={['cs-hook-item', { 'is-active': tIdx === 0 }]}
                        data-cs-toc={item.id}
                        data-hook-item
                        aria-current={tIdx === 0 ? 'location' : undefined}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                ) : (
                  <ul class="cs-toc" role="list">
                    {tocItems.map((item, tIdx) => (
                      <li>
                        <a
                          href={`#${item.id}`}
                          class:list={['cs-toc-link', { 'is-active': tIdx === 0 }]}
                          data-cs-toc={item.id}
                        >
                          <span class="cs-toc-bar" aria-hidden="true" />
                          <span>{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </nav>
            </div>

            {isK2oHook && (
              <div class="cs-palette-trial" role="group" aria-label="K2O palette options">
                <div class="cs-palette-trial-head">
                  <span class="cs-palette-trial-lbl">Palette</span>
                  <span class="cs-palette-trial-mode" data-k2o-theme-label>Light</span>
                </div>
                <div class="cs-palette-opts">
                  {k2oPalettes.map((opt, oIdx) => (
                    <button
                      type="button"
                      class:list={['cs-palette-opt', { 'is-active': oIdx === 0 }]}
                      data-k2o-palette-btn={opt.id}
                      aria-pressed={oIdx === 0 ? 'true' : 'false'}
                      title={`${opt.short} (${opt.name}) — Light ${opt.lightBg} / Dark ${opt.darkBg}`}
                    >
                      <span
                        class="cs-palette-swatch"
                        style={`--sw-light:${opt.lightBg};--sw-dark:${opt.darkBg}`}
                        aria-hidden="true"
                      />
                      <span class="cs-palette-short">{opt.short}</span>
                      <span class="cs-palette-name">{opt.name}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {isSybilPreview && (
              <div class="cs-opt-a" aria-label="Option A Sidebar Spec Card">
                <span class="cs-opt-badge">Option A · Sidebar Spec</span>
                <dl class="cs-opt-a-list">
                  <div>
                    <dt>Client</dt>
                    <dd>SybilHusky Collective</dd>
                  </div>
                  <div>
                    <dt>Category</dt>
                    <dd>Branding, Character &amp; Web UI</dd>
                  </div>
                  <div>
                    <dt>Deliverables</dt>
                    <dd>Logo, 6 Tiers, Next.js Site</dd>
                  </div>
                  <div>
                    <dt>Tools</dt>
                    <dd class="cs-opt-a-tools">
                      {p.tools.map((id) => (
                        <span>{tools[id].abbr}</span>
                      ))}
                    </dd>
                  </div>
                </dl>
              </div>
            )}

            <div class="cs-side-foot">
              {cs.liveUrl && (
                <a href={cs.liveUrl.href} rel="noopener" target="_blank" class="cs-live-pill">
                  <span>{cs.liveUrl.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              <a
                href={`#read-${nextProject.slug}`}
                class="cs-next"
                data-next-case={nextProject.slug}
              >
                <span class="cs-next-lbl">Next project</span>
                <span class="cs-next-title">
                  {nextProject.spine.label} <span aria-hidden="true">→</span>
                </span>
              </a>
            </div>
          </aside>

          <!-- Right Scrollable Editorial Reading Column -->
          <div class="cs-scroller" data-cs-scroller tabindex="-1">
            <article class="cs-scope">
              <!-- Section 1: Overview + Full-Width Flush-Top Cover Banner -->
              <section
                id={`${p.slug}-overview`}
                class="cs-sec cs-sec-overview"
                data-cs-section
              >
                {cs.cover.kind === 'logo' && (
                  <div class="cs-hero-banner is-logo" style={`background:${cs.cover.bg}`}>
                    <img
                      src={assetUrl(cs.cover.logoFile)}
                      width="568"
                      height="306"
                      alt={cs.cover.alt}
                      class="cs-hero-logo"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                {cs.cover.kind === 'photo' && (
                  <div
                    class="cs-hero-banner is-photo"
                    style={`background:${cs.cover.bg};--cover-pos:${cs.cover.position ?? 'center center'}`}
                  >
                    <Picture
                      name={cs.cover.image}
                      alt={cs.cover.alt}
                      sizes="100vw"
                      class="cs-hero-photo"
                    />
                  </div>
                )}

                {cs.cover.kind === 'framed' && (
                  <div class="cs-hero-banner is-framed" style={`background:${cs.cover.bg}`}>
                    <div
                      class="cs-hero-framed-inner"
                      style={cs.cover.maxWidth ? `max-width:${cs.cover.maxWidth}px` : undefined}
                    >
                      <Picture
                        name={cs.cover.image}
                        alt={cs.cover.alt}
                        sizes="(min-width: 900px) 960px, 94vw"
                      />
                    </div>
                  </div>
                )}

                {cs.cover.kind === 'trio' && (
                  <div class="cs-hero-banner is-trio" style={`background:${cs.cover.bg}`}>
                    <div
                      class:list={['cs-hero-trio', cs.cover.aspect === '1 / 1' && 'is-square']}
                    >
                      {cs.cover.images.map((imgName, cIdx) => (
                        <div class:list={['cs-trio-card', cIdx === 1 && 'is-center']}>
                          <Picture
                            name={imgName}
                            alt={cs.cover.alts[cIdx]}
                            sizes="(min-width: 900px) 320px, 34vw"
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div class="cs-pad cs-sec">
                  <h1 id={`cs-title-${p.slug}`} class="cs-h1">{p.title}</h1>
                  <p class="cs-subtitle">
                    <span data-lang-text="en">{cs.subtitle}</span>
                    <span data-lang-text="th">{cs.subtitleTh}</span>
                  </p>

                  {
                    isSybilPreview ? (
                      <div class="cs-spec-compare" aria-label="Layout comparison B and C">
                        <!-- Option B: 4-Box Bento Spec Cards -->
                        <div class="cs-opt-group">
                          <span class="cs-opt-badge">Option B · Bento Spec Cards</span>
                          <dl class="cs-bento-specs">
                            <div class="cs-bento-card">
                              <dt>Client</dt>
                              <dd>SybilHusky Collective</dd>
                            </div>
                            <div class="cs-bento-card">
                              <dt>Category</dt>
                              <dd>Branding, Character &amp; Web UI</dd>
                            </div>
                            <div class="cs-bento-card">
                              <dt>Deliverables</dt>
                              <dd>Logo, 6 NFT Tiers, Day/Night Art, Next.js Site</dd>
                            </div>
                            <div class="cs-bento-card">
                              <dt>Tools</dt>
                              <dd class="cs-bento-tools">
                                {p.tools.map((id) => (
                                  <span title={tools[id].name}>{tools[id].abbr}</span>
                                ))}
                              </dd>
                            </div>
                          </dl>
                        </div>

                        <!-- Option C: Minimal Inline Spec Tags -->
                        <div class="cs-opt-group">
                          <span class="cs-opt-badge">Option C · Inline Spec Tags</span>
                          <div class="cs-inline-specs">
                            <span class="cs-spec-chip"><strong>Client</strong> SybilHusky Collective</span>
                            <span class="cs-spec-chip"><strong>Category</strong> Branding, Character &amp; Web UI</span>
                            <span class="cs-spec-chip"><strong>Deliverables</strong> Logo · 6 NFT Tiers · Next.js 16</span>
                            {p.tools.map((id) => (
                              <span class="cs-spec-chip is-tool">
                                <strong>{tools[id].abbr}</strong> {tools[id].name}
                              </span>
                            ))}
                          </div>
                        </div>
                      </div>
                    ) : (
                      <dl class="cs-meta-grid">
                        {cs.meta.map((m) => (
                          <div>
                            <dt>{m.label}</dt>
                            <dd>{m.value}</dd>
                          </div>
                        ))}
                      </dl>
                    )
                  }

                  {cs.overviewParagraphs.map((para, oIdx) => (
                    <p class="cs-prose">
                      <span data-lang-text="en">{para}</span>
                      <span data-lang-text="th">{cs.overviewParagraphsTh[oIdx] ?? para}</span>
                    </p>
                  ))}
                </div>
              </section>

              <div class="cs-article">
                <!-- Section 2: The Challenge (hidden on showcase preview) -->
                {
                  !isSybilPreview && (
                    <section id={`${p.slug}-challenge`} class="cs-sec" data-cs-section>
                      <h2 class="cs-h2">The challenge</h2>
                      {cs.challenge.paragraphs.map((para, cIdx) => (
                        <p class="cs-prose">
                          <span data-lang-text="en">{para}</span>
                          <span data-lang-text="th">{cs.challenge.paragraphsTh[cIdx] ?? para}</span>
                        </p>
                      ))}

                      <div class="cs-callout-grid">
                        {cs.challenge.callouts.map((c) => (
                          <div class="cs-callout">
                            <h3>
                              <span data-lang-text="en">{c.title}</span>
                              <span data-lang-text="th">{c.titleTh}</span>
                            </h3>
                            <p>
                              <span data-lang-text="en">{c.body}</span>
                              <span data-lang-text="th">{c.bodyTh}</span>
                            </p>
                          </div>
                        ))}
                      </div>
                    </section>
                  )
                }

                <!-- Project-Specific Editorial Sections -->
                {cs.sections.map((sec) => {
                  const hasWorldToggle = sec.blocks.some((b) => b.kind === 'sybil-world');
                  const hasLiveToggle = sec.blocks.some((b) => b.kind === 'sybil-live');

                  return (
                    <section id={`${p.slug}-${sec.id}`} class="cs-sec" data-cs-section>
                      {hasWorldToggle ? (
                        <div class="cs-sec-head-row">
                          <h2 class="cs-h2">{sec.heading}</h2>
                          <div class="cs-seg" role="group" aria-label="Switch artwork lighting">
                            <button
                              type="button"
                              class="cs-seg-btn is-active"
                              data-world-mode="night"
                            >
                              Night · Aurora
                            </button>
                            <button type="button" class="cs-seg-btn" data-world-mode="day">
                              Day · Sunrise
                            </button>
                          </div>
                        </div>
                      ) : hasLiveToggle ? (
                        <div class="cs-sec-head-row">
                          <h2 class="cs-h2">{sec.heading}</h2>
                          <div class="cs-seg" role="group" aria-label="Switch landing page preview">
                            <button
                              type="button"
                              class="cs-seg-btn is-active"
                              data-lp-mode="live"
                            >
                              Live Site (Interactive)
                            </button>
                            <button type="button" class="cs-seg-btn" data-lp-mode="mockup">
                              Overview Mockup
                            </button>
                          </div>
                        </div>
                      ) : (
                        <h2 class="cs-h2">{sec.heading}</h2>
                      )}

                      {sec.paragraphs.map((para, sIdx) => (
                        <p class="cs-prose">
                          <span data-lang-text="en">{para}</span>
                          <span data-lang-text="th">{sec.paragraphsTh[sIdx] ?? para}</span>
                        </p>
                      ))}

                      {sec.blocks.map((block) => {
                        if (block.kind === 'figure') {
                          const zUrl = posterUrl(block.image);
                          return (
                            <figure class="cs-figure">
                              <div class="cs-img-box">
                                {zUrl ? (
                                  <button
                                    type="button"
                                    class="cs-zoom"
                                    data-zoom={zUrl}
                                    data-zoom-alt={block.alt}
                                    aria-label={`View larger: ${block.alt}`}
                                  >
                                    <Picture
                                      name={block.image}
                                      alt=""
                                      sizes="(min-width: 900px) 864px, 92vw"
                                    />
                                  </button>
                                ) : (
                                  <Picture
                                    name={block.image}
                                    alt={block.alt}
                                    sizes="(min-width: 900px) 864px, 92vw"
                                  />
                                )}
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'grid') {
                          return (
                            <figure class="cs-figure">
                              <div
                                class:list={[
                                  'cs-gallery',
                                  block.cols === 3 ? 'cols-3' : 'cols-2',
                                  block.fit === 'contain' && 'is-contain',
                                ]}
                              >
                                {block.items.map((item) => {
                                  const zUrl = posterUrl(item.image);
                                  const sizes =
                                    block.cols === 3
                                      ? '(min-width: 900px) 280px, 46vw'
                                      : '(min-width: 900px) 424px, 92vw';
                                  return (
                                    <div class="cs-gallery-card">
                                      <div
                                        class="cs-gallery-media"
                                        style={block.aspect ? `aspect-ratio:${block.aspect}` : undefined}
                                      >
                                        {zUrl ? (
                                          <button
                                            type="button"
                                            class="cs-zoom"
                                            data-zoom={zUrl}
                                            data-zoom-alt={item.alt}
                                            aria-label={`View larger: ${item.alt}`}
                                          >
                                            <Picture name={item.image} alt="" sizes={sizes} />
                                          </button>
                                        ) : (
                                          <Picture name={item.image} alt={item.alt} sizes={sizes} />
                                        )}
                                      </div>
                                      {item.label && <span class="cs-gallery-lbl">{item.label}</span>}
                                    </div>
                                  );
                                })}
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'palette' && p.palette) {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-palette-wrap">
                                <Palette swatches={p.palette} variant={p.slug === 'startup-standup' ? 'bencho' : 'strip'} />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'video') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-media-frame">
                                <VideoSlot
                                  name={block.name}
                                  label={block.label}
                                  poster={block.poster}
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'model') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-model-frame">
                                <ModelSlot
                                  name={block.name}
                                  label={block.label}
                                  poster={block.poster}
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'map') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-map-frame">
                                <FestivalMap
                                  name={block.name}
                                  label={block.label}
                                  idSuffix="cs"
                                />
                              </div>
                              {block.caption && (
                                <figcaption>
                                  <span data-lang-text="en">{block.caption}</span>
                                  <span data-lang-text="th">{block.captionTh ?? block.caption}</span>
                                </figcaption>
                              )}
                            </figure>
                          );
                        }

                        if (block.kind === 'sybil-world') {
                          return (
                            <figure class="cs-figure">
                              <div class="cs-world-stage" data-world-stage="night">
                                <div class="cs-world-layer is-night">
                                  <Picture
                                    name="07-sybil-bg-night"
                                    alt="Sybil Husky Arctic fortress under the northern lights (Night mode)"
                                    sizes="(min-width: 900px) 864px, 92vw"
                                  />
                                </div>
                                <div class="cs-world-layer is-day">
                                  <Picture
                                    name="07-sybil-bg-day"
                                    alt="Sybil Husky Arctic fortress at alpine sunrise (Day mode)"
                                    sizes="(min-width: 900px) 864px, 92vw"
                                  />
                                </div>
                              </div>
                              <figcaption data-world-caption>
                                <span data-lang-text="en" data-world-en>
                                  Night mode artwork — 1920×1080 northern lights key visual used in Dark theme.
                                </span>
                                <span data-lang-text="th" data-world-th>
                                  ภาพโหมดกลางคืน (Night Mode) — 1920×1080 ฉากแสงออโรราสำหรับ Dark Theme บนเว็บไซต์จริง
                                </span>
                              </figcaption>
                            </figure>
                          );
                        }

                        if (block.kind === 'sybil-tiers') {
                          const tierSheetZoom = posterUrl('07-sybil-tiers');
                          return (
                            <>
                              <div class="cs-char-grid">
                                {sybilMintTiers.map((tier) => (
                                  <div class="cs-char-card">
                                    <div class="cs-char-thumb">
                                      <img
                                        src={tier.img}
                                        width="160"
                                        height="160"
                                        alt={tier.title}
                                        loading="lazy"
                                        decoding="async"
                                      />
                                    </div>
                                    <div class="cs-char-meta">
                                      <span class="cs-char-badge">{tier.badge}</span>
                                      <strong>{tier.title}</strong>
                                      <span class="cs-char-stats">{tier.stats}</span>
                                    </div>
                                  </div>
                                ))}
                              </div>

                              <figure class="cs-figure">
                                <div class="cs-img-box">
                                  {tierSheetZoom ? (
                                    <button
                                      type="button"
                                      class="cs-zoom"
                                      data-zoom={tierSheetZoom}
                                      data-zoom-alt="Complete six-tier Sybil Husky card design system"
                                      aria-label="View larger: Complete six-tier Sybil Husky card design system"
                                    >
                                      <Picture
                                        name="07-sybil-tiers"
                                        alt=""
                                        sizes="(min-width: 900px) 864px, 92vw"
                                      />
                                    </button>
                                  ) : (
                                    <Picture
                                      name="07-sybil-tiers"
                                      alt="Six husky character cards: Apprentice, Mage, Sorcerer, Supreme, Special, Super Special"
                                      sizes="(min-width: 900px) 864px, 92vw"
                                    />
                                  )}
                                </div>
                                <figcaption>
                                  <span data-lang-text="en">
                                    Complete six-tier card design system exported from Figma for the mint flow.
                                  </span>
                                  <span data-lang-text="th">
                                    ระบบออกแบบการ์ด NFT ครบทั้ง 6 ระดับที่ส่งต่อจาก Figma สู่หน้า Mint บนเว็บจริง
                                  </span>
                                </figcaption>
                              </figure>
                            </>
                          );
                        }

                        if (block.kind === 'sybil-live') {
                          return (
                            <div class="cs-browser-frame">
                              <div class="cs-browser-bar">
                                <div class="cs-browser-dots" aria-hidden="true">
                                  <span />
                                  <span />
                                  <span />
                                </div>
                                <div class="cs-browser-url">
                                  <span class="cs-live-badge">LIVE</span>
                                  <span>sybil-husky.vercel.app</span>
                                </div>
                                <a
                                  href={block.liveUrl}
                                  rel="noopener"
                                  target="_blank"
                                  class="cs-browser-open"
                                >
                                  Open ↗
                                </a>
                              </div>

                              <div class="cs-iframe-stage" data-iframe-stage>
                                <iframe
                                  class="cs-iframe"
                                  data-sybil-iframe
                                  data-src={block.liveUrl}
                                  title="Sybil Husky live website preview"
                                  loading="lazy"
                                />
                              </div>

                              <div class="cs-shot-stage" data-shot-stage hidden>
                                <Picture
                                  name="07-sybil-landing"
                                  alt="Sybil Husky landing page UI shown on laptops and as a section overview"
                                  sizes="(min-width: 900px) 864px, 92vw"
                                />
                              </div>
                            </div>
                          );
                        }

                        return null;
                      })}
                    </section>
                  );
                })}

                <!-- Final Section: Outcome & Tools (hidden on showcase preview) -->
                {
                  !isSybilPreview && (
                    <section id={`${p.slug}-outcome`} class="cs-sec" data-cs-section>
                      <h2 class="cs-h2">Outcome</h2>
                      <p class="cs-prose">
                        <span data-lang-text="en">{cs.outcome}</span>
                        <span data-lang-text="th">{cs.outcomeTh}</span>
                      </p>

                      <div class="cs-tools-bar">
                        <span class="cs-tools-lbl">Tools &amp; Software</span>
                        <div class="cs-tools-list">
                          {p.tools.map((id) => (
                            <span class="cs-tool-pill">
                              <strong>{tools[id].abbr}</strong> {tools[id].name}
                            </span>
                          ))}
                        </div>
                      </div>
                    </section>
                  )
                }
              </div>
            </article>
          </div>
        </div>
      </dialog>
    );
  })
}

<script>
  // ================= Unified Full Case Study Dialog Controller =================
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>('[data-case-dialog]').forEach((dlg) => {
    const slug = dlg.dataset.caseDialog;
    if (slug) dialogs.set(slug, dlg);
  });

  const cursorTip = document.querySelector<HTMLElement>('[data-case-cursor-tip]');
  const HASH_PREFIX = '#read-';
  let activeSlug: string | null = null;

  const hideCursorTip = () => {
    cursorTip?.classList.remove('is-visible');
  };

  // Scale Sybil Husky 1920px live iframe inside its container
  function scaleDialogIframes(dlg: HTMLDialogElement) {
    const stage = dlg.querySelector<HTMLElement>('[data-iframe-stage]');
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
    if (!stage || !frame) return;
    const w = stage.clientWidth;
    if (w <= 0) return;
    const s = w / 1920;
    const targetH = Math.round(Math.min(540, Math.max(320, w * 0.625)));
    stage.style.height = `${targetH}px`;
    frame.style.width = '1920px';
    frame.style.height = `${Math.round(targetH / s)}px`;
    frame.style.transform = `scale(${s.toFixed(4)})`;
  }

  function pauseDialogMedia(dlg: HTMLDialogElement) {
    dlg.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
      if (!v.paused) v.pause();
    });
  }

  function closeAllDialogs(updateHash = false) {
    const prevSlug = activeSlug;
    dialogs.forEach((dlg) => {
      if (dlg.open) {
        pauseDialogMedia(dlg);
        dlg.close();
      }
    });
    activeSlug = null;
    document.documentElement.style.overflow = '';
    if (updateHash && location.hash.startsWith(HASH_PREFIX)) {
      const fallbackHash = prevSlug && document.getElementById(prevSlug) ? `#${prevSlug}` : '#work';
      history.pushState(null, '', fallbackHash);
    }
  }

  function openCaseStudy(slug: string, pushHash = true) {
    if (document.documentElement.classList.contains('ve-active')) return;
    const dlg = dialogs.get(slug);
    if (!dlg) return;

    hideCursorTip();

    // Close any other currently open case study dialog smoothly
    dialogs.forEach((other, otherSlug) => {
      if (otherSlug !== slug && other.open) {
        pauseDialogMedia(other);
        other.close();
      }
    });

    activeSlug = slug;

    const scroller = dlg.querySelector<HTMLElement>('[data-cs-scroller]');
    const tocLinks = [...dlg.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')];
    const sections = [...dlg.querySelectorAll<HTMLElement>('[data-cs-section]')];

    if (!dlg.open) {
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    }

    if (scroller) {
      scroller.scrollTop = 0;
      scroller.focus({ preventScroll: true });
    }
    const firstId = sections[0]?.id;
    if (firstId) {
      tocLinks.forEach((l) => {
        const hit = l.dataset.csToc === firstId;
        l.classList.toggle('is-active', hit);
        if (hit) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
      dlg.dispatchEvent(new CustomEvent('cs-hook-sync'));
    }

    // Lazy-load live iframe if present (Sybil Husky)
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
    if (frame && !frame.src && frame.dataset.src) {
      frame.src = frame.dataset.src;
    }
    requestAnimationFrame(() => scaleDialogIframes(dlg));

    const targetHash = `${HASH_PREFIX}${slug}`;
    if (pushHash && location.hash !== targetHash) {
      history.pushState({ caseStudy: slug }, '', targetHash);
    }
  }

  // Wire per-dialog interactive controls (TOC, Close, Next Project, Sybil toggles)
  dialogs.forEach((dlg, slug) => {
    const scroller = dlg.querySelector<HTMLElement>('[data-cs-scroller]');
    const tocLinks = [...dlg.querySelectorAll<HTMLAnchorElement>('[data-cs-toc]')];
    const sections = [...dlg.querySelectorAll<HTMLElement>('[data-cs-section]')];
    const closeBtn = dlg.querySelector<HTMLButtonElement>('[data-close-case]');
    const nextLink = dlg.querySelector<HTMLAnchorElement>('[data-next-case]');

    // RareUI Hook Sidebar spring controller (present when [data-hook-sidebar] is used, e.g. K2O)
    const hookRoot = dlg.querySelector<HTMLElement>('[data-hook-sidebar]');
    let syncHookSidebar = () => {};
    if (hookRoot) {
      const hookItems = [...hookRoot.querySelectorAll<HTMLAnchorElement>('[data-hook-item]')];
      const hoverRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="hover"]');
      const activeRail = hookRoot.querySelector<HTMLElement>('[data-hook-rail="active"]');
      const hStem = hoverRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const hCorner = hoverRail?.querySelector<SVGElement>('[data-hook-corner]');
      const aStem = activeRail?.querySelector<HTMLElement>('[data-hook-stem]');
      const aCorner = activeRail?.querySelector<SVGElement>('[data-hook-corner]');

      if (hookItems.length && hoverRail && activeRail && hStem && hCorner && aStem && aCorner) {
        const CORNER = 6;
        const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
        let centers: number[] = [];
        let hoverIdx: number | null = null;
        let pointerInside = false;
        let focusInside = false;
        let placed = false;

        const aTop = { val: 0, vel: 0, target: 0 };
        const aY = { val: 16, vel: 0, target: 16 };
        const hTop = { val: 0, vel: 0, target: 0 };
        const hY = { val: 16, vel: 0, target: 16 };
        let rafId = 0;
        let lastTs = 0;

        const stepSpring = (s: { val: number; vel: number; target: number }, dtSec: number): boolean => {
          const steps = Math.max(1, Math.ceil(dtSec / 0.004));
          const h = dtSec / steps;
          for (let i = 0; i < steps; i++) {
            const force = -420 * (s.val - s.target) - 34 * s.vel;
            s.vel += (force / 0.7) * h;
            s.val += s.vel * h;
          }
          if (Math.abs(s.target - s.val) < 0.08 && Math.abs(s.vel) < 0.08) {
            s.val = s.target;
            s.vel = 0;
            return false;
          }
          return true;
        };

        const renderRails = () => {
          aStem.style.top = `${aTop.val.toFixed(2)}px`;
          aStem.style.height = `${Math.max(0, aY.val - CORNER - aTop.val).toFixed(2)}px`;
          aCorner.style.top = `${(aY.val - CORNER).toFixed(2)}px`;

          hStem.style.top = `${hTop.val.toFixed(2)}px`;
          hStem.style.height = `${Math.max(0, hY.val - CORNER - hTop.val).toFixed(2)}px`;
          hCorner.style.top = `${(hY.val - CORNER).toFixed(2)}px`;
        };

        const animTick = (ts: number) => {
          const dt = lastTs ? Math.min(0.04, (ts - lastTs) * 0.001) : 1 / 60;
          lastTs = ts;
          if (reduceMq.matches) {
            aTop.val = aTop.target;
            aTop.vel = 0;
            aY.val = aY.target;
            aY.vel = 0;
            hTop.val = hTop.target;
            hTop.vel = 0;
            hY.val = hY.target;
            hY.vel = 0;
            renderRails();
            rafId = 0;
            lastTs = 0;
            return;
          }
          const m1 = stepSpring(aTop, dt);
          const m2 = stepSpring(aY, dt);
          const m3 = stepSpring(hTop, dt);
          const m4 = stepSpring(hY, dt);
          renderRails();
          if (m1 || m2 || m3 || m4) {
            rafId = requestAnimationFrame(animTick);
          } else {
            rafId = 0;
            lastTs = 0;
          }
        };

        const schedule = () => {
          if (!rafId) {
            lastTs = 0;
            rafId = requestAnimationFrame(animTick);
          }
        };

        const measure = () => {
          centers = hookItems.map((el) => el.offsetTop + el.offsetHeight * 0.5);
        };

        syncHookSidebar = () => {
          measure();
          const activeIndex = hookItems.findIndex((el) => el.classList.contains('is-active'));
          const activeCenter = activeIndex >= 0 ? (centers[activeIndex] ?? null) : null;
          const hoverCenter = hoverIdx !== null ? (centers[hoverIdx] ?? null) : null;

          activeRail.classList.toggle('is-visible', activeCenter !== null);
          if (activeCenter !== null) {
            aTop.target = 0;
            aY.target = activeCenter;
            if (!placed && activeCenter > 0) {
              placed = true;
              aTop.val = 0;
              aY.val = activeCenter;
            }
          }

          const showHover = (pointerInside || focusInside) && hoverIdx !== null && hoverIdx !== activeIndex && hoverCenter !== null;
          hoverRail.classList.toggle('is-visible', showHover);
          if (hoverCenter !== null) {
            const from =
              activeCenter !== null && hoverCenter <= activeCenter
                ? Math.max(0, hoverCenter - CORNER)
                : (activeCenter ?? 0);
            if (!hoverRail.classList.contains('is-ready')) {
              hoverRail.classList.add('is-ready');
              hTop.val = from;
              hY.val = hoverCenter;
            }
            hTop.target = from;
            hY.target = hoverCenter;
          }

          renderRails();
          schedule();
        };

        hookItems.forEach((item, idx) => {
          item.addEventListener('pointerenter', () => {
            hoverIdx = idx;
            pointerInside = true;
            syncHookSidebar();
          });
          item.addEventListener('focus', () => {
            hoverIdx = idx;
            focusInside = true;
            syncHookSidebar();
          });
          item.addEventListener('blur', () => {
            focusInside = false;
            syncHookSidebar();
          });
        });

        hookRoot.addEventListener('pointerleave', () => {
          pointerInside = false;
          syncHookSidebar();
        });

        new ResizeObserver(syncHookSidebar).observe(hookRoot);
        dlg.addEventListener('cs-hook-sync', () => requestAnimationFrame(syncHookSidebar));
      }
    }

    const setActiveToc = (id: string) => {
      for (const link of tocLinks) {
        const hit = link.dataset.csToc === id;
        link.classList.toggle('is-active', hit);
        if (hit) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      syncHookSidebar();
    };

    closeBtn?.addEventListener('click', () => closeAllDialogs(true));

    // Next project switches seamlessly into the next project's Full Case Study
    nextLink?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const nextSlug = nextLink.dataset.nextCase;
      if (nextSlug) openCaseStudy(nextSlug, true);
    });

    let tocPinnedUntil = 0;
    const clearPin = () => {
      tocPinnedUntil = 0;
    };
    scroller?.addEventListener('wheel', clearPin, { passive: true });
    scroller?.addEventListener('touchstart', clearPin, { passive: true });

    // TOC smooth scroll inside reader
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = link.dataset.csToc;
        const target = id ? dlg.querySelector<HTMLElement>(`#${CSS.escape(id)}`) : null;
        if (target && scroller) {
          tocPinnedUntil = performance.now() + 900;
          setActiveToc(id!);
          const isOverview = target.classList.contains('cs-sec-overview');
          scroller.scrollTo({
            top: isOverview ? 0 : Math.max(0, target.offsetTop - 48),
            behavior: 'smooth',
          });
        }
      });
    });

    // Live TOC spy on scroll
    scroller?.addEventListener(
      'scroll',
      () => {
        if (performance.now() < tocPinnedUntil) return;
        const atBottom =
          scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight <= 24;
        if (atBottom && sections.length) {
          setActiveToc(sections[sections.length - 1].id);
          return;
        }
        const cutoff = scroller.scrollTop + scroller.clientHeight * 0.28;
        let currentId = sections[0]?.id || '';
        for (const sec of sections) {
          if (sec.offsetTop <= cutoff) currentId = sec.id;
        }
        if (currentId) setActiveToc(currentId);
      },
      { passive: true },
    );

    // Handle ESC / native dialog close
    dlg.addEventListener('close', () => {
      pauseDialogMedia(dlg);
      if (activeSlug === slug) {
        activeSlug = null;
        document.documentElement.style.overflow = '';
        if (location.hash === `${HASH_PREFIX}${slug}`) {
          const fallbackHash = document.getElementById(slug) ? `#${slug}` : '#work';
          history.replaceState(null, '', fallbackHash);
        }
      }
    });

    // Sybil Day/Night World Switcher
    const worldStage = dlg.querySelector<HTMLElement>('[data-world-stage]');
    const worldBtns = [...dlg.querySelectorAll<HTMLButtonElement>('[data-world-mode]')];
    const worldCaptionEn = dlg.querySelector<HTMLElement>('[data-world-en]');
    const worldCaptionTh = dlg.querySelector<HTMLElement>('[data-world-th]');
    worldBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.worldMode || 'night';
        if (worldStage) worldStage.dataset.worldStage = mode;
        worldBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (worldCaptionEn) {
          worldCaptionEn.textContent =
            mode === 'day'
              ? 'Day mode artwork — 1920×1080 alpine sunrise key visual used in Light theme.'
              : 'Night mode artwork — 1920×1080 northern lights key visual used in Dark theme.';
        }
        if (worldCaptionTh) {
          worldCaptionTh.textContent =
            mode === 'day'
              ? 'ภาพโหมดกลางวัน (Day Mode) — 1920×1080 ฉากแสงอาทิตย์ยามเช้าสำหรับ Light Theme บนเว็บไซต์จริง'
              : 'ภาพโหมดกลางคืน (Night Mode) — 1920×1080 ฉากแสงออโรราสำหรับ Dark Theme บนเว็บไซต์จริง';
        }
      });
    });

    // Sybil Live Site / Mockup Toggle
    const lpBtns = [...dlg.querySelectorAll<HTMLButtonElement>('[data-lp-mode]')];
    const iframeStage = dlg.querySelector<HTMLElement>('[data-iframe-stage]');
    const shotStage = dlg.querySelector<HTMLElement>('[data-shot-stage]');
    lpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.lpMode || 'live';
        lpBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (iframeStage && shotStage) {
          const isLive = mode === 'live';
          iframeStage.hidden = !isLive;
          shotStage.hidden = isLive;
          if (isLive) {
            const frame = dlg.querySelector<HTMLIFrameElement>('[data-sybil-iframe]');
            if (frame && !frame.src && frame.dataset.src) frame.src = frame.dataset.src;
            requestAnimationFrame(() => scaleDialogIframes(dlg));
          }
        }
      });
    });

    if (iframeStage) {
      new ResizeObserver(() => scaleDialogIframes(dlg)).observe(iframeStage);
      window.addEventListener('resize', () => {
        if (dlg.open) scaleDialogIframes(dlg);
      });
    }

    // K2O Sidebar Palette Switcher (Opt 1–4, real-time Light/Dark comparison)
    const paletteBtns = [...dlg.querySelectorAll<HTMLButtonElement>('[data-k2o-palette-btn]')];
    if (paletteBtns.length) {
      const validPalettes = new Set(paletteBtns.map((b) => b.dataset.k2oPaletteBtn || ''));
      const applyK2oPalette = (id: string, persist = true) => {
        if (!validPalettes.has(id)) return;
        dlg.dataset.k2oPalette = id;
        paletteBtns.forEach((b) => {
          const active = b.dataset.k2oPaletteBtn === id;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        if (persist) {
          try {
            localStorage.setItem('k2o-palette', id);
          } catch {}
        }
      };

      try {
        const saved = localStorage.getItem('k2o-palette');
        if (saved && validPalettes.has(saved)) applyK2oPalette(saved, false);
      } catch {}

      paletteBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.k2oPaletteBtn;
          if (id) applyK2oPalette(id, true);
        });
      });

      const themeLabel = dlg.querySelector<HTMLElement>('[data-k2o-theme-label]');
      if (themeLabel) {
        const syncThemeLabel = () => {
          themeLabel.textContent =
            document.documentElement.dataset.theme === 'dark' ? 'Dark' : 'Light';
        };
        syncThemeLabel();
        new MutationObserver(syncThemeLabel).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
    }
  });

  // Global click delegation for all [data-open-case] triggers (project titles)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element)?.closest<HTMLElement>('[data-open-case]');
    if (!trigger) return;
    if (document.documentElement.classList.contains('ve-active')) return;
    const slug = trigger.dataset.openCase;
    if (slug && dialogs.has(slug)) {
      e.preventDefault();
      openCaseStudy(slug, true);
    }
  });

  // Hash & browser Back/Forward sync
  const syncFromHash = () => {
    if (location.hash.startsWith(HASH_PREFIX)) {
      const slug = location.hash.slice(HASH_PREFIX.length);
      if (dialogs.has(slug)) {
        openCaseStudy(slug, false);
        return;
      }
    }
    if (activeSlug) {
      closeAllDialogs(false);
    }
  };
  window.addEventListener('hashchange', syncFromHash);
  window.addEventListener('popstate', syncFromHash);
  syncFromHash();

  // ================= Floating Cursor Tooltip ("Click to Explore full project") =================
  if (cursorTip) {
    let hoveredTrigger: HTMLElement | null = null;

    const positionTip = (x: number, y: number) => {
      const offsetX = 14;
      const offsetY = 16;
      const rect = cursorTip.getBoundingClientRect();
      const tipW = rect.width || 240;
      const tipH = rect.height || 36;
      const clampedX = Math.min(x + offsetX, window.innerWidth - tipW - 12);
      const clampedY = Math.min(y + offsetY, window.innerHeight - tipH - 12);
      cursorTip.style.transform = `translate3d(${Math.round(clampedX)}px, ${Math.round(clampedY)}px, 0)`;
    };

    document.addEventListener(
      'pointerover',
      (e) => {
        if (e.pointerType === 'touch') return;
        if (document.documentElement.classList.contains('ve-active')) return;
        const trigger = (e.target as Element)?.closest<HTMLElement>('[data-case-trigger]');
        if (!trigger) return;
        hoveredTrigger = trigger;
        positionTip(e.clientX, e.clientY);
        cursorTip.classList.add('is-visible');
      },
      { passive: true },
    );

    document.addEventListener(
      'pointermove',
      (e) => {
        if (!hoveredTrigger || e.pointerType === 'touch') return;
        positionTip(e.clientX, e.clientY);
      },
      { passive: true },
    );

    document.addEventListener(
      'pointerout',
      (e) => {
        if (!hoveredTrigger) return;
        const next = (e.relatedTarget as Element | null)?.closest<HTMLElement>('[data-case-trigger]');
        if (next === hoveredTrigger) return;
        hoveredTrigger = null;
        hideCursorTip();
      },
      { passive: true },
    );

    window.addEventListener(
      'scroll',
      () => {
        if (hoveredTrigger) {
          hoveredTrigger = null;
          hideCursorTip();
        }
      },
      { passive: true },
    );
    window.addEventListener('blur', hideCursorTip);
  }
</script>

<style>
  /* ================= Floating Cursor Tooltip (Reference Pill Bubble) ================= */
  .case-cursor-tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    user-select: none;
    padding: 10px 16px;
    border-radius: 4px 18px 18px 18px;
    background: #141312;
    color: #f3f1ed;
    border: 1px solid rgb(20 19 18 / 0.14);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.28);
    font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    opacity: 0;
    scale: 0.94;
    transform-origin: top left;
    transition:
      opacity 0.14s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.14s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }
  :global(:root[data-theme='dark']) .case-cursor-tip {
    background: #f3f1ed;
    color: #141312;
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.5);
  }
  .case-cursor-tip.is-visible {
    opacity: 1;
    scale: 1;
  }
  @media (any-hover: none) and (pointer: coarse) {
    .case-cursor-tip {
      display: none;
    }
  }

  /* ================= Full-Screen Editorial Case Study Reader ================= */
  .cs-reader {
    --cs-bg: #fbf5eb;
    --cs-side-bg: #fbf5eb;
    --cs-surface: #ffffff;
    --cs-surface-2: #f2ebe0;
    --cs-fg: #171514;
    --cs-fg-soft: #3b3732;
    --cs-muted: #6b655e;
    --cs-line: rgb(23 21 20 / 0.1);
    --cs-line-strong: rgb(23 21 20 / 0.16);
    --cs-accent: #ff2b2b;
    --cs-accent-soft: rgb(255 43 43 / 0.1);
    --cs-accent-border: rgb(255 43 43 / 0.28);
    --cs-shadow: rgb(23 21 20 / 0.12);
    --cs-inset: rgb(255 255 255 / 0.72);

    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--cs-bg);
    color: var(--cs-fg);
    overflow: hidden;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  :global(:root[data-theme='dark']) .cs-reader {
    --cs-bg: #242424;
    --cs-side-bg: #242424;
    --cs-surface: #2d2d2d;
    --cs-surface-2: #363636;
    --cs-fg: #fbf5eb;
    --cs-fg-soft: #d6d0c6;
    --cs-muted: #9e988e;
    --cs-line: rgb(251 245 235 / 0.1);
    --cs-line-strong: rgb(251 245 235 / 0.18);
    --cs-accent: #ff2b2b;
    --cs-accent-soft: rgb(255 43 43 / 0.14);
    --cs-accent-border: rgb(255 43 43 / 0.34);
    --cs-shadow: rgb(0 0 0 / 0.42);
    --cs-inset: rgb(255 255 255 / 0.08);
  }
  .cs-reader[open] {
    animation: cs-slide-in 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes cs-slide-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-reader[open] {
      animation: none;
    }
  }
  .cs-reader::backdrop {
    background: rgb(23 21 20 / 0.6);
  }
  :global(:root[data-theme='dark']) .cs-reader::backdrop {
    background: rgb(18 18 18 / 0.88);
  }

  .cs-layout {
    display: grid;
    grid-template-columns: 256px minmax(0, 1fr);
    width: 100%;
    height: 100dvh;
  }

  .cs-sidebar {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 24px 36px 32px;
    background: var(--cs-side-bg);
    border-right: 1px solid var(--cs-line);
    height: 100dvh;
    user-select: none;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .cs-side-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
  }

  .cs-side-tools {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }
  .cs-side-tools :global(.theme-toggle.is-compact) {
    width: 28px;
    height: 28px;
  }

  .cs-back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--cs-muted);
    font: 400 14px / 1.25 var(--f-nav);
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.16s ease, transform 0.16s ease;
  }
  .cs-back:hover {
    color: var(--cs-fg);
    transform: translateX(-2px);
  }

  .cs-toc-wrap {
    display: grid;
    gap: 12px;
    margin-block: auto;
  }

  .cs-proj-name {
    margin: 0 0 4px 12px;
    font-family: var(--f-display);
    font-size: 18px;
    font-weight: 400;
    color: var(--cs-fg);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .cs-toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .cs-toc-link {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding-inline: 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    color: var(--cs-muted);
    font: 400 14px / 1.25 var(--f-nav);
    text-decoration: none;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .cs-toc-link:hover {
    color: var(--cs-fg);
  }
  .cs-toc-bar {
    width: 12px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.45;
    flex: none;
    transition: width 0.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
  }
  .cs-toc-link.is-active {
    color: var(--cs-fg);
    border-color: var(--cs-line-strong);
    background: var(--cs-surface);
    box-shadow: inset 0 1px 0 var(--cs-inset);
  }
  .cs-toc-link.is-active .cs-toc-bar {
    width: 20px;
    opacity: 1;
    background: var(--cs-accent);
  }

  /* RareUI Hook Sidebar (K2O trial) */
  .cs-hook-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cs-hook-rail {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cs-hook-rail.is-visible {
    opacity: 1;
  }
  .cs-hook-rail.is-hover {
    color: color-mix(in srgb, var(--cs-fg) 30%, transparent);
  }
  .cs-hook-rail.is-accent {
    color: var(--cs-accent);
  }
  .cs-hook-stem {
    position: absolute;
    left: 2px;
    top: 0;
    width: 1px;
    background-image: repeating-linear-gradient(
      to top,
      transparent 0 2px,
      currentColor 2px 4px
    );
  }
  .cs-hook-corner {
    position: absolute;
    left: 2px;
    top: 0;
    overflow: visible;
  }
  .cs-hook-item {
    display: block;
    border-radius: 8px;
    padding: 6px 8px 6px 20px;
    text-align: left;
    font: 400 14px / 1.4 var(--f-nav);
    color: color-mix(in srgb, var(--cs-fg) 52%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cs-hook-item:hover {
    color: color-mix(in srgb, var(--cs-fg) 84%, transparent);
  }
  .cs-hook-item.is-active {
    color: var(--cs-fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-hook-rail,
    .cs-hook-item {
      transition: none;
    }
  }

  .cs-side-foot {
    display: grid;
    gap: 16px;
  }
  .cs-live-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line-strong);
    color: var(--cs-fg);
    font: 400 13px / 1.2 var(--f-nav);
    text-decoration: none;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }
  .cs-live-pill:hover {
    background: var(--cs-surface-2);
    border-color: var(--cs-fg);
  }

  .cs-next {
    display: grid;
    gap: 4px;
    padding-left: 12px;
    text-decoration: none;
    color: var(--cs-fg);
  }
  .cs-next-lbl {
    font: 400 12px / 1.2 var(--f-nav);
    color: var(--cs-muted);
  }
  .cs-next-title {
    font: 400 14px / 1.3 var(--f-nav);
    color: var(--cs-fg);
    transition: color 0.16s ease;
  }
  .cs-next:hover .cs-next-title {
    color: var(--cs-accent);
  }

  /* Right Scrollable Reading Area */
  .cs-scroller {
    height: 100dvh;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
    padding: 0 0 120px;
    box-sizing: border-box;
  }
  .cs-scroller:focus {
    outline: none;
  }

  .cs-scope {
    display: block;
    width: 100%;
  }

  /* Centered 864px media column with 60px outer breathing room */
  .cs-pad,
  .cs-article {
    width: 100%;
    max-width: calc(864px + 120px);
    padding-inline: 60px;
    box-sizing: border-box;
    margin-inline: auto;
  }

  .cs-article {
    margin-top: 72px;
    display: grid;
    gap: 72px;
  }

  .cs-sec {
    display: grid;
    gap: 24px;
    scroll-margin-top: 48px;
  }
  .cs-sec-overview {
    scroll-margin-top: 0;
  }

  /* Left-aligned 720px text column centered inside the 864px media frame */
  .cs-h1,
  .cs-subtitle,
  .cs-meta-grid,
  .cs-h2,
  .cs-prose,
  .cs-callout-grid,
  .cs-tools-bar,
  .cs-sec-head-row,
  .cs-figure figcaption {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    text-align: left;
  }

  .cs-sec-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cs-sec-head-row .cs-h2 {
    width: auto;
    margin: 0;
  }

  /* ================= Full-Width Flush-Top Cover Banner (486px) ================= */
  .cs-hero-banner {
    position: relative;
    width: 100%;
    height: 486px;
    border-radius: 0;
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: 0 20px 48px var(--cs-shadow);
  }
  .cs-hero-banner.is-logo {
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 56px);
  }
  .cs-hero-logo {
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: contain;
  }

  .cs-hero-banner.is-photo :global(picture),
  .cs-hero-banner.is-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cover-pos, center center);
  }
  .cs-hero-banner.is-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.04) 0%, rgb(0 0 0 / 0) 60%, rgb(0 0 0 / 0.18) 100%);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .cs-hero-banner.is-photo::after {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0) 55%, rgb(36 36 36 / 0.54) 100%);
  }

  .cs-hero-banner.is-framed {
    display: grid;
    place-items: center;
    padding: 36px 48px;
  }
  .cs-hero-framed-inner {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }
  .cs-hero-framed-inner :global(picture),
  .cs-hero-framed-inner :global(img) {
    display: block;
    max-width: 100%;
    max-height: 414px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 52px rgb(0 0 0 / 0.48);
  }

  .cs-hero-banner.is-trio {
    display: grid;
    place-items: center;
    padding: 36px 48px;
  }
  .cs-hero-trio {
    width: 100%;
    max-width: 960px;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .cs-trio-card {
    height: 356px;
    border-radius: 12px;
    overflow: hidden;
    background: #1c1a18;
    border: 1px solid rgb(239 233 222 / 0.12);
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.48);
    transform: translateY(8px);
  }
  .cs-trio-card.is-center {
    height: 396px;
    transform: translateY(-4px);
    box-shadow: 0 24px 56px rgb(0 0 0 / 0.62);
  }
  .cs-hero-trio.is-square {
    max-width: 1020px;
  }
  .cs-hero-trio.is-square .cs-trio-card {
    height: auto;
    aspect-ratio: 1 / 1;
  }
  .cs-hero-trio.is-square .cs-trio-card.is-center {
    height: auto;
    aspect-ratio: 1 / 1;
    transform: translateY(-8px) scale(1.04);
  }
  .cs-trio-card :global(picture),
  .cs-trio-card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ================= Editorial Typography ================= */
  .cs-h1 {
    margin: 12px auto 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--cs-fg);
  }

  .cs-subtitle {
    margin: -8px auto 0;
    font: 400 clamp(16px, 1.4vw, 19px) / 1.55 var(--f-body);
    color: var(--cs-muted);
  }

  .cs-meta-grid {
    margin: 8px auto;
    padding-block: 20px;
    border-top: 1px solid var(--cs-line);
    border-bottom: 1px solid var(--cs-line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .cs-meta-grid dt {
    font: 500 12px / 1.3 var(--f-body);
    color: var(--cs-muted);
    margin-bottom: 4px;
  }
  .cs-meta-grid dd {
    margin: 0;
    font: 500 14px / 1.45 var(--f-body);
    color: var(--cs-fg);
  }

  /* ================= Showcase Spec Options A / B / C Comparison ================= */
  .cs-opt-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--cs-accent-soft);
    border: 1px solid var(--cs-accent-border);
    color: var(--cs-accent);
    font: 700 10.5px / 1.1 var(--f-body);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Option A: Sidebar Spec Sheet */
  .cs-opt-a {
    margin-block: 12px;
    padding: 12px;
    border-radius: 12px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    display: grid;
    gap: 10px;
  }
  .cs-opt-a .cs-opt-badge {
    justify-self: start;
  }
  .cs-opt-a-list {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .cs-opt-a-list dt {
    font: 500 10.5px / 1.2 var(--f-body);
    color: var(--cs-muted);
  }
  .cs-opt-a-list dd {
    margin: 2px 0 0;
    font: 500 12px / 1.35 var(--f-body);
    color: var(--cs-fg);
  }
  .cs-opt-a-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
  }
  .cs-opt-a-tools span {
    padding: 3px 6px;
    border-radius: 5px;
    background: var(--cs-surface-2);
    border: 1px solid var(--cs-line);
    font: 700 10.5px / 1 var(--f-body);
    color: var(--cs-accent);
  }

  /* Option B + C Container in Right Column */
  .cs-spec-compare {
    width: 100%;
    max-width: 720px;
    margin: 8px auto;
    display: grid;
    gap: 20px;
    text-align: left;
  }
  .cs-opt-group {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  /* Option B: 4-Box Bento Spec Cards */
  .cs-bento-specs {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .cs-bento-card {
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .cs-bento-card dt {
    font: 500 11.5px / 1.2 var(--f-body);
    color: var(--cs-muted);
  }
  .cs-bento-card dd {
    margin: 0;
    font: 600 14px / 1.4 var(--f-body);
    color: var(--cs-fg);
  }
  .cs-bento-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 2px;
  }
  .cs-bento-tools span {
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--cs-surface-2);
    border: 1px solid var(--cs-line);
    font: 700 12px / 1 var(--f-body);
    color: var(--cs-accent);
  }

  /* Option C: Inline Spec Tags */
  .cs-inline-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cs-spec-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    font: 500 12.5px / 1.1 var(--f-body);
    color: var(--cs-fg);
  }
  .cs-spec-chip strong {
    color: var(--cs-muted);
    font-weight: 500;
  }
  .cs-spec-chip.is-tool strong {
    color: var(--cs-accent);
    font-weight: 700;
  }

  .cs-h2 {
    margin: 0 auto;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--cs-fg);
  }

  .cs-prose {
    margin: 0 auto;
    font: 400 clamp(16px, 1.2vw, 18px) / 1.7 var(--f-body);
    color: var(--cs-fg-soft);
  }

  .cs-callout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 4px;
  }
  .cs-callout {
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    display: grid;
    gap: 8px;
  }
  .cs-callout h3 {
    margin: 0;
    font: 700 15px / 1.3 var(--f-body);
    color: var(--cs-accent);
  }
  .cs-callout p {
    margin: 0;
    font: 400 14px / 1.55 var(--f-body);
    color: var(--cs-fg-soft);
  }

  /* ================= Segmented Control Pill ================= */
  .cs-seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border-radius: 999px;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
  }
  .cs-seg-btn {
    border: 0;
    border-radius: 999px;
    padding: 7px 14px;
    background: transparent;
    color: var(--cs-muted);
    font: 600 12.5px / 1 var(--f-body);
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .cs-seg-btn:hover {
    color: var(--cs-fg);
  }
  .cs-seg-btn.is-active {
    background: var(--cs-fg);
    color: var(--cs-bg);
  }

  /* ================= Figures, Galleries & Interactive Media (864px) ================= */
  .cs-figure {
    margin: 8px 0 0;
    display: grid;
    gap: 12px;
  }
  .cs-img-box {
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    box-shadow: 0 20px 48px var(--cs-shadow);
  }
  .cs-img-box :global(picture),
  .cs-img-box :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cs-figure figcaption {
    font: 400 13px / 1.45 var(--f-body);
    color: var(--cs-muted);
  }

  .cs-zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    transition: filter 0.2s ease, transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-zoom:hover {
    filter: brightness(1.06);
  }
  .cs-zoom:focus-visible {
    outline: 2px solid var(--cs-accent);
    outline-offset: -2px;
  }

  /* Multi-column Galleries */
  .cs-gallery {
    display: grid;
    gap: 16px;
  }
  .cs-gallery.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cs-gallery.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .cs-gallery-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    box-shadow: 0 14px 36px var(--cs-shadow);
  }
  .cs-gallery-media {
    position: relative;
