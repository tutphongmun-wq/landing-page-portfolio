    border: 0;
    background: var(--cs-surface-2, var(--c-bg));
    color: var(--cs-muted, var(--c-muted));
    font: 500 12px / 1 var(--f-nav, var(--f-body));
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .bf-ch-btn:hover {
    color: var(--cs-fg, var(--c-fg));
  }
  .bf-ch-btn.is-active {
    background: var(--cs-fg, var(--c-fg));
    color: var(--cs-bg, var(--c-bg));
  }
  .bf-ch-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    flex: none;
  }

  /* Stage Container */
  .bf-stage-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    align-items: center;
    gap: 8px;
    width: 100%;
  }
  .bf-root.is-fullscreen .bf-stage-wrap {
    max-width: 1240px;
    height: 100%;
    margin-inline: auto;
  }

  .bf-nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--cs-surface-2, var(--c-bg));
    color: var(--cs-fg, var(--c-fg));
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease, opacity 0.16s ease, transform 0.16s ease;
  }
  .bf-nav:hover:not(:disabled) {
    background: var(--cs-fg, var(--c-fg));
    color: var(--cs-bg, var(--c-bg));
  }
  .bf-nav:active:not(:disabled) {
    transform: scale(0.94);
  }
  .bf-nav:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .bf-stage {
    position: relative;
    width: 100%;
    padding-block: 18px 34px;
    perspective: 2200px;
    perspective-origin: 50% 48%;
    overflow: visible;
    outline: none;
    touch-action: pan-y;
  }

  /* Physical 2:1 Book Frame (two 1:1 square pages joined at the center spine) */
  .bf-book {
    position: relative;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 2 / 1;
    margin-inline: auto;
    transform-style: preserve-3d;
    cursor: grab;
    will-change: transform;
  }
  .bf-book:active {
    cursor: grabbing;
  }
  .bf-root.is-fullscreen .bf-book {
    max-width: min(1040px, calc((100dvh - 180px) * 2));
  }

  /* Subtle ambient contact shadow on the desk directly under the book */
  .bf-ground {
    position: absolute;
    top: 4%;
    bottom: -4%;
    left: 50%;
    right: 0;
    border-radius: 10px;
    background: radial-gradient(ellipse at 50% 60%, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0) 74%);
    transform: translateZ(-2px);
    pointer-events: none;
  }

  /* Layered paper stack fore-edges (dynamic thickness via --stack-w) */
  .bf-stack {
    position: absolute;
    top: 2px;
    bottom: 2px;
    width: var(--stack-w, 0px);
    pointer-events: none;
    transition: width 0.3s ease, opacity 0.3s ease;
    background-color: #efece6;
    background-image: repeating-linear-gradient(
      to right,
      rgb(0 0 0 / 0.11) 0 1px,
