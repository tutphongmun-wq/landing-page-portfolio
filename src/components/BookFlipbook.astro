  }

  /* Cylindrical book-binding gutter shading on inner edges */
  .bf-gutter {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    pointer-events: none;
  }
  .bf-gutter-left {
    right: 0;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0) 0%,
      rgb(255 255 255 / 0.08) 38%,
      rgb(0 0 0 / 0.07) 78%,
      rgb(0 0 0 / 0.22) 100%
    );
  }
  .bf-gutter-right {
    left: 0;
    background: linear-gradient(
      to left,
      rgb(0 0 0 / 0) 0%,
      rgb(255 255 255 / 0.08) 38%,
      rgb(0 0 0 / 0.07) 78%,
      rgb(0 0 0 / 0.22) 100%
    );
  }
  .bf-book[data-state='front'] .bf-gutter-right,
  .bf-book[data-state='back'] .bf-gutter-left {
    opacity: 0.25;
  }

  /* Dynamic cast shadow swept by the turning sheet */
  .bf-cast {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    opacity: 0;
    pointer-events: none;
