---
// Custom 3D Interactive Book Flipbook for 16 Personalities (60 pages / 31 spreads).
// Features:
//  - Closed square front/back cover smoothly centering & unfolding into a 2:1 open spread
//  - Multi-strip 3D curved paper-bend turning sheets with real-time Lambertian lighting & cast shadows
//  - Dynamic layered paper-stack thickness on left & right fore-edges
//  - Pointer drag-to-flip, hover corner peek, click-to-turn, keyboard arrows, staggered chapter cascade
//  - Scrubber bar, live chapter/MBTI title, color-coded chapter jump pills, and fullscreen mode
//  - Lazy sliding-window page preloading (zero network cost until #read-16-personalities is opened)
import { assetUrl } from '../lib/media';

interface Props {
  basePath?: string;
}

const { basePath = assetUrl('media/book-16p/') } = Astro.props;

const chapters = [
  { spread: 0, label: 'Cover', dot: '' },
  { spread: 2, label: 'Contents', dot: '' },
  { spread: 5, label: 'Quiz', dot: '' },
  { spread: 9, label: 'Analysts', dot: '#C47ACC' },
  { spread: 14, label: 'Diplomats', dot: '#8FCC52' },
  { spread: 19, label: 'Sentinels', dot: '#52BBCC' },
  { spread: 24, label: 'Explorers', dot: '#F7C64B' },
];
---

<div class="bf-root" data-book-flipbook data-base-path={basePath} data-total-pages="60">
  <!-- Frosted blurred backdrop for fullscreen "pick up closer" mode -->
  <div class="bf-fs-backdrop" data-bf-backdrop aria-hidden="true"></div>

  <!-- Floating stage + unified minimal dock -->
  <div class="bf-shell" data-bf-shell>
    <!-- 3D Book Stage (floats directly on page background, full 864px width) -->
    <div class="bf-stage" data-bf-stage tabindex="0" role="region" aria-label="16 Personalities 60-page interactive book">
      <div class="bf-book" data-bf-book data-state="front">
        <!-- Layered paper thickness stacks (left & right fore-edges) -->
        <div class="bf-stack bf-stack-left" data-bf-stack-left aria-hidden="true"></div>
        <div class="bf-stack bf-stack-right" data-bf-stack-right aria-hidden="true"></div>

        <!-- Ground ambient contact shadow beneath the physical book -->
        <div class="bf-ground" data-bf-ground aria-hidden="true"></div>

        <!-- Stationary left page (even pages 2,4,...,60) -->
        <div class="bf-slot bf-slot-left" data-bf-slot-left>
          <div class="bf-page-surface">
            <img class="bf-page-img" data-bf-img-left alt="" decoding="async" draggable="false" />
            <div class="bf-gutter bf-gutter-left" aria-hidden="true"></div>
            <div class="bf-cast bf-cast-left" data-bf-cast-left aria-hidden="true"></div>
          </div>
        </div>

        <!-- Stationary right page (odd pages 1,3,...,59) -->
        <div class="bf-slot bf-slot-right" data-bf-slot-right>
          <div class="bf-page-surface">
            <img class="bf-page-img" data-bf-img-right alt="" decoding="async" draggable="false" />
            <div class="bf-gutter bf-gutter-right" aria-hidden="true"></div>
            <div class="bf-cast bf-cast-right" data-bf-cast-right aria-hidden="true"></div>
          </div>
        </div>

        <!-- Center binding spine crease -->
        <div class="bf-spine-crease" data-bf-spine aria-hidden="true"></div>

        <!-- Dynamic 3D curved turning sheets canvas (zero subpixel seams) -->
        <div class="bf-turns" data-bf-turns data-active-count="0" aria-hidden="true">
          <canvas class="bf-turns-canvas" data-bf-turns-canvas></canvas>
        </div>
      </div>
    </div>

    <!-- Unified Clean Minimal Bottom Control Dock -->
    <div class="bf-dock" data-bf-dock>
      <div class="bf-bar">
        <div class="bf-bar-left">
          <div class="bf-arrows" role="group" aria-label="Turn pages">
            <button
              type="button"
              class="bf-ghost-btn"
              data-bf-prev
              aria-label="Previous spread"
              title="Previous spread"
              disabled
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="bf-ghost-btn"
              data-bf-next
              aria-label="Next spread"
              title="Next spread"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>

          <span class="bf-divider" aria-hidden="true"></span>

          <div class="bf-meta">
            <span class="bf-counter" data-bf-counter>1 / 60</span>
            <span class="bf-sep" aria-hidden="true">·</span>
            <span class="bf-title" data-bf-title>Front Cover</span>
          </div>
        </div>

        <div class="bf-scrub-wrap">
          <input
            type="range"
            class="bf-scrubber"
            data-bf-scrubber
            min="0"
            max="30"
            step="1"
            value="0"
            style="--scrub-pct: 0%"
            aria-label="Jump to spread"
          />
        </div>

        <div class="bf-actions">
          <button
            type="button"
            class="bf-ghost-btn"
            data-bf-fs
            aria-label="Toggle fullscreen reader"
            title="Fullscreen"
          >
            <svg class="bf-ico-enter" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
            <svg class="bf-ico-exit" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M10 14l-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Quiet Chapter Index unified right underneath -->
      <div class="bf-chapters" role="tablist" aria-label="Book chapters">
        {
          chapters.map((ch, idx) => (
            <button
              type="button"
              class:list={['bf-ch-btn', { 'is-active': idx === 0 }]}
              data-bf-jump={ch.spread}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {ch.dot && <span class="bf-ch-dot" style={`background:${ch.dot}`} aria-hidden="true" />}
              <span>{ch.label}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  const SPREAD_TITLES: Record<number, string> = {
    0: 'Front Cover',
    1: 'คำนำ · Preface',
    2: 'สารบัญ · Contents',
    3: 'Ch.1 · 16 Personalities',
    4: 'Ch.1 · 4 Dimensions (E/I · S/N · T/F · J/P)',
    5: 'Ch.2 · แบบทดสอบบุคลิกภาพ',
    6: 'Quiz · Part 1',
    7: 'Quiz · Part 2',
    8: 'Quiz · Results',
    9: 'Ch.3 · Analysts (กลุ่มนักวิเคราะห์)',
    10: 'INTJ · นักออกแบบ',
    11: 'INTP · นักตรรกะ',
    12: 'ENTJ · ผู้บัญชาการ',
    13: 'ENTP · นักโต้วาที',
    14: 'Ch.4 · Diplomats (กลุ่มนักการทูต)',
    15: 'INFJ · ผู้แนะนำ',
    16: 'INFP · ผู้ไกล่เกลี่ย',
    17: 'ENFJ · ตัวเอก',
    18: 'ENFP · นักรณรงค์',
    19: 'Ch.5 · Sentinels (กลุ่มผู้เฝ้ายาม)',
    20: 'ISTJ · นักคำนวณ',
    21: 'ISFJ · ผู้ตั้งรับ',
    22: 'ESTJ · ผู้บริหาร',
    23: 'ESFJ · ผู้ให้คำปรึกษา',
    24: 'Ch.6 · Explorers (กลุ่มนักสำรวจ)',
    25: 'ISTP · ผู้เชี่ยวชาญด้านศิลปะ',
    26: 'ISFP · นักผจญภัย',
    27: 'ESTP · ผู้ประกอบการ',
    28: 'ESFP · ผู้มอบความบันเทิง',
    29: 'อ้างอิง · References',
    30: 'Back Cover',
  };

  const MAX_SPREAD = 30;
  const CURVE_SEGS = 28;

  interface TurningSheet {
    sheetIdx: number; // 0..29 (front = sheetIdx*2+1, back = sheetIdx*2+2)
    t: number; // 0 (right) .. 1 (left)
    target: number; // 0 or 1
    vel: number;
    dragging: boolean;
    onSettled: () => void;
  }

  document.querySelectorAll<HTMLElement>('[data-book-flipbook]').forEach((root) => {
    const basePath = root.dataset.basePath || '/media/book-16p/';
    const backdrop = root.querySelector<HTMLElement>('[data-bf-backdrop]')!;
    const shell = root.querySelector<HTMLElement>('[data-bf-shell]')!;
    const stage = root.querySelector<HTMLElement>('[data-bf-stage]')!;
    const dock = root.querySelector<HTMLElement>('[data-bf-dock]')!;
    const book = root.querySelector<HTMLElement>('[data-bf-book]')!;
    const stackLeft = root.querySelector<HTMLElement>('[data-bf-stack-left]')!;
    const stackRight = root.querySelector<HTMLElement>('[data-bf-stack-right]')!;
    const groundEl = root.querySelector<HTMLElement>('[data-bf-ground]')!;
    const slotLeft = root.querySelector<HTMLElement>('[data-bf-slot-left]')!;
    const slotRight = root.querySelector<HTMLElement>('[data-bf-slot-right]')!;
    const imgLeft = root.querySelector<HTMLImageElement>('[data-bf-img-left]')!;
    const imgRight = root.querySelector<HTMLImageElement>('[data-bf-img-right]')!;
    const castLeft = root.querySelector<HTMLElement>('[data-bf-cast-left]')!;
    const castRight = root.querySelector<HTMLElement>('[data-bf-cast-right]')!;
    const spineEl = root.querySelector<HTMLElement>('[data-bf-spine]')!;
    const turnsHost = root.querySelector<HTMLElement>('[data-bf-turns]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-bf-turns-canvas]')!;
    const ctx = canvas.getContext('2d');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-bf-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-bf-next]')!;
    const counterEl = root.querySelector<HTMLElement>('[data-bf-counter]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-bf-title]')!;
    const scrubber = root.querySelector<HTMLInputElement>('[data-bf-scrubber]')!;
    const fsBtn = root.querySelector<HTMLButtonElement>('[data-bf-fs]')!;
    const chBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-bf-jump]')];

    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pageImages = new Map<number, HTMLImageElement>();

    // Current resting spread: 0 = front cover, 1..29 = spreads (2-3..58-59), 30 = back cover
    let spread = 0;
    let displaySpread = 0;
    let activeSheets: TurningSheet[] = [];
    let dragSheet: TurningSheet | null = null;
    let hoverPeekSheet: TurningSheet | null = null;
    let hoverSide: 'left' | 'right' | null = null;
    // Optional explicit base pages override during a multi-sheet chapter cascade
    let cascadeOverride: { left: number; right: number } | null = null;
    let rafId = 0;
    let lastTs = 0;
    let hydrated = false;

    const pageUrl = (n: number) => `${basePath}p${String(n).padStart(2, '0')}.webp`;

    const preloadPage = (n: number): HTMLImageElement | null => {
      if (n < 1 || n > 60) return null;
      const existing = pageImages.get(n);
      if (existing) return existing;
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => {
        if (activeSheets.length > 0) renderTurningCanvas();
      };
      im.src = pageUrl(n);
      pageImages.set(n, im);
      return im;
    };

    const preloadAround = (sp: number) => {
      for (let d = -3; d <= 3; d++) {
        const s = sp + d;
        if (s < 0 || s > MAX_SPREAD) continue;
        if (s === 0) preloadPage(1);
        else if (s === MAX_SPREAD) preloadPage(60);
        else {
          preloadPage(s * 2);
          preloadPage(s * 2 + 1);
        }
      }
    };

    const dismissHint = () => {};

    const formatCounter = (sp: number) => {
      if (sp <= 0) return '1 / 60';
      if (sp >= MAX_SPREAD) return '60 / 60';
      return `${sp * 2}–${sp * 2 + 1} / 60`;
    };

    const updateChapterButtons = (sp: number) => {
      let bestIdx = 0;
      chBtns.forEach((btn, idx) => {
        const s = Number(btn.dataset.bfJump || 0);
        if (sp >= s) bestIdx = idx;
      });
      chBtns.forEach((btn, idx) => {
        const hit = idx === bestIdx;
        btn.classList.toggle('is-active', hit);
        btn.setAttribute('aria-pressed', String(hit));
      });
    };

    // Drive smooth book horizontal centering in lockstep with front/back cover opening
    const updateBookPose = () => {
      let shiftPct = 0;
      const frontSheet = activeSheets.find((s) => s.sheetIdx === 0);
      const backSheet = activeSheets.find((s) => s.sheetIdx === MAX_SPREAD - 1);

      if (frontSheet && (spread === 0 || displaySpread === 0 || cascadeOverride?.left === 0)) {
        shiftPct = -25 * (1 - frontSheet.t);
      } else if (
        backSheet &&
        (spread === MAX_SPREAD || displaySpread === MAX_SPREAD || cascadeOverride?.right === 0)
      ) {
        shiftPct = 25 * backSheet.t;
      } else if (activeSheets.length === 0) {
        if (spread === 0) shiftPct = -25;
        else if (spread === MAX_SPREAD) shiftPct = 25;
      } else {
        shiftPct = 0;
      }

      book.style.transform = `translateX(${shiftPct.toFixed(2)}%)`;

      const state =
        shiftPct < -18 ? 'front' : shiftPct > 18 ? 'back' : 'open';
      book.dataset.state = state;
      spineEl.style.opacity = Math.abs(shiftPct) < 20 ? '1' : '0';

      // Match ambient desk shadow footprint smoothly under cover vs open spread
      const leftInset = Math.max(0, -shiftPct * 2); // 0..50%
      const rightInset = Math.max(0, shiftPct * 2); // 0..50%
      groundEl.style.left = `${leftInset.toFixed(1)}%`;
      groundEl.style.right = `${rightInset.toFixed(1)}%`;
    };

    const updateUI = (sp: number) => {
      counterEl.textContent = formatCounter(sp);
      titleEl.textContent = SPREAD_TITLES[sp] ?? '';
      scrubber.value = String(sp);
      scrubber.style.setProperty('--scrub-pct', `${((sp / MAX_SPREAD) * 100).toFixed(2)}%`);
      prevBtn.disabled = sp <= 0;
      nextBtn.disabled = sp >= MAX_SPREAD;
      updateChapterButtons(sp);

      // Dynamic physical paper-stack thickness on left & right fore-edges
      const leftRatio = Math.max(0, Math.min(1, sp / MAX_SPREAD));
      const rightRatio = 1 - leftRatio;
      const leftPx = sp === 0 ? 0 : Math.max(2, Math.round(leftRatio * 12));
      const rightPx = sp === MAX_SPREAD ? 0 : Math.max(2, Math.round(rightRatio * 12));
      stackLeft.style.setProperty('--stack-w', `${leftPx}px`);
      stackRight.style.setProperty('--stack-w', `${rightPx}px`);
      stackLeft.style.opacity = sp === 0 ? '0' : '1';
      stackRight.style.opacity = sp === MAX_SPREAD ? '0' : '1';

      updateBookPose();
    };

    const setSlotImage = (
      slot: HTMLElement,
      img: HTMLImageElement,
      pageNum: number,
    ) => {
      if (pageNum > 0) {
        const url = pageUrl(pageNum);
        if (img.dataset.srcLoaded !== url) {
          img.src = url;
          img.dataset.srcLoaded = url;
        }
        img.alt = `Page ${pageNum} of 16 Personalities`;
        slot.classList.remove('is-empty');
      } else {
        slot.classList.add('is-empty');
      }
    };

    // Determine what stationary pages should show underneath any actively turning sheets
    const syncBasePages = () => {
      if (!hydrated) return;

      if (cascadeOverride && activeSheets.length > 0) {
        setSlotImage(slotLeft, imgLeft, cascadeOverride.left);
        setSlotImage(slotRight, imgRight, cascadeOverride.right);
        return;
      }

      let leftPageNum = spread > 0 ? spread * 2 : 0;
      let rightPageNum = spread < MAX_SPREAD ? spread * 2 + 1 : 0;

      if (activeSheets.length > 0) {
        const indices = activeSheets.map((s) => s.sheetIdx);
        const minSheet = Math.min(...indices);
        const maxSheet = Math.max(...indices);
        leftPageNum = minSheet > 0 ? minSheet * 2 : 0;
        rightPageNum = maxSheet < MAX_SPREAD - 1 ? (maxSheet + 1) * 2 + 1 : 0;
      }

      setSlotImage(slotLeft, imgLeft, leftPageNum);
      setSlotImage(slotRight, imgRight, rightPageNum);
    };

    const createCurvedSheet = (
      sheetIdx: number,
      initialT: number,
      targetT: number,
      onSettled: () => void,
    ): TurningSheet => {
      preloadPage(sheetIdx * 2 + 1);
      preloadPage(sheetIdx * 2 + 2);
      return {
        sheetIdx,
        t: initialT,
        target: targetT,
        vel: 0,
        dragging: false,
        onSettled,
      };
    };

    // High-DPI 48-segment 3D curved paper renderer on a single seamless <canvas>
    // (Eliminates Chromium preserve-3d BSP-split vertical hairlines completely!)
    let cachedCw = 0;
    let cachedCh = 0;
    const renderTurningCanvas = () => {
      turnsHost.dataset.activeCount = String(activeSheets.length);
      if (!ctx) return;

      if (activeSheets.length === 0) {
        if (cachedCw > 0 && cachedCh > 0) {
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.clearRect(0, 0, cachedCw, cachedCh);
        }
        canvas.style.opacity = '0';
        return;
      }

      const bookW = book.offsetWidth;
      const bookH = book.offsetHeight;
      if (bookW < 10 || bookH < 10) return;

      const padX = bookW * 0.04;
      const padY = bookH * 0.2;
      const cssW = bookW + padX * 2;
      const cssH = bookH + padY * 2;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const bufW = Math.max(1, Math.round(cssW * dpr));
      const bufH = Math.max(1, Math.round(cssH * dpr));

      if (canvas.width !== bufW || canvas.height !== bufH) {
        canvas.width = bufW;
        canvas.height = bufH;
        cachedCw = bufW;
        cachedCh = bufH;
      }

      canvas.style.opacity = '1';
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, bufW, bufH);
      ctx.imageSmoothingEnabled = true;

      // Sort back-to-front by painter's z-order matching 90-degree midpoint crossover
      const ordered = activeSheets
        .slice()
        .sort((a, b) => {
          const za = a.t < 0.5 ? 200 - a.sheetIdx : 200 + a.sheetIdx;
          const zb = b.t < 0.5 ? 200 - b.sheetIdx : 200 + b.sheetIdx;
          return za - zb;
        });

      const spineX = padX + bookW * 0.5;
      const centerY = padY + bookH * 0.5;
      const halfW = bookW * 0.5;
      const ds = halfW / CURVE_SEGS;
      const dCam = bookW * 2.55;

      const sx = new Float32Array(CURVE_SEGS + 1);
      const syT = new Float32Array(CURVE_SEGS + 1);
      const syB = new Float32Array(CURVE_SEGS + 1);
      const zArr = new Float32Array(CURVE_SEGS + 1);
      const angArr = new Float32Array(CURVE_SEGS + 1);

      for (const sheet of ordered) {
        const t = Math.max(0, Math.min(1, sheet.t));
        const baseRad = Math.PI * t;
        const sin2 = Math.sin(2 * Math.PI * t);
        const sin1 = Math.sin(Math.PI * t);

        // Integrate smooth 48-segment 3D curve from stiff spine (u=0) to flexible fore-edge (u=1)
        let x = 0;
        let z = 0;
        for (let i = 0; i <= CURVE_SEGS; i++) {
          const u = i / CURVE_SEGS;
          const curl = -sin2 * 0.54 * Math.pow(u, 1.38);
          const ang = Math.max(0, Math.min(Math.PI, baseRad + curl));
          angArr[i] = ang;

          const persp = dCam / (dCam - z);
          sx[i] = spineX + x * persp;
          syT[i] = centerY - bookH * 0.5 * persp;
          syB[i] = centerY + bookH * 0.5 * persp;
          zArr[i] = z;

          if (i < CURVE_SEGS) {
            x += ds * Math.cos(ang);
            z += ds * Math.sin(ang);
          }
        }

        const frontImg = preloadPage(sheet.sheetIdx * 2 + 1);
        const backImg = preloadPage(sheet.sheetIdx * 2 + 2);

        // Group contiguous front-facing vs back-facing runs (handles fold-over silhouettes cleanly!)
        interface Run {
          start: number;
          end: number;
          isFront: boolean;
          avgZ: number;
        }
        const runs: Run[] = [];
        let curStart = 0;
        let curFront = sx[1] >= sx[0];
        for (let i = 1; i < CURVE_SEGS; i++) {
          const f = sx[i + 1] >= sx[i];
          if (f !== curFront) {
            let sumZ = 0;
            for (let j = curStart; j <= i; j++) sumZ += zArr[j];
            runs.push({
              start: curStart,
              end: i,
              isFront: curFront,
              avgZ: sumZ / (i - curStart + 1),
            });
            curStart = i;
            curFront = f;
          }
        }
        {
          let sumZ = 0;
          for (let j = curStart; j <= CURVE_SEGS; j++) sumZ += zArr[j];
          runs.push({
            start: curStart,
            end: CURVE_SEGS,
            isFront: curFront,
            avgZ: sumZ / (CURVE_SEGS - curStart + 1),
          });
        }

        // Draw farther run first, closer run second
        runs.sort((a, b) => a.avgZ - b.avgZ);

        for (const run of runs) {
          const img = run.isFront ? frontImg : backImg;
          const imgReady = !!(img && img.complete && img.naturalWidth > 0);
          const imgW = imgReady ? img!.naturalWidth : 960;
          const imgH = imgReady ? img!.naturalHeight : 960;

          let minX = Infinity;
          let maxX = -Infinity;
          for (let i = run.start; i <= run.end; i++) {
            if (sx[i] < minX) minX = sx[i];
            if (sx[i] > maxX) maxX = sx[i];
          }
          if (maxX - minX < 0.6) continue;

          ctx.save();
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          // Exact 48-point smooth curved silhouette clip (zero jagged edges!)
          ctx.beginPath();
          ctx.moveTo(sx[run.start], syT[run.start]);
          for (let i = run.start + 1; i <= run.end; i++) {
            ctx.lineTo(sx[i], syT[i]);
          }
          for (let i = run.end; i >= run.start; i--) {
            ctx.lineTo(sx[i], syB[i]);
          }
          ctx.closePath();
          ctx.clip();

          // Paint crisp opaque image slices with 1.25px source-matched overlap (ZERO vertical seams!)
          if (imgReady) {
            for (let i = run.start; i < run.end; i++) {
              const u0 = i / CURVE_SEGS;
              const u1 = (i + 1) / CURVE_SEGS;

              if (run.isFront) {
                const xL = sx[i];
                const xR = sx[i + 1];
                const w = xR - xL;
                if (w < 0.35) continue;
                const yTL = syT[i];
                const yTR = syT[i + 1];
                const h = (syB[i] - yTL + (syB[i + 1] - yTR)) * 0.5;
                const pad = i < run.end - 1 ? Math.min(1.25, w * 0.45) : 0;
                const wPad = w + pad;
                const ratio = wPad / w;
                const srcX = Math.max(0, u0 * imgW);
                const srcW = Math.min(imgW - srcX, (u1 - u0) * imgW * ratio);
                if (srcW <= 0.5) continue;
                ctx.setTransform(
                  dpr * wPad,
                  dpr * (yTR - yTL) * ratio,
                  0,
                  dpr * h,
                  dpr * xL,
                  dpr * yTL,
                );
                ctx.drawImage(img!, srcX, 0, srcW, imgH, 0, 0, 1, 1);
              } else {
                const xL = sx[i + 1];
                const xR = sx[i];
                const w = xR - xL;
                if (w < 0.35) continue;
                const yTL = syT[i + 1];
                const yTR = syT[i];
                const h = (syB[i + 1] - yTL + (syB[i] - yTR)) * 0.5;
                const pad = i > run.start ? Math.min(1.25, w * 0.45) : 0;
                const wPad = w + pad;
                const ratio = wPad / w;
                const srcX = Math.max(0, (1 - u1) * imgW);
                const srcW = Math.min(imgW - srcX, (u1 - u0) * imgW * ratio);
                if (srcW <= 0.5) continue;
                ctx.setTransform(
                  dpr * wPad,
                  dpr * (yTR - yTL) * ratio,
                  0,
                  dpr * h,
                  dpr * xL,
                  dpr * yTL,
                );
                ctx.drawImage(img!, srcX, 0, srcW, imgH, 0, 0, 1, 1);
              }
            }
          } else {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(minX - 2, 0, maxX - minX + 4, cssH);
          }

          // ONE continuous multi-stop paper lighting gradient inside the clip (ZERO banding!)
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          const grad = ctx.createLinearGradient(minX, 0, maxX, 0);
          const samples = 10;
          const span = Math.max(1, maxX - minX);
          const stops: { pos: number; col: string }[] = [];
          for (let s = 0; s <= samples; s++) {
            const idx = Math.round(run.start + ((run.end - run.start) * s) / samples);
            const pos = Math.max(0, Math.min(1, (sx[idx] - minX) / span));
            const u = idx / CURVE_SEGS;
            const rad = angArr[idx];
            const spineShadow = Math.pow(Math.max(0, 1 - u / 0.2), 1.8) * 0.16;

            let val: number;
            if (run.isFront) {
              const sheen = Math.max(0, Math.sin(rad * 2.1)) * 0.11 * sin1;
              const shade = Math.sin(rad) * 0.24 + spineShadow * (1 - t * 0.5);
              val = sheen - shade;
            } else {
              const bRad = Math.PI - rad;
              const sheen = Math.max(0, Math.sin(bRad * 2.1)) * 0.11 * sin1;
              const shade = Math.sin(bRad) * 0.24 + spineShadow * (0.5 + t * 0.5);
              val = sheen - shade;
            }
            const col =
              val >= 0
                ? `rgba(255,255,255,${Math.min(0.22, val).toFixed(3)})`
                : `rgba(0,0,0,${Math.min(0.4, -val).toFixed(3)})`;
            stops.push({ pos, col });
          }
          stops.sort((a, b) => a.pos - b.pos);
          for (const st of stops) {
            grad.addColorStop(st.pos, st.col);
          }
          ctx.fillStyle = grad;
          ctx.fillRect(minX - 2, 0, maxX - minX + 4, cssH);

          // Ultra-fine subtle outer paper edge definition
          ctx.strokeStyle = 'rgba(0,0,0,0.06)';
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.restore();
        }
      }
    };

    const updateCastShadows = () => {
      if (activeSheets.length === 0) {
        castLeft.style.opacity = '0';
        castRight.style.opacity = '0';
        return;
      }
      let leftAlpha = 0;
      let leftWidth = 0;
      let rightAlpha = 0;
      let rightWidth = 0;
      for (const s of activeSheets) {
        const t = Math.max(0, Math.min(1, s.t));
        const lift = Math.sin(Math.PI * t);
        if (t < 0.68) {
          const rA = lift * (1 - t / 0.68) * 0.36;
          rightAlpha = Math.max(rightAlpha, rA);
          rightWidth = Math.max(rightWidth, 16 + (1 - t) * 44);
        }
        if (t > 0.32) {
          const lA = lift * ((t - 0.32) / 0.68) * 0.36;
          leftAlpha = Math.max(leftAlpha, lA);
          leftWidth = Math.max(leftWidth, 16 + t * 44);
        }
      }
      castRight.style.opacity = rightAlpha.toFixed(3);
      castRight.style.width = `${rightWidth.toFixed(1)}%`;
      castLeft.style.opacity = leftAlpha.toFixed(3);
      castLeft.style.width = `${leftWidth.toFixed(1)}%`;
    };

    const removeSheet = (sheet: TurningSheet) => {
      activeSheets = activeSheets.filter((s) => s !== sheet);
      if (hoverPeekSheet === sheet) hoverPeekSheet = null;
      if (dragSheet === sheet) dragSheet = null;
      if (activeSheets.length === 0) {
        cascadeOverride = null;
      }
      syncBasePages();
      updateCastShadows();
      updateBookPose();
      renderTurningCanvas();
    };

    const tick = (ts: number) => {
      const dt = lastTs ? Math.min(0.08, (ts - lastTs) * 0.001) : 1 / 60;
      lastTs = ts;

      let keepRunning = false;
      const toSettle: TurningSheet[] = [];

      for (const sheet of activeSheets) {
        if (sheet.dragging) {
          keepRunning = true;
          continue;
        }
        if (reduceMq.matches) {
          sheet.t = sheet.target;
          sheet.vel = 0;
          toSettle.push(sheet);
          continue;
        }

        // Critically-damped heavy paper spring (~500ms crisp physical turn)
        const stiffness = 84;
        const damping = 17.6;
        const steps = Math.max(1, Math.ceil(dt / 0.005));
        const h = dt / steps;
        for (let i = 0; i < steps; i++) {
          const force = -stiffness * (sheet.t - sheet.target) - damping * sheet.vel;
          sheet.vel += force * h;
          sheet.t += sheet.vel * h;
        }
        sheet.t = Math.max(0, Math.min(1, sheet.t));

        if (Math.abs(sheet.target - sheet.t) < 0.004 && Math.abs(sheet.vel) < 0.04) {
          sheet.t = sheet.target;
          sheet.vel = 0;
          toSettle.push(sheet);
        } else {
          keepRunning = true;
        }
      }

      updateCastShadows();
      updateBookPose();
      renderTurningCanvas();

      for (const s of toSettle) {
        s.onSettled();
      }

      if (keepRunning || activeSheets.length > 0) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = 0;
        lastTs = 0;
      }
    };

    const ensureLoop = () => {
      if (!rafId) {
        lastTs = 0;
        rafId = requestAnimationFrame(tick);
      }
    };

    const clearHoverPeek = () => {
      if (!hoverPeekSheet) return;
      const s = hoverPeekSheet;
      hoverPeekSheet = null;
      hoverSide = null;
      s.dragging = false;
      s.target = s.sheetIdx === spread ? 0 : 1;
      s.onSettled = () => removeSheet(s);
      ensureLoop();
    };

    // Turn a single physical sheet forward (+1) or backward (-1)
    const flipStep = (dir: 1 | -1) => {
      const next = displaySpread + dir;
      if (next < 0 || next > MAX_SPREAD) return;
      dismissHint();
      cascadeOverride = null;

      const targetSheetIdx = dir === 1 ? displaySpread : displaySpread - 1;
      if (hoverPeekSheet && hoverPeekSheet.sheetIdx === targetSheetIdx) {
        const s = hoverPeekSheet;
        hoverPeekSheet = null;
        hoverSide = null;
        displaySpread = next;
        updateUI(displaySpread);
        preloadAround(displaySpread);
        s.dragging = false;
        s.target = dir === 1 ? 1 : 0;
        s.vel = dir * 1.8;
        s.onSettled = () => {
          spread = Math.max(0, Math.min(MAX_SPREAD, dir === 1 ? Math.max(spread, targetSheetIdx + 1) : Math.min(spread, targetSheetIdx)));
          removeSheet(s);
        };
        syncBasePages();
        ensureLoop();
        return;
      }

      clearHoverPeek();

      displaySpread = next;
      updateUI(displaySpread);
      preloadAround(displaySpread);

      if (reduceMq.matches) {
        spread = displaySpread;
        activeSheets.slice().forEach(removeSheet);
        syncBasePages();
        return;
      }

      const sheet = createCurvedSheet(targetSheetIdx, dir === 1 ? 0 : 1, dir === 1 ? 1 : 0, () => {
        spread =
          dir === 1
            ? Math.max(spread, targetSheetIdx + 1)
            : Math.min(spread, targetSheetIdx);
        removeSheet(sheet);
      });
      sheet.vel = dir * 2.1;
      activeSheets.push(sheet);
      syncBasePages();
      updateBookPose();
      ensureLoop();
    };

    // Jump to any spread with a realistic multi-sheet cascade (up to 3 staggered turning sheets)
    let cascadeTimers: number[] = [];
    const clearCascade = () => {
      cascadeTimers.forEach((id) => window.clearTimeout(id));
      cascadeTimers = [];
    };

    const jumpToSpread = (targetSp: number) => {
      const clamped = Math.max(0, Math.min(MAX_SPREAD, targetSp));
      if (clamped === displaySpread && activeSheets.length === 0) return;
      dismissHint();
      clearHoverPeek();
      clearCascade();

      const diff = clamped - displaySpread;
      if (diff === 0) return;

      if (Math.abs(diff) === 1) {
        flipStep(diff > 0 ? 1 : -1);
        return;
      }

      // Immediately clear any in-flight sheets from prior jumps so base pages stay exact
      activeSheets = [];
      dragSheet = null;
      hoverPeekSheet = null;
      renderTurningCanvas();

      if (reduceMq.matches) {
        spread = clamped;
        displaySpread = clamped;
        cascadeOverride = null;
        updateUI(clamped);
        preloadAround(clamped);
        syncBasePages();
        return;
      }

      const dir: 1 | -1 = diff > 0 ? 1 : -1;
      const startSp = displaySpread;
      displaySpread = clamped;
      spread = clamped;
      preloadAround(clamped);

      // Build 2 staggered sheets ending with the exact destination boundary sheet
      const cascadeCount = Math.min(2, Math.abs(diff));
      const sheetIndices: number[] = [];
      for (let i = 0; i < cascadeCount; i++) {
        let idx: number;
        if (i === 0 && startSp === 0 && dir === 1) {
          idx = 0;
        } else if (i === 0 && startSp === MAX_SPREAD && dir === -1) {
          idx = MAX_SPREAD - 1;
        } else if (i === cascadeCount - 1) {
          idx = dir === 1 ? clamped - 1 : clamped;
        } else {
          const spStep = Math.round(startSp + diff * 0.45);
          idx = dir === 1 ? Math.max(0, spStep - 1) : Math.min(MAX_SPREAD - 1, spStep);
        }
        idx = Math.max(0, Math.min(MAX_SPREAD - 1, idx));
        if (!sheetIndices.includes(idx)) sheetIndices.push(idx);
      }

      // Exact underlying pages while the cascade sweeps across:
      // Forward: old left page stays visible until covered; destination right page is already revealed underneath!
      // Backward: destination left page is already revealed underneath; old right page stays visible until covered!
      cascadeOverride =
        dir === 1
          ? {
              left: startSp > 0 ? startSp * 2 : 0,
              right: clamped < MAX_SPREAD ? clamped * 2 + 1 : 0,
            }
          : {
              left: clamped > 0 ? clamped * 2 : 0,
              right: startSp < MAX_SPREAD ? startSp * 2 + 1 : 0,
            };

      updateUI(clamped);
      syncBasePages();

      sheetIndices.forEach((sIdx, i) => {
        const launch = () => {
          const sheet = createCurvedSheet(sIdx, dir === 1 ? 0 : 1, dir === 1 ? 1 : 0, () => {
            removeSheet(sheet);
          });
          sheet.vel = dir * 2.8;
          activeSheets.push(sheet);
          syncBasePages();
          updateBookPose();
          ensureLoop();
        };
        if (i === 0) {
          launch();
        } else {
          const tid = window.setTimeout(launch, i * 90);
          cascadeTimers.push(tid);
        }
      });
    };

    // ================= Pointer Drag-to-Flip & Click-to-Turn =================
    let ptrDown = false;
    let ptrId = -1;
    let startX = 0;
    let lastX = 0;
    let lastMoveTime = 0;
    let ptrVelX = 0;
    let dragDir: 1 | -1 = 1;
    let didDrag = false;

    const getBookWidth = () => Math.max(200, book.getBoundingClientRect().width);

    book.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      const rect = book.getBoundingClientRect();
      const relX = (e.clientX - rect.left) / rect.width;

      let side: 'left' | 'right';
      if (displaySpread === 0) side = 'right';
      else if (displaySpread === MAX_SPREAD) side = 'left';
      else side = relX >= 0.5 ? 'right' : 'left';

      if (side === 'right' && displaySpread >= MAX_SPREAD) return;
      if (side === 'left' && displaySpread <= 0) return;

      ptrDown = true;
      ptrId = e.pointerId;
      startX = e.clientX;
      lastX = e.clientX;
      lastMoveTime = performance.now();
      ptrVelX = 0;
      didDrag = false;
      dragDir = side === 'right' ? 1 : -1;

      book.setPointerCapture(ptrId);
    });

    book.addEventListener('pointermove', (e) => {
      if (!ptrDown) {
        if (e.pointerType !== 'mouse' || reduceMq.matches || activeSheets.length > (hoverPeekSheet ? 1 : 0)) {
          return;
        }
        const rect = book.getBoundingClientRect();
        const relX = (e.clientX - rect.left) / rect.width;
        let nextHover: 'left' | 'right' | null = null;
        if (displaySpread < MAX_SPREAD && relX > 0.84 && relX <= 1) nextHover = 'right';
        else if (displaySpread > 0 && relX >= 0 && relX < 0.16) nextHover = 'left';

        if (nextHover === hoverSide) return;
        clearHoverPeek();
        if (!nextHover) return;

        hoverSide = nextHover;
        const sIdx = nextHover === 'right' ? displaySpread : displaySpread - 1;
        const initT = nextHover === 'right' ? 0 : 1;
        const peekT = nextHover === 'right' ? 0.055 : 0.945;
        const s = createCurvedSheet(sIdx, initT, peekT, () => {});
        hoverPeekSheet = s;
        activeSheets.push(s);
        syncBasePages();
        ensureLoop();
        return;
      }

      if (e.pointerId !== ptrId) return;
      const now = performance.now();
      const dtMs = Math.max(1, now - lastMoveTime);
      ptrVelX = (e.clientX - lastX) / dtMs;
      lastX = e.clientX;
      lastMoveTime = now;

      const dx = e.clientX - startX;
      if (!didDrag && Math.abs(dx) > 10) {
        didDrag = true;
        dismissHint();
        cascadeOverride = null;
        const targetSheetIdx = dragDir === 1 ? displaySpread : displaySpread - 1;

        if (hoverPeekSheet && hoverPeekSheet.sheetIdx === targetSheetIdx) {
          dragSheet = hoverPeekSheet;
          hoverPeekSheet = null;
          hoverSide = null;
          dragSheet.dragging = true;
        } else {
          clearHoverPeek();
          dragSheet = createCurvedSheet(
            targetSheetIdx,
            dragDir === 1 ? 0 : 1,
            dragDir === 1 ? 1 : 0,
            () => {},
          );
          dragSheet.dragging = true;
          activeSheets.push(dragSheet);
        }
        syncBasePages();
        ensureLoop();
      }

      if (didDrag && dragSheet) {
        const w = getBookWidth() * 0.56;
        if (dragDir === 1) {
          dragSheet.t = Math.max(0, Math.min(1, -dx / w));
        } else {
          dragSheet.t = Math.max(0, Math.min(1, 1 - dx / w));
        }
        renderTurningCanvas();
        updateCastShadows();
        updateBookPose();
      }
    });

    const finishPointer = (e: PointerEvent) => {
      if (!ptrDown || e.pointerId !== ptrId) return;
      ptrDown = false;
      try {
        book.releasePointerCapture(ptrId);
      } catch {}

      if (!didDrag) {
        flipStep(dragDir);
        return;
      }

      if (dragSheet) {
        const s = dragSheet;
        dragSheet = null;
        s.dragging = false;

        const completeForward = dragDir === 1 && (s.t > 0.28 || ptrVelX < -0.35);
        const completeBack = dragDir === -1 && (s.t < 0.72 || ptrVelX > 0.35);

        if (completeForward) {
          displaySpread = Math.min(MAX_SPREAD, s.sheetIdx + 1);
          updateUI(displaySpread);
          preloadAround(displaySpread);
          s.target = 1;
          s.vel = Math.max(1.8, -ptrVelX * 1.6);
          s.onSettled = () => {
            spread = Math.max(spread, s.sheetIdx + 1);
            removeSheet(s);
          };
        } else if (completeBack) {
          displaySpread = Math.max(0, s.sheetIdx);
          updateUI(displaySpread);
          preloadAround(displaySpread);
          s.target = 0;
          s.vel = Math.min(-1.8, -ptrVelX * 1.6);
          s.onSettled = () => {
            spread = Math.min(spread, s.sheetIdx);
            removeSheet(s);
          };
        } else {
          s.target = dragDir === 1 ? 0 : 1;
          s.onSettled = () => removeSheet(s);
        }
        ensureLoop();
      }
    };

    book.addEventListener('pointerup', finishPointer);
    book.addEventListener('pointercancel', finishPointer);
    book.addEventListener('pointerleave', () => {
      if (!ptrDown) clearHoverPeek();
    });

    // Buttons & Scrubber & Chapter Pills
    prevBtn.addEventListener('click', () => flipStep(-1));
    nextBtn.addEventListener('click', () => flipStep(1));
    scrubber.addEventListener('input', () => jumpToSpread(Number(scrubber.value)));

    chBtns.forEach((btn) => {
      const target = Number(btn.dataset.bfJump || 0);
      btn.addEventListener('pointerenter', () => {
        if (hydrated) preloadAround(target);
      });
      btn.addEventListener('click', () => jumpToSpread(target));
    });

    // Smooth FLIP "pick up closer" Fullscreen toggle with blurred backdrop
    const parentDialog = root.closest<HTMLDialogElement>('dialog');
    let fsAnimating = false;
    let fsTimer = 0;

    const clearFsInlineStyles = () => {
      stage.style.transition = '';
      stage.style.transform = '';
      dock.style.transition = '';
      dock.style.opacity = '';
      dock.style.transform = '';
    };

    const toggleFullscreen = (force?: boolean) => {
      const currentlyFs = root.classList.contains('is-fullscreen');
      const want = force ?? !currentlyFs;
      if (want === currentlyFs || fsAnimating) return;

      window.clearTimeout(fsTimer);

      if (reduceMq.matches) {
        root.classList.toggle('is-fullscreen', want);
        root.classList.toggle('is-fs-visible', want);
        fsBtn.setAttribute('aria-pressed', String(want));
        root.style.minHeight = '';
        clearFsInlineStyles();
        return;
      }

      const computeStageFlip = (
        fromBookRect: DOMRect,
        toBookRect: DOMRect,
        stageRect: DOMRect,
      ) => {
        const scale = Math.max(
          0.25,
          Math.min(1.5, toBookRect.width / Math.max(1, fromBookRect.width)),
        );
        const stageCx = stageRect.left + stageRect.width / 2;
        const stageCy = stageRect.top + stageRect.height / 2;
        const fromCx = fromBookRect.left + fromBookRect.width / 2;
        const fromCy = fromBookRect.top + fromBookRect.height / 2;
        const toCx = toBookRect.left + toBookRect.width / 2;
        const toCy = toBookRect.top + toBookRect.height / 2;
        const dx = toCx - (stageCx + (fromCx - stageCx) * scale);
        const dy = toCy - (stageCy + (fromCy - stageCy) * scale);
        return { dx, dy, scale };
      };

      if (want) {
        fsAnimating = true;
        // Preserve underlying article height so background behind blur never jumps
        root.style.minHeight = `${root.offsetHeight}px`;
        const inlineBookRect = book.getBoundingClientRect();

        root.classList.add('is-fullscreen');
        fsBtn.setAttribute('aria-pressed', 'true');

        const fsBookRect = book.getBoundingClientRect();
        const fsStageRect = stage.getBoundingClientRect();
        const { dx, dy, scale } = computeStageFlip(fsBookRect, inlineBookRect, fsStageRect);

        // Invert stage & dock to exact inline book size/position before playing forward
        stage.style.transition = 'none';
        stage.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${scale.toFixed(5)})`;
        dock.style.transition = 'none';
        dock.style.opacity = '0';
        dock.style.transform = 'translate3d(0, 14px, 0)';
        void stage.offsetWidth;

        requestAnimationFrame(() => {
          root.classList.add('is-fs-visible');
          stage.style.transition = 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)';
          stage.style.transform = 'translate3d(0, 0, 0) scale(1)';
          dock.style.transition =
            'opacity 340ms ease 110ms, transform 420ms cubic-bezier(0.16, 1, 0.3, 1) 90ms';
          dock.style.opacity = '1';
          dock.style.transform = 'translate3d(0, 0, 0)';
        });

        fsTimer = window.setTimeout(() => {
          clearFsInlineStyles();
          fsAnimating = false;
        }, 540);
      } else {
        fsAnimating = true;
        // Measure fullscreen book rect & exact real-DOM inline destination synchronously (zero paint flash)
        const fsBookRect = book.getBoundingClientRect();
        const fsStageRect = stage.getBoundingClientRect();

        root.classList.remove('is-fullscreen');
        const targetBookRect = book.getBoundingClientRect();
        root.classList.add('is-fullscreen');

        const { dx, dy, scale } = computeStageFlip(fsBookRect, targetBookRect, fsStageRect);

        // Lock starting frame at 1:1 before playing smooth return transition
        stage.style.transition = 'none';
        stage.style.transform = 'translate3d(0, 0, 0) scale(1)';
        void stage.offsetWidth;

        root.classList.remove('is-fs-visible');
        fsBtn.setAttribute('aria-pressed', 'false');

        stage.style.transition = 'transform 440ms cubic-bezier(0.22, 1, 0.36, 1)';
        stage.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${scale.toFixed(5)})`;
        dock.style.transition = 'opacity 220ms ease, transform 260ms ease';
        dock.style.opacity = '0';
        dock.style.transform = 'translate3d(0, 8px, 0)';

        fsTimer = window.setTimeout(() => {
          root.classList.remove('is-fullscreen');
          root.style.minHeight = '';
          clearFsInlineStyles();
          fsBtn.blur();
          fsAnimating = false;
        }, 460);
      }
    };

    fsBtn.addEventListener('click', () => toggleFullscreen());
    backdrop.addEventListener('click', () => {
      if (root.classList.contains('is-fullscreen')) toggleFullscreen(false);
    });
    // Clicking the empty blurred area inside shell (outside book & dock) also closes fullscreen
    shell.addEventListener('click', (e) => {
      if (!root.classList.contains('is-fullscreen')) return;
      if (e.target === shell || e.target === stage) {
        toggleFullscreen(false);
      }
    });

    // Prevent Escape from closing the parent <dialog> while exiting fullscreen
    if (parentDialog) {
      parentDialog.addEventListener('cancel', (e) => {
        if (root.classList.contains('is-fullscreen')) {
          e.preventDefault();
          toggleFullscreen(false);
        }
      });
    }

    // Keyboard navigation when focused or when parent dialog is open
    const onKeyDown = (e: KeyboardEvent) => {
      if (parentDialog && !parentDialog.open) return;
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      const isFs = root.classList.contains('is-fullscreen');
      const rect = root.getBoundingClientRect();
      const inView = rect.bottom > 120 && rect.top < window.innerHeight - 120;
      if (!isFs && !inView) return;

      if (e.key === 'ArrowRight') {
        e.preventDefault();
        flipStep(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        flipStep(-1);
      } else if (e.key === 'Escape' && isFs) {
        e.preventDefault();
        e.stopImmediatePropagation();
        toggleFullscreen(false);
      }
    };
    window.addEventListener('keydown', onKeyDown, true);

    // Hydrate images only when visible (or when #read-16-personalities opens)
    const hydrate = () => {
      if (hydrated) return;
      hydrated = true;
      preloadAround(0);
      syncBasePages();
      updateUI(0);
    };

    if (parentDialog) {
      const mo = new MutationObserver(() => {
        if (parentDialog.open) hydrate();
      });
      mo.observe(parentDialog, { attributes: true, attributeFilter: ['open'] });
      if (parentDialog.open) hydrate();
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            hydrate();
            io.disconnect();
          }
        },
        { rootMargin: '240px' },
      );
      io.observe(root);
    } else {
      hydrate();
    }
  });
</script>

