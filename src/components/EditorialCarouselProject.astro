---
// Editorial single-screen project layout (Frame 117 design):
//   - Top: Project counter (05 / 07), large display title, and Overview
//   - Middle: Rounded showcase container with auto-scrolling (right-to-left)
//     + mouse-draggable 6-card carousel and full-size expand button on each card
//   - Bottom: 2-column footer (My Role on the left, Tools & Software on the right)
import type { Media, Project } from '../data/projects';
import { tools } from '../data/site';
import { posterUrl } from '../lib/media';
import Picture from './Picture.astro';

interface Props {
  project: Project;
  totalProjects?: string;
}
const { project: p, totalProjects = '07' } = Astro.props;
const titleId = `${p.slug}-title`;
const images = p.media.filter((m): m is Extract<Media, { kind: 'image' }> => m.kind === 'image');
---

<article class="project project-editorial" id={p.slug} data-project-title={p.title} aria-labelledby={titleId}>
  <div class="ed-shell" data-ve-editorial={p.slug}>
    <!-- Top Header & Overview -->
    <header class="ed-header">
      <div class="ed-title-block" data-ve-free={`${p.slug}:title-block`} data-ve-label={`${p.no} Title & Counter`}>
        <p class="ed-counter" aria-hidden="true" data-reveal>
          {p.no} / {totalProjects}
        </p>
        <h3 id={titleId} class="ed-title display" data-reveal style="--reveal-d: 60ms">
          <a
            class="ed-title-link"
            href={`#project-${p.slug}`}
            data-open-case={p.slug}
            data-case-trigger
            aria-label={`Project ${p.no}: ${p.title} — Click to Explore full project`}
          >
            <span class="visually-hidden">Project {p.no}: </span>
            {p.title}
          </a>
        </h3>
      </div>

      <div class="ed-overview" data-ve-free={`${p.slug}:overview`} data-ve-label={`${p.no} Overview`}>
        <h4 class="ed-h4" data-reveal style="--reveal-d: 100ms">Overview</h4>
        <div data-reveal style="--reveal-d: 140ms">
          <div data-lang-text="en">
            {
              Array.isArray(p.description) ? (
                <ul class="ed-bullets">
                  {p.description.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              ) : (
                <p>{p.description}</p>
              )
            }
          </div>
          <div data-lang-text="th">
            {
              Array.isArray(p.descriptionTh) ? (
                <ul class="ed-bullets">
                  {p.descriptionTh.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              ) : (
                <p>{p.descriptionTh}</p>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <!-- Middle Rounded Showcase Carousel (Static + Drag + Pill Scrollbar + Prev/Next + Expand) -->
    <div
      class="ed-showcase"
      data-ed-carousel
      data-ve-free={`${p.slug}:showcase`}
      data-ve-label={`${p.no} Showcase Carousel`}
      aria-label={`${p.title} gallery (${images.length} images)`}
    >
      <div class="ed-viewport" data-ed-viewport>
        <div class="ed-track" data-ed-track>
          {
            images.map((img, idx) => {
              const zoomSrc = posterUrl(img.name);
              return (
                <div class="ed-card" data-ed-card data-card-origin={idx}>
                  <div class="ed-card-media">
                    <Picture name={img.name} alt={img.alt} sizes="(min-width: 1200px) 26vw, (min-width: 640px) 42vw, 78vw" />
                  </div>
                  <span class="ed-card-badge" aria-hidden="true">
                    {String(idx + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')}
                  </span>
                  {zoomSrc && (
                    <button
                      type="button"
                      class="ed-expand"
                      data-zoom={zoomSrc}
                      data-zoom-alt={img.alt}
                      data-primary-zoom={idx}
                      aria-label={`Expand full size (${idx + 1} of ${images.length}): ${img.alt}`}
                      title="View full size"
                    >
                      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                        <path
                          d="M3 8V3h5M12 3h5v5M17 12v5h-5M8 17H3v-5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="ed-controls">
        <button type="button" class="ed-nav" data-ed-prev aria-label="Previous infographic" title="Previous">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div
          class="ed-scrollbar"
          data-ed-scrollbar
          role="scrollbar"
          aria-label="Gallery scroll"
          aria-orientation="horizontal"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
        >
          <div class="ed-scrollbar-thumb" data-ed-thumb></div>
        </div>

        <button type="button" class="ed-nav" data-ed-next aria-label="Next infographic" title="Next">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Bottom 2-Column Section: My Role & Tools & Software -->
    <footer class="ed-footer">
      <div class="ed-col" data-ve-free={`${p.slug}:my-role`} data-ve-label={`${p.no} My Role`}>
        <h4 class="ed-h4" data-reveal>My Role</h4>
        <div data-reveal style="--reveal-d: 60ms">
          <ul class="ed-bullets" data-lang-text="en">
            {p.role.map((r) => <li>{r}</li>)}
          </ul>
          <ul class="ed-bullets" data-lang-text="th">
            {p.roleTh.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <div class="ed-col" data-ve-free={`${p.slug}:tools`} data-ve-label={`${p.no} Tools & Software`}>
        <h4 class="ed-h4" data-reveal style="--reveal-d: 60ms">Tools &amp; Software</h4>
        <ul class="ed-tools" role="list" aria-label="Tools & Software" data-reveal style="--reveal-d: 120ms">
          {
            p.tools.map((id) => (
              <li class="ed-tool-row">
                <span class="ed-tool-abbr" aria-hidden="true">
                  {tools[id].abbr}
                </span>
                <span class="ed-tool-name">{tools[id].name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </div>
</article>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-ed-carousel]');

  carousels.forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-ed-viewport]');
    const track = root.querySelector<HTMLElement>('[data-ed-track]');
    const bar = root.querySelector<HTMLElement>('[data-ed-scrollbar]');
    const thumb = root.querySelector<HTMLElement>('[data-ed-thumb]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-ed-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-ed-next]');
    if (!viewport || !track || !bar || !thumb) return;

    let isDragging = false;
    let didDrag = false;
    let startX = 0;
    let startScroll = 0;

    function syncUI() {
      const maxScroll = Math.max(0, viewport!.scrollWidth - viewport!.clientWidth);
      const scrollLeft = viewport!.scrollLeft;
      const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, scrollLeft / maxScroll)) : 0;

      const barW = bar!.clientWidth;
      const visibleRatio = viewport!.scrollWidth > 0 ? viewport!.clientWidth / viewport!.scrollWidth : 1;
      const thumbW = Math.max(44, Math.round(barW * visibleRatio));
      const travel = Math.max(0, barW - thumbW);

      thumb!.style.width = `${thumbW}px`;
      thumb!.style.transform = `translate3d(${(travel * ratio).toFixed(1)}px, 0, 0)`;
      bar!.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));

      if (prevBtn) prevBtn.disabled = scrollLeft <= 2;
      if (nextBtn) nextBtn.disabled = scrollLeft >= maxScroll - 2;
    }

    syncUI();
    viewport.addEventListener('scroll', syncUI, { passive: true });
    window.addEventListener('resize', syncUI);
    const ro = new ResizeObserver(syncUI);
    ro.observe(track);
    ro.observe(viewport);

    // Click anywhere on a card (when not dragging) to open full size
    root.addEventListener(
      'click',
      (e) => {
        if (didDrag) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const target = e.target as Element;
        const card = target.closest<HTMLElement>('[data-ed-card]');
        if (card && !target.closest('button[data-zoom]')) {
          const idx = card.dataset.cardOrigin;
          if (idx !== undefined) {
            const primary = root.querySelector<HTMLButtonElement>(`button[data-primary-zoom="${idx}"]`);
            primary?.click();
          }
        }
      },
      true,
    );

    // Mouse drag on viewport
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      if ((e.target as Element).closest('.ed-expand')) return;

      isDragging = true;
      didDrag = false;
      startX = e.clientX;
      startScroll = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(e.pointerId);
    });

    viewport.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) didDrag = true;
      viewport.scrollLeft = startScroll - dx;
    });

    function endDrag(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.hasPointerCapture(e.pointerId)) {
        viewport.releasePointerCapture(e.pointerId);
      }
      setTimeout(() => {
        didDrag = false;
      }, 60);
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // Prev / Next buttons step by 1 card width + gap
    function stepBy(dir: number) {
      const firstCard = track!.querySelector<HTMLElement>('[data-ed-card]');
      const gap = parseFloat(getComputedStyle(track!).gap) || 18;
      const step = (firstCard ? firstCard.offsetWidth : 340) + gap;
      viewport!.scrollBy({ left: dir * step, behavior: 'smooth' });
    }
    prevBtn?.addEventListener('click', () => stepBy(-1));
    nextBtn?.addEventListener('click', () => stepBy(1));

    // Pill scrollbar scrub (click or drag on bar)
    let scrubbing = false;
    function scrubTo(clientX: number) {
      const rect = bar!.getBoundingClientRect();
      const thumbW = thumb!.offsetWidth;
      const travel = Math.max(1, rect.width - thumbW);
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left - thumbW / 2) / travel));
      const maxScroll = Math.max(0, viewport!.scrollWidth - viewport!.clientWidth);
      viewport!.scrollLeft = ratio * maxScroll;
    }

    bar.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      scrubbing = true;
      bar.setPointerCapture(e.pointerId);
      scrubTo(e.clientX);
    });
    bar.addEventListener('pointermove', (e) => {
      if (scrubbing) scrubTo(e.clientX);
    });
    const endScrub = (e: PointerEvent) => {
      if (!scrubbing) return;
      scrubbing = false;
      if (bar.hasPointerCapture(e.pointerId)) bar.releasePointerCapture(e.pointerId);
    };
    bar.addEventListener('pointerup', endScrub);
    bar.addEventListener('pointercancel', endScrub);

    bar.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        stepBy(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stepBy(-1);
      }
    });
  });
</script>

<style>
  .project-editorial {
    content-visibility: auto;
    contain-intrinsic-size: auto 960px;
  }
  .project-editorial::before {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: var(--c-line);
  }

  .ed-shell {
    width: 100%;
    max-width: calc(var(--max-w) + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(28px, 3.5vw, 48px) var(--gutter) clamp(40px, 4.5vw, 64px);
    display: grid;
    gap: clamp(18px, 2vw, 24px);
  }

  /* ---- Top Header & Overview ---- */
  .ed-header {
    display: grid;
    gap: 6px;
  }
  .ed-counter {
    margin: 0;
    color: var(--c-accent);
    font: 400 clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem) / 1.1 var(--f-display);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .ed-title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 1.4rem + 2.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  .ed-title-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.18s ease;
  }
  .ed-title-link:hover,
  .ed-title-link:focus-visible {
    color: var(--c-accent);
  }
  .ed-overview {
    margin-top: 6px;
    display: grid;
    gap: 6px;
    max-width: 66ch;
  }
  .ed-h4 {
    margin: 0;
    color: var(--c-accent);
    font-family: var(--f-body);
    font-size: clamp(0.98rem, 0.9rem + 0.22vw, 1.12rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .ed-overview p,
  .ed-bullets {
    margin: 0;
    color: var(--c-fg-soft);
    font-family: var(--f-body);
    font-size: clamp(0.92rem, 0.86rem + 0.16vw, 1rem);
    line-height: 1.65;
  }
  .ed-bullets {
    padding-left: 1.2em;
  }
  .ed-bullets li + li {
    margin-top: 3px;
  }

  /* ---- Middle Rounded Showcase Carousel ---- */
  .ed-showcase {
    position: relative;
    display: grid;
    gap: 16px;
    border-radius: 20px;
    padding: clamp(12px, 1.5vw, 16px);
    background: color-mix(in srgb, var(--c-fg) 6%, var(--c-bg-raised));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-fg) 8%, transparent);
    overflow: hidden;
  }
  .ed-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    border-radius: 12px;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-x pan-y;
  }
  .ed-viewport::-webkit-scrollbar {
    display: none;
  }
  .ed-viewport.is-dragging {
    cursor: grabbing;
  }
  .ed-track {
    --ed-gap: 16px;
    display: flex;
    gap: var(--ed-gap);
  }
  .ed-card {
    /* 3 full cards + 4th card peeking on desktop so visitors see it scrolls */
    flex: 0 0 calc((100% - var(--ed-gap) * 3) / 3.35);
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: var(--c-bg);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.14);
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.24s ease;
  }
  .ed-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgb(0 0 0 / 0.2);
  }
  .ed-card-media {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ed-card-media :global(picture),
  .ed-card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    -webkit-user-drag: none;
  }
  .ed-card-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgb(14 14 14 / 0.72);
    backdrop-filter: blur(6px);
    color: rgb(255 255 255 / 0.9);
    font: 600 12px / 1 var(--f-body);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    pointer-events: none;
    opacity: 0.85;
    transition: opacity 0.18s ease;
  }
  .ed-card:hover .ed-card-badge {
    opacity: 1;
  }
  .ed-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-inline: 4px;
  }
  .ed-nav {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--c-fg) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-fg) 5%, transparent);
    color: var(--c-fg);
    cursor: pointer;
    flex: none;
    transition: background 0.16s ease, border-color 0.16s ease, opacity 0.16s ease;
  }
  .ed-nav:hover:not(:disabled) {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #ffffff;
  }
  .ed-nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .ed-scrollbar {
    position: relative;
    flex: 1;
    max-width: 420px;
    height: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-fg) 10%, transparent);
    cursor: pointer;
    touch-action: none;
  }
  .ed-scrollbar:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }
  .ed-scrollbar-thumb {
    position: absolute;
    top: 3px;
    left: 0;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-fg) 56%, transparent);
    transition: background 0.16s ease;
    will-change: transform, width;
  }
  .ed-scrollbar:hover .ed-scrollbar-thumb,
  .ed-scrollbar:active .ed-scrollbar-thumb {
    background: var(--c-accent);
  }
  .ed-expand {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 8px;
    background: rgb(16 16 16 / 0.74);
    backdrop-filter: blur(6px);
    color: #ffffff;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.16s ease;
  }
  .ed-expand:hover {
    background: var(--c-accent);
    border-color: var(--c-accent);
    transform: scale(1.04);
  }
  .ed-expand:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #000, 0 0 0 4px #fff;
  }

  /* ---- Bottom 2-Column Footer (My Role & Tools & Software) ---- */
  .ed-footer {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .ed-col {
    display: grid;
    gap: 12px;
  }
  .ed-tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 340px;
  }
  .ed-tool-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 12px;
  }
  .ed-tool-row:first-child {
    padding-top: 4px;
  }
  .ed-tool-row + .ed-tool-row {
    border-top: 1px solid var(--c-line);
  }
  .ed-tool-abbr {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--c-fg);
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--c-fg);
    flex: none;
  }
  .ed-tool-name {
    font-size: clamp(0.9rem, 0.85rem + 0.15vw, 0.98rem);
    color: var(--c-fg-soft);
  }

  @media (min-width: 760px) {
    .ed-footer {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(32px, 5vw, 72px);
    }
  }
  @media (max-width: 960px) {
    .ed-card {
      flex: 0 0 calc((100% - var(--ed-gap) * 2) / 2.25);
    }
  }
  @media (max-width: 560px) {
    .ed-card {
      flex: 0 0 78%;
    }
  }
</style>
