---
// Dark / light switch. Defaults to light mode; a click saves the choice
// (localStorage, per visitor).
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<button class:list={['theme-toggle', { 'is-compact': compact }]} type="button" role="switch" aria-checked="false" aria-label="Dark mode">
  {compact ? (
    <span class="compact-ico" aria-hidden="true">
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </span>
  ) : (
    <span class="track" aria-hidden="true">
      <span class="thumb">
        <svg class="i-moon" viewBox="0 0 24 24" width="14" height="14"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path></svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </span>
    </span>
  )}
</button>

<script>
  type ViewTransitionLike = {
    ready: Promise<void>;
    finished: Promise<void>;
  };

  const root = document.documentElement;
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? 'light';
  const sync = () =>
    document.querySelectorAll('.theme-toggle').forEach((b) => b.setAttribute('aria-checked', String(current() === 'dark')));

  const applyTheme = (next: 'light' | 'dark') => {
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  };

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) =>
    btn.addEventListener('click', (e) => {
      const next: 'light' | 'dark' = current() === 'dark' ? 'light' : 'dark';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const startVT = (document as Document & {
        startViewTransition?: (cb: () => void) => ViewTransitionLike;
      }).startViewTransition?.bind(document);

      if (!startVT || reduceMotion) {
        applyTheme(next);
        return;
      }

      const rect = btn.getBoundingClientRect();
      const x = rect.width ? rect.left + rect.width / 2 : (e as MouseEvent).clientX || window.innerWidth / 2;
      const y = rect.height ? rect.top + rect.height / 2 : (e as MouseEvent).clientY || window.innerHeight / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      // Freeze CSS color transitions during snapshot so the expanding circle carries final crisp theme tokens
      root.classList.add('is-theme-switching');

      const transition = startVT(() => {
        applyTheme(next);
      });

      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 520,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              pseudoElement: '::view-transition-new(root)',
            },
          );
        })
        .catch(() => {});

      transition.finished.finally(() => {
        root.classList.remove('is-theme-switching');
      });
    }),
  );

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    min-width: 48px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .track {
    position: relative;
    width: 52px;
    height: 28px;
    border-radius: 999px;
    background: var(--c-ink-display);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.4);
  }
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #f2f2f2;
    color: var(--c-ink-display);
    transition: transform 0.3s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .thumb svg,
  .compact-ico svg {
    grid-area: 1 / 1;
    transition: opacity 0.2s ease;
  }
  .compact-ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--c-muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .theme-toggle.is-compact {
    min-width: 34px;
    min-height: 40px;
  }
  .theme-toggle.is-compact:hover .compact-ico {
    color: var(--c-fg);
    background: color-mix(in srgb, var(--c-fg) 8%, transparent);
  }
  /* checked = dark: thumb right with moon; unchecked = light: thumb left with sun */
  .theme-toggle[aria-checked='true'] .thumb {
    transform: translateX(24px);
  }
  .theme-toggle[aria-checked='true'] .i-sun,
  .theme-toggle[aria-checked='false'] .i-moon {
    opacity: 0;
  }
  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--c-hero), 0 0 0 6px #000;
    border-radius: 999px;
  }
  .theme-toggle.is-compact:focus-visible {
    box-shadow: var(--focus);
    border-radius: 8px;
  }
</style>
