---
// Interactive 3D Coverflow Card Deck for K2O Artist Posters (no floor reflection).
// Features:
//  - Center spotlight card flanked by angled 3D perspective wings on left & right
//  - Click any side card to glide it into center; click active center card to zoom in Lightbox
//  - Pointer drag / touch swipe scrubbing with flick momentum, < / > controls, keyboard arrows
//  - Cardless floating presentation directly on page background (Light Warm Paper & Dark Soft Charcoal)
import Picture from './Picture.astro';
import { posterUrl } from '../lib/media';

interface PosterItem {
  image: string;
  alt: string;
  label?: string;
}

interface Props {
  items: PosterItem[];
  initialIndex?: number;
}

const { items, initialIndex = Math.min(2, Math.max(0, items.length - 1)) } = Astro.props;
const total = items.length;
const startItem = items[initialIndex] ?? items[0];
---

<div class="pd-root" data-poster-deck data-initial={initialIndex}>
  <!-- 3D Perspective Coverflow Stage (floats directly on page background, no reflection) -->
  <div
    class="pd-stage"
    data-pd-stage
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Artist poster showcase"
  >
    <div class="pd-track" data-pd-track>
      {
        items.map((item, idx) => (
          <button
            type="button"
            class:list={['pd-card', { 'is-active': idx === initialIndex }]}
            data-pd-card={idx}
            data-pd-label={item.label ?? ''}
            data-zoom={posterUrl(item.image)}
            data-zoom-alt={item.label || item.alt}
            aria-label={item.label ? `${item.label} poster (${idx + 1} of ${total})` : item.alt}
            aria-current={idx === initialIndex ? 'true' : undefined}
          >
            <div class="pd-card-media">
              <Picture
                name={item.image}
                alt={item.alt}
                sizes="(min-width: 900px) 320px, 64vw"
                loading="lazy"
              />
              <span class="pd-card-shade" aria-hidden="true" />
            </div>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Minimal Centered Control Triad: ( < )   Artist Name / 3 of 6   ( > ) -->
  <div class="pd-controls">
    <button
      type="button"
      class="pd-nav"
      data-pd-prev
      aria-label="Previous artist poster"
      disabled={initialIndex <= 0}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>

    <div class="pd-info" aria-live="polite">
      <span class="pd-title" data-pd-title>{startItem?.label ?? ''}</span>
      <span class="pd-count" data-pd-count>{initialIndex + 1} of {total}</span>
    </div>

    <button
      type="button"
      class="pd-nav"
      data-pd-next
      aria-label="Next artist poster"
      disabled={initialIndex >= total - 1}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-poster-deck]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-pd-stage]')!;
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-pd-card]')];
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-pd-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-pd-next]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-pd-title]')!;
    const countEl = root.querySelector<HTMLElement>('[data-pd-count]')!;

    const total = cards.length;
    if (total === 0) return;

    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIdx = Math.max(0, Math.min(total - 1, Number(root.dataset.initial ?? 0)));
    let dragOffset = 0; // continuous card units while dragging
    let isDragging = false;
    let suppressNextClick = false;

    const getCardWidth = () => {
      const w = cards[0]?.offsetWidth || 268;
      return Math.max(140, w);
    };

    const layoutCards = (instant = false) => {
      const cardW = getCardWidth();
      const stageW = stage.clientWidth || 864;
      const isCompact = stageW < 560;
      const firstGap = isCompact ? cardW * 0.45 : cardW * 0.58;
      const stepGap = isCompact ? cardW * 0.17 : cardW * 0.24;
      const pos = activeIdx - dragOffset;

      cards.forEach((card, i) => {
        const d = i - pos;
        const absD = Math.abs(d);
        const sign = d === 0 ? 0 : d > 0 ? 1 : -1;

        // Smooth nonlinear Cover Flow X placement: generous clearance beside center, tighter fan outward
        let tx = 0;
        if (absD <= 1) {
          tx = d * firstGap;
        } else {
          tx = sign * (firstGap + (absD - 1) * stepGap);
        }

        // Concave amphitheater perspective rotation matching reference video
        let rotY = 0;
        if (absD <= 1) {
          rotY = -d * 34;
        } else {
          rotY = -sign * Math.min(44, 34 + (absD - 1) * 2.5);
        }

        // Recede side cards cleanly in Z & gentle scale cascade
        const tz = absD <= 1 ? -absD * 96 : -(96 + (absD - 1) * 44);
        const scale = Math.max(0.76, 1 - absD * 0.055);
        const zIndex = 40 - Math.round(absD * 6);
        const shadeAlpha = Math.min(0.28, absD * 0.09);

        card.style.transition =
          instant || reduceMq.matches
            ? 'none'
            : 'transform 520ms cubic-bezier(0.22, 1, 0.36, 1), opacity 360ms ease';
        card.style.transform = `translate3d(${tx.toFixed(1)}px, 0, ${tz.toFixed(1)}px) rotateY(${rotY.toFixed(2)}deg) scale(${scale.toFixed(4)})`;
        card.style.zIndex = String(zIndex);
        card.style.opacity = absD > 4.6 ? '0' : '1';

        const shade = card.querySelector<HTMLElement>('.pd-card-shade');
        if (shade) {
          shade.style.opacity = shadeAlpha.toFixed(3);
        }

        const isCenter = i === activeIdx && !isDragging;
        card.classList.toggle('is-active', isCenter);
        if (isCenter) card.setAttribute('aria-current', 'true');
        else card.removeAttribute('aria-current');
      });
    };

    const updateControls = (animateText = true) => {
      const label = cards[activeIdx]?.dataset.pdLabel ?? '';
      if (animateText && !reduceMq.matches && titleEl.textContent !== label) {
        titleEl.classList.add('is-swapping');
        window.setTimeout(() => {
          titleEl.textContent = label;
          titleEl.classList.remove('is-swapping');
        }, 120);
      } else {
        titleEl.textContent = label;
      }
      countEl.textContent = `${activeIdx + 1} of ${total}`;
      prevBtn.disabled = activeIdx <= 0;
      nextBtn.disabled = activeIdx >= total - 1;
    };

    const goTo = (idx: number) => {
      const clamped = Math.max(0, Math.min(total - 1, idx));
      activeIdx = clamped;
      dragOffset = 0;
      layoutCards(false);
      updateControls(true);
    };

    prevBtn.addEventListener('click', () => goTo(activeIdx - 1));
    nextBtn.addEventListener('click', () => goTo(activeIdx + 1));

    // Intercept clicks in capture phase on stage BEFORE Lightbox sees [data-zoom]:
    //  - Non-active side card -> glide it smoothly to center
    //  - Active center card -> let Lightbox open full-size zoom!
    stage.addEventListener(
      'click',
      (e) => {
        const card = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-pd-card]');
        if (!card) return;
        if (suppressNextClick) {
          e.preventDefault();
          e.stopImmediatePropagation();
          e.stopPropagation();
          return;
        }
        const idx = Number(card.dataset.pdCard ?? -1);
        if (idx >= 0 && idx !== activeIdx) {
          e.preventDefault();
          e.stopImmediatePropagation();
          e.stopPropagation();
          goTo(idx);
        }
      },
      true,
    );

    // Pointer drag / touch swipe scrubbing
    let ptrDown = false;
    let ptrId = -1;
    let startX = 0;
    let lastX = 0;
    let lastTime = 0;
    let velX = 0;

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      ptrDown = true;
      ptrId = e.pointerId;
      startX = e.clientX;
      lastX = e.clientX;
      lastTime = performance.now();
      velX = 0;
      isDragging = false;
      suppressNextClick = false;
    });

    stage.addEventListener('pointermove', (e) => {
      if (!ptrDown || e.pointerId !== ptrId) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastTime);
      velX = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastTime = now;

      const dx = e.clientX - startX;
      if (!isDragging && Math.abs(dx) > 10) {
        isDragging = true;
        suppressNextClick = true;
        stage.setPointerCapture(ptrId);
        stage.classList.add('is-dragging');
      }

      if (isDragging) {
        const unit = Math.max(110, getCardWidth() * 0.58);
        let raw = dx / unit;
        // Soft rubber-band resistance past first/last card
        const projected = activeIdx - raw;
        if (projected < 0) {
          raw = activeIdx + (raw - activeIdx) * 0.28;
        } else if (projected > total - 1) {
          const minRaw = activeIdx - (total - 1);
          raw = minRaw + (raw - minRaw) * 0.28;
        }
        dragOffset = raw;
        layoutCards(true);
      }
    });

    const finishDrag = (e: PointerEvent) => {
      if (!ptrDown || e.pointerId !== ptrId) return;
      ptrDown = false;
      stage.classList.remove('is-dragging');
      try {
        if (stage.hasPointerCapture(ptrId)) stage.releasePointerCapture(ptrId);
      } catch {}

      if (isDragging) {
        isDragging = false;
        let step = 0;
        if (dragOffset < -0.26 || velX < -0.35) step = Math.max(1, Math.round(-dragOffset));
        else if (dragOffset > 0.26 || velX > 0.35) step = -Math.max(1, Math.round(dragOffset));
        goTo(activeIdx + step);
        window.setTimeout(() => {
          suppressNextClick = false;
        }, 60);
      }
    };

    stage.addEventListener('pointerup', finishDrag);
    stage.addEventListener('pointercancel', finishDrag);

    // Keyboard navigation when focused or when in view inside K2O reader
    const parentDialog = root.closest<HTMLDialogElement>('dialog');
    window.addEventListener('keydown', (e) => {
      if (parentDialog && !parentDialog.open) return;
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      const rect = root.getBoundingClientRect();
      const inView = rect.bottom > 140 && rect.top < window.innerHeight - 140;
      if (!inView && document.activeElement !== stage) return;

      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(activeIdx + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(activeIdx - 1);
      }
    });

    // Re-layout cleanly when dialog opens or viewport resizes
    const ro = new ResizeObserver(() => layoutCards(true));
    ro.observe(stage);
    if (parentDialog) {
      const mo = new MutationObserver(() => {
        if (parentDialog.open) {
          requestAnimationFrame(() => layoutCards(true));
        }
      });
      mo.observe(parentDialog, { attributes: true, attributeFilter: ['open'] });
    }

    layoutCards(true);
    updateControls(false);
  });
</script>

<style>
  .pd-root {
    --pd-btn-hover: rgb(23 21 20 / 0.06);
    --pd-ring: rgb(23 21 20 / 0.08);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-block: 8px 4px;
    background: transparent;
    user-select: none;
  }
  :global(:root[data-theme='dark']) .pd-root {
    --pd-btn-hover: rgb(255 255 255 / 0.08);
    --pd-ring: rgb(255 255 255 / 0.1);
  }

  .pd-stage {
    position: relative;
    width: 100%;
    height: clamp(290px, 42vw, 396px);
    overflow: hidden;
    outline: none;
    touch-action: pan-y;
    cursor: grab;
  }
  .pd-stage.is-dragging {
    cursor: grabbing;
  }

  .pd-track {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 1350px;
    perspective-origin: 50% 48%;
    display: grid;
    place-items: center;
  }

  .pd-card {
    position: absolute;
    width: clamp(200px, 32%, 278px);
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
    will-change: transform;
    outline: none;
  }
  .pd-card.is-active {
    cursor: zoom-in;
  }
  .pd-card:focus-visible .pd-card-media {
    outline: 2px solid var(--cs-accent, #ff2b2b);
    outline-offset: 3px;
  }

  .pd-card-media {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: #051026;
    box-shadow: inset 0 0 0 1px var(--pd-ring);
  }
  .pd-card-media :global(picture),
  .pd-card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .pd-card-shade {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
  }

  /* Minimal Centered Control Triad matching card-animation-ref.mov */
  .pd-controls {
    display: grid;
    grid-template-columns: 36px minmax(150px, 210px) 36px;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .pd-nav {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--cs-line, var(--c-line));
    border-radius: 999px;
    background: transparent;
    color: var(--cs-fg-soft, var(--c-fg-soft));
    cursor: pointer;
    transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease, opacity 0.16s ease, transform 0.14s ease;
  }
  .pd-nav:hover:not(:disabled) {
    background: var(--pd-btn-hover);
    border-color: var(--cs-muted, var(--c-muted));
    color: var(--cs-fg, var(--c-fg));
  }
  .pd-nav:active:not(:disabled) {
    transform: scale(0.93);
  }
  .pd-nav:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .pd-info {
    display: grid;
    justify-items: center;
    gap: 3px;
    text-align: center;
    min-width: 0;
  }
  .pd-title {
    font: 500 14px / 1.25 var(--f-nav, var(--f-body));
    color: var(--cs-fg, var(--c-fg));
    white-space: nowrap;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .pd-title.is-swapping {
    opacity: 0;
    transform: translateY(3px);
  }
  .pd-count {
    font: 400 11.5px / 1.2 var(--f-nav, var(--f-body));
    font-variant-numeric: tabular-nums;
    color: var(--cs-muted, var(--c-muted));
  }

  @media (max-width: 720px) {
    .pd-stage {
      height: 300px;
    }
    .pd-track {
      perspective: 1000px;
    }
    .pd-card {
      width: 204px;
    }
    .pd-controls {
      grid-template-columns: 34px minmax(130px, 180px) 34px;
      gap: 12px;
    }
    .pd-nav {
      width: 34px;
      height: 34px;
    }
  }
</style>
