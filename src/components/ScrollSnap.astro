---
// Smooth Inertia / Damping Scroll (Lenis-style lerp) + Magnetic Project-Head Snap:
//   - Desktop (>= 1200px), respects prefers-reduced-motion, Design Mode,
//     open dialogs/lightboxes, and interactive 3D / Festival Map / Carousel areas.
//   - Physics:
//       targetY += wheelDelta * wheelMultiplier
//       currentY = damp(currentY, targetY, lerp, dt)   (frame-rate independent 60/120Hz)
//   - Presets (switchable live via bottom-left SideNav panel or Shift+S):
//       1) Light   (lerp 0.14,  wheel 1.00)
//       2) Studio  (lerp 0.085, wheel 0.85)  <- Default (Worachet / Awwwards feel)
//       3) Heavy   (lerp 0.055, wheel 0.75)
//       4) Off     (native browser scroll)
---

<script>
  const SNAP_SELECTOR = '#top, #work, article.project, #experience, #contact';
  const desktopMq = window.matchMedia('(min-width: 1200px)');
  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');

  type PresetKey = 'light' | 'studio' | 'heavy' | 'off';
  const PRESETS: Record<PresetKey, { lerp: number; wheel: number }> = {
    light: { lerp: 0.14, wheel: 1.0 },
    studio: { lerp: 0.085, wheel: 0.85 },
    heavy: { lerp: 0.055, wheel: 0.75 },
    off: { lerp: 1, wheel: 1 },
  };

  let activePreset: PresetKey = 'studio';
  let magnetEnabled = true;

  try {
    const saved = localStorage.getItem('pun_scroll_preset') as PresetKey | null;
    if (saved && saved in PRESETS) activePreset = saved;
    const savedMag = localStorage.getItem('pun_scroll_magnet');
    if (savedMag === '0') magnetEnabled = false;
  } catch {}

  const tuner = document.querySelector<HTMLElement>('[data-scroll-tuner]');
  const presetBtns = tuner ? [...tuner.querySelectorAll<HTMLButtonElement>('[data-preset]')] : [];
  const snapBtn = tuner?.querySelector<HTMLButtonElement>('[data-snap-toggle]');

  function syncTunerUI() {
    for (const btn of presetBtns) {
      btn.classList.toggle('is-active', btn.dataset.preset === activePreset);
    }
    if (snapBtn) {
      snapBtn.classList.toggle('is-on', magnetEnabled);
      snapBtn.textContent = magnetEnabled ? 'Magnet: ON' : 'Magnet: OFF';
    }
  }
  syncTunerUI();

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.dataset.preset as PresetKey;
      if (!p || !(p in PRESETS)) return;
      activePreset = p;
      currentY = window.scrollY;
      targetY = window.scrollY;
      try {
        localStorage.setItem('pun_scroll_preset', p);
      } catch {}
      syncTunerUI();
    });
  });

  snapBtn?.addEventListener('click', () => {
    magnetEnabled = !magnetEnabled;
    try {
      localStorage.setItem('pun_scroll_magnet', magnetEnabled ? '1' : '0');
    } catch {}
    syncTunerUI();
  });

  const getTargets = (): HTMLElement[] =>
    [...document.querySelectorAll<HTMLElement>(SNAP_SELECTOR)].filter((el) => el.offsetParent !== null);

  let currentY = window.scrollY;
  let targetY = window.scrollY;
  let rafId = 0;
  let lastFrameTime = 0;
  let idleTimer = 0;
  let lastWheelDir = 0;
  let suppressMagnetUntil = 0;

  function maxScrollY(): number {
    return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
  }

  function isBlocked(): boolean {
    if (!desktopMq.matches || reducedMq.matches) return true;
    if (document.documentElement.classList.contains('ve-active')) return true;
    if (document.querySelector('dialog[open]')) return true;
    return false;
  }

  function clearIdle() {
    if (idleTimer) {
      window.clearTimeout(idleTimer);
      idleTimer = 0;
    }
  }

  function stopLoop() {
    if (rafId) {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
  }

  // Frame-rate independent exponential damping (normalized to 60fps frames)
  function damp(curr: number, dest: number, lerpFactor: number, dtMs: number): number {
    const frames = Math.min(4, Math.max(0.25, dtMs / 16.667));
    const alpha = 1 - Math.pow(1 - lerpFactor, frames);
    return curr + (dest - curr) * alpha;
  }

  function tick(now: number) {
    if (isBlocked() || activePreset === 'off') {
      rafId = 0;
      return;
    }

    const dt = lastFrameTime ? now - lastFrameTime : 16.667;
    lastFrameTime = now;

    const max = maxScrollY();
    targetY = Math.max(0, Math.min(max, targetY));

    const { lerp } = PRESETS[activePreset];
    currentY = damp(currentY, targetY, lerp, dt);

    if (Math.abs(targetY - currentY) > 0.35) {
      window.scrollTo({ top: currentY, behavior: 'instant' as ScrollBehavior });
      rafId = requestAnimationFrame(tick);
    } else {
      currentY = targetY;
      window.scrollTo({ top: targetY, behavior: 'instant' as ScrollBehavior });
      rafId = 0;
    }
  }

  function startLoop() {
    if (!rafId) {
      lastFrameTime = performance.now();
      rafId = requestAnimationFrame(tick);
    }
  }

  // Normalize wheel delta across mouse wheels (line mode) and trackpads (pixel mode)
  function normalizeWheelDelta(e: WheelEvent): number {
    let dy = e.deltaY;
    if (e.deltaMode === 1) dy *= 36; // DOM_DELTA_LINE
    else if (e.deltaMode === 2) dy *= window.innerHeight * 0.85; // DOM_DELTA_PAGE
    // Clamp extreme single-event spikes
    return Math.max(-260, Math.min(260, dy));
  }

  // Magnetic settle: shifts targetY to the nearest section/project head after wheel idle
  function magneticSettle() {
    if (isBlocked() || !magnetEnabled) return;
    if (performance.now() < suppressMagnetUntil) return;

    const vh = window.innerHeight;
    const targets = getTargets();
    if (!targets.length) return;

    // Evaluate relative to where the inertia scroll is heading (targetY),
    // not just where currentY happens to be mid-glide.
    const downBandBottom = vh * 0.34;
    const downBandTop = -vh * 0.14;
    const upBandTop = -vh * 0.30;
    const upBandBottom = vh * 0.22;

    let bestOffset = 0;
    let bestDist = Infinity;

    for (const el of targets) {
      const elAbsTop = window.scrollY + el.getBoundingClientRect().top;
      const topAtTarget = elAbsTop - targetY;
      const inBand =
        lastWheelDir >= 0
          ? topAtTarget >= downBandTop && topAtTarget <= downBandBottom
          : topAtTarget >= upBandTop && topAtTarget <= upBandBottom;

      if (inBand) {
        const dist = Math.abs(topAtTarget);
        if (dist < bestDist) {
          bestDist = dist;
          bestOffset = elAbsTop;
        }
      }
    }

    if (bestDist < Infinity && bestDist > 2) {
      targetY = Math.max(0, Math.min(maxScrollY(), Math.round(bestOffset)));
      if (activePreset === 'off') {
        window.scrollTo({ top: targetY, behavior: 'smooth' });
      } else {
        startLoop();
      }
    }
  }

  // Intercept wheel on desktop for weighted inertia scrolling
  window.addEventListener(
    'wheel',
    (e) => {
      if (isBlocked() || activePreset === 'off') {
        if (!isBlocked() && magnetEnabled) {
          if (Math.abs(e.deltaY) > 1) lastWheelDir = e.deltaY > 0 ? 1 : -1;
          clearIdle();
          idleTimer = window.setTimeout(magneticSettle, 160);
        }
        return;
      }

      // Allow browser zoom or horizontal trackpad swipe
      if (e.ctrlKey || e.metaKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

      const target = e.target;
      if (
        target instanceof Element &&
        target.closest('[data-model-slot], [data-fmap], [data-ed-viewport], [data-scroll-tuner]')
      ) {
        return;
      }

      e.preventDefault();

      // Sync with actual scroll position if user dragged the native scrollbar
      if (!rafId) {
        currentY = window.scrollY;
        targetY = window.scrollY;
      }

      const raw = normalizeWheelDelta(e);
      const { wheel } = PRESETS[activePreset];
      targetY = Math.max(0, Math.min(maxScrollY(), targetY + raw * wheel));

      if (Math.abs(raw) > 0.5) {
        lastWheelDir = raw > 0 ? 1 : -1;
      }

      startLoop();
      clearIdle();
      idleTimer = window.setTimeout(magneticSettle, 170);
    },
    { passive: false },
  );

  // Keep currentY / targetY in sync when user drags scrollbar or uses native scroll
  window.addEventListener(
    'scroll',
    () => {
      if (!rafId) {
        currentY = window.scrollY;
        targetY = window.scrollY;
      }
    },
    { passive: true },
  );

  // Smoothly animate anchor clicks (#work, #k2o, #about, etc.) through the same inertia engine
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target;
      const a = target instanceof Element ? target.closest<HTMLAnchorElement>('a[href*="#"]') : null;
      if (!a) return;

      const hashIdx = a.href.indexOf('#');
      if (hashIdx === -1) return;
      const hash = a.href.slice(hashIdx);
      if (!hash || hash === '#') return;

      const destEl = document.querySelector<HTMLElement>(hash);
      if (!destEl || isBlocked() || activePreset === 'off') {
        stopLoop();
        clearIdle();
        suppressMagnetUntil = performance.now() + 950;
        return;
      }

      e.preventDefault();
      clearIdle();
      suppressMagnetUntil = performance.now() + 900;
      if (!rafId) currentY = window.scrollY;
      targetY = Math.max(0, Math.min(maxScrollY(), Math.round(window.scrollY + destEl.getBoundingClientRect().top)));
      history.pushState(null, '', hash);
      startLoop();
    },
    true,
  );

  // Keyboard stepping: PageDown / PageUp or Alt + ArrowDown / ArrowUp
  window.addEventListener('keydown', (e) => {
    if (isBlocked()) return;
    const tag = (e.target as HTMLElement | null)?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

    const isNext = e.key === 'PageDown' || (e.altKey && e.key === 'ArrowDown');
    const isPrev = e.key === 'PageUp' || (e.altKey && e.key === 'ArrowUp');
    if (!isNext && !isPrev) return;

    const targets = getTargets();
    if (!targets.length) return;

    const refY = rafId ? targetY : window.scrollY;
    if (isNext) {
      const next = targets.find((el) => window.scrollY + el.getBoundingClientRect().top - refY > 24);
      if (next) {
        e.preventDefault();
        clearIdle();
        if (!rafId) currentY = window.scrollY;
        targetY = Math.round(window.scrollY + next.getBoundingClientRect().top);
        startLoop();
      }
    } else {
      const prev = [...targets].reverse().find((el) => window.scrollY + el.getBoundingClientRect().top - refY < -24);
      if (prev) {
        e.preventDefault();
        clearIdle();
        if (!rafId) currentY = window.scrollY;
        targetY = Math.round(window.scrollY + prev.getBoundingClientRect().top);
        startLoop();
      }
    }
  });
</script>
