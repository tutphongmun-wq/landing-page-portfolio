---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import StickyNav from '../components/StickyNav.astro';
import SideNav from '../components/SideNav.astro';
import Lightbox from '../components/Lightbox.astro';
import VisualEditor from '../components/VisualEditor.astro';
import ScrollSnap from '../components/ScrollSnap.astro';
import CaseStudyReaders from '../components/CaseStudyReaders.astro';
import { projects } from '../data/projects';
---

<Base>
  <StickyNav />
  <SideNav />
  <Hero />
  <main id="main">
    <div class="with-sidebar">
      <ProjectIndex />
      <section aria-label="Projects">
        {projects.map((project) => <ProjectSection project={project} />)}
      </section>
      <About />
      <Experience />
    </div>
    <Contact />
  </main>
  <CaseStudyReaders />
  <Lightbox />
  <VisualEditor />
  <ScrollSnap />
</Base>
