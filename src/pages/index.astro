---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import StickyNav from '../components/StickyNav.astro';
import SideNav from '../components/SideNav.astro';
import Lightbox from '../components/Lightbox.astro';
import ScrollSnap from '../components/ScrollSnap.astro';
import CaseStudyReaders from '../components/CaseStudyReaders.astro';
import TextLoop from '../components/TextLoop.jsx';
import { projects } from '../data/projects';
---

<Base>
  <StickyNav />
  <SideNav />
  <Hero />
  <div class="intro-loop-divider" aria-hidden="true">
    <TextLoop
      client:load
      text="tutphong ✦ mungkalakul"
      shape="wave"
      speed={90}
      direction="forward"
      separator="✦"
      curviness={90}
      tilt={0}
      fontSize={46}
      fontWeight={800}
      letterSpacing={2}
      uppercase
      ribbon
      ribbonColor="#ff2b2b"
      ribbonWidth={86}
      edgeFade={0}
      cross={false}
      crossAngle={16}
      draggable={false}
      scrollBoost={0}
      outline={false}
      pauseOnHover
    />
  </div>
  <main id="main">
    <div class="with-sidebar">
      <section id="work" aria-label="Projects">
        {projects.map((project) => <ProjectSection project={project} />)}
      </section>
      <Experience />
      <Contact />
    </div>
  </main>
  <CaseStudyReaders />
  <Lightbox />
  <ScrollSnap />
</Base>

<style>
  .intro-loop-divider {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--c-bg);
    padding-block: clamp(8px, 1.5vw, 20px);
  }
  .intro-loop-divider :global(.text-loop-svg) {
    margin-block: clamp(-48px, -4.5vw, -16px);
  }
</style>
