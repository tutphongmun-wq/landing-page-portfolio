---
// Project detail page (preview). Reuses ProjectSection as-is, so 3D, map,
// carousel and lightbox behave exactly like the one-page site.
import Base from '../../../layouts/Base.astro';
import ProjectSection from '../../../components/ProjectSection.astro';
import Lightbox from '../../../components/Lightbox.astro';
import Picture from '../../../components/Picture.astro';
import { projects, type Project } from '../../../data/projects';
import { site } from '../../../data/site';
import { assetUrl } from '../../../lib/media';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project: p, prev, next } = Astro.props;
const home = assetUrl('v3/');
const href = (x: Project) => assetUrl(`v3/work/${x.slug}/`);
const cover = (x: Project) => x.media.find((m) => m.kind === 'image') as { name: string } | undefined;
const desc = Array.isArray(p.description) ? p.description.join(' ') : p.description;
---

<Base title={`${p.title} · ${site.title}`} description={desc}>
  <header class="topbar" style={`--accent:${p.spine.bg}`}>
    <a class="brand" href={home}>PUN</a>
    <nav aria-label="Projects">
      <ol class="dots" role="list">
        {
          projects.map((x) => (
            <li>
              <a href={href(x)} aria-current={x.slug === p.slug ? 'page' : undefined} title={x.title} style={`--c:${x.spine.bg}`}>
                {x.no}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a class="back" href={`${home}#work`}>← All work</a>
  </header>

  <main id="main" class="detail">
    <ProjectSection project={p} />

    <nav class="pager container" aria-label="More projects">
      <a class="prev" href={href(prev)}>
        <span class="lbl">← Previous</span>
        <span class="t">{prev.no} {prev.title}</span>
      </a>
      <a class="next" href={href(next)} style={`--accent:${next.spine.bg}`}>
        {cover(next) && <Picture name={cover(next)!.name} alt="" sizes="(min-width: 900px) 50vw, 100vw" class="next-img" />}
        <span class="next-txt">
          <span class="lbl">Next project →</span>
          <span class="t display">{next.no} {next.title}</span>
        </span>
      </a>
    </nav>
  </main>
  <Lightbox />
</Base>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px var(--gutter);
    background: color-mix(in srgb, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-line);
  }
  .brand {
    font-family: var(--f-heading);
    font-size: 1.5rem;
    color: var(--c-fg);
    text-decoration: none;
  }
  .dots {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dots a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    font-size: var(--fs-0);
    font-weight: 700;
    color: var(--c-muted);
    text-decoration: none;
    border: 1px solid var(--c-line);
    transition: 0.2s;
  }
  .dots a:hover {
    color: var(--c-fg);
    border-color: var(--c);
  }
  .dots a[aria-current='page'] {
    background: var(--c);
    border-color: var(--c);
    color: #111;
  }
  .back {
    color: var(--c-fg);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--fs-0);
  }
  .back:hover {
    color: var(--accent);
  }
  .detail {
    padding-top: 24px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px;
    padding-block: 24px var(--section-y);
  }
  .pager a {
    color: var(--c-fg);
    text-decoration: none;
    border-radius: var(--radius);
    border: 1px solid var(--c-line);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 8px;
    min-height: 220px;
  }
  .lbl {
    color: var(--c-muted);
    font-size: var(--fs-0);
    font-weight: 700;
  }
  .t {
    font-size: var(--fs-3);
    font-weight: 700;
  }
  .next {
    position: relative;
    overflow: hidden;
    border-color: var(--accent) !important;
  }
  .next :global(.next-img),
  .next :global(.next-img img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    transition:
      opacity 0.4s,
      transform 0.6s;
  }
  .next:hover :global(.next-img img) {
    opacity: 0.55;
    transform: scale(1.04);
  }
  .next-txt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .next .t {
    font-size: var(--fs-4);
    line-height: 1;
  }
  .next .lbl {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .dots {
      display: none;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .prev {
      order: 2;
      min-height: 0;
    }
  }
</style>
